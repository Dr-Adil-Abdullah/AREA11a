<UserControl x:Class="Area11.WPF.Views.ProductsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" Margin="0,0,0,16">
            <StackPanel DockPanel.Dock="Left">
                <TextBlock Text="Products" Style="{StaticResource PageTitle}" />
                <TextBlock Text="Medicines and retail items with the Box / Strip / Unit pack formula"
                           Style="{StaticResource PageSubtitle}" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <Button Content="Edit selected"
                        Style="{StaticResource GhostButton}"
                        Command="{Binding EditCommand}"
                        Margin="0,0,8,0" />
                <Button Content="Refresh"
                        Style="{StaticResource GhostButton}"
                        Command="{Binding RefreshCommand}"
                        Margin="0,0,8,0" />
                <Button Content="+ New product"
                        Style="{StaticResource PrimaryButton}"
                        Command="{Binding ToggleFormCommand}" />
            </StackPanel>
        </DockPanel>

        <Grid Grid.Row="1" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="320" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <TextBox Grid.Column="0"
                     Height="34"
                     Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                     ToolTip="Search by name, barcode, salt, rack or room" />

            <ComboBox Grid.Column="1"
                      Width="190"
                      Margin="10,0,0,0"
                      ItemsSource="{Binding Categories}"
                      SelectedItem="{Binding SelectedCategory, Mode=TwoWay}"
                      DisplayMemberPath="Name" />

            <CheckBox Grid.Column="2"
                      Content="Low stock only"
                      IsChecked="{Binding LowStockOnly}"
                      Margin="14,0,0,0"
                      VerticalAlignment="Center" />

            <TextBlock Grid.Column="3"
                       Text="{Binding StatusMessage}"
                       HorizontalAlignment="Right"
                       VerticalAlignment="Center"
                       FontSize="12"
                       TextWrapping="Wrap">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsStatusError}" Value="True">
                                <Setter Property="Foreground" Value="{StaticResource DangerBrush}" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
        </Grid>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource Card}" Padding="0">
                <DataGrid ItemsSource="{Binding Products}"
                          SelectedItem="{Binding SelectedProduct}"
                          Margin="1">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="2*" />
                        <DataGridTextColumn Header="Barcode" Binding="{Binding Barcode}" Width="*" />
                        <DataGridTextColumn Header="Category" Binding="{Binding Category}" Width="*" />
                        <DataGridTextColumn Header="Pack" Binding="{Binding Pack}" Width="Auto" />
                        <DataGridTextColumn Header="Retail" Binding="{Binding Retail}" Width="Auto" />
                        <DataGridTextColumn Header="Stock" Binding="{Binding Stock}" Width="Auto" />
                    </DataGrid.Columns>
                </DataGrid>
            </Border>

            <Border Grid.Column="1"
                    Width="380"
                    Style="{StaticResource Card}"
                    Margin="16,0,0,0"
                    Visibility="{Binding IsFormOpen, Converter={StaticResource BoolToVisibility}}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="{Binding FormTitle}" Style="{StaticResource SectionTitle}" />

                        <TextBlock Text="Name" Style="{StaticResource FieldLabel}" />
                        <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" />

                        <TextBlock Text="Barcode" Style="{StaticResource FieldLabel}" />
                        <TextBox Text="{Binding Barcode, UpdateSourceTrigger=PropertyChanged}" />

                        <TextBlock Text="Generic / salt" Style="{StaticResource FieldLabel}" />
                        <TextBox Text="{Binding Generic, UpdateSourceTrigger=PropertyChanged}" />

                        <TextBlock Text="Category" Style="{StaticResource FieldLabel}" />
                        <ComboBox ItemsSource="{Binding Categories}"
                                  SelectedItem="{Binding FormCategory, Mode=TwoWay}"
                                  DisplayMemberPath="Name" />

                        <TextBlock Text="Or create a new category" Style="{StaticResource FieldLabel}" />
                        <TextBox Text="{Binding NewCategoryName, UpdateSourceTrigger=PropertyChanged}" />

                        <TextBlock Text="Company" Style="{StaticResource FieldLabel}" />
                        <ComboBox ItemsSource="{Binding Companies}"
                                  SelectedItem="{Binding FormCompany, Mode=TwoWay}"
                                  DisplayMemberPath="Name" />

                        <TextBlock Text="Or create a new company" Style="{StaticResource FieldLabel}" />
                        <TextBox Text="{Binding NewCompanyName, UpdateSourceTrigger=PropertyChanged}" />

                        <TextBlock Text="Pack formula" Style="{StaticResource FieldLabel}" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="8" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="1 box = strips" FontSize="11" Foreground="{StaticResource MutedBrush}" />
                                <TextBox Text="{Binding BoxStrips, UpdateSourceTrigger=PropertyChanged}" Margin="0,3,0,0" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="1 strip = units" FontSize="11" Foreground="{StaticResource MutedBrush}" />
                                <TextBox Text="{Binding StripUnits, UpdateSourceTrigger=PropertyChanged}" Margin="0,3,0,0" />
                            </StackPanel>
                        </Grid>

                        <TextBlock Text="Prices (Rs)" Style="{StaticResource FieldLabel}" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="8" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Cost" FontSize="11" Foreground="{StaticResource MutedBrush}" />
                                <TextBox Text="{Binding Cost, UpdateSourceTrigger=PropertyChanged}" Margin="0,3,0,0" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Retail" FontSize="11" Foreground="{StaticResource MutedBrush}" />
                                <TextBox Text="{Binding Retail, UpdateSourceTrigger=PropertyChanged}" Margin="0,3,0,0" />
                            </StackPanel>
                        </Grid>

                        <Grid Margin="0,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="8" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="VIP" FontSize="11" Foreground="{StaticResource MutedBrush}" />
                                <TextBox Text="{Binding Vip, UpdateSourceTrigger=PropertyChanged}" Margin="0,3,0,0" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Doctor" FontSize="11" Foreground="{StaticResource MutedBrush}" />
                                <TextBox Text="{Binding Doctor, UpdateSourceTrigger=PropertyChanged}" Margin="0,3,0,0" />
                            </StackPanel>
                        </Grid>

                        <TextBlock Text="Shelf location" Style="{StaticResource FieldLabel}" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="8" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Rack" FontSize="11" Foreground="{StaticResource MutedBrush}" />
                                <TextBox Text="{Binding Rack, UpdateSourceTrigger=PropertyChanged}" Margin="0,3,0,0" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Room" FontSize="11" Foreground="{StaticResource MutedBrush}" />
                                <TextBox Text="{Binding Room, UpdateSourceTrigger=PropertyChanged}" Margin="0,3,0,0" />
                            </StackPanel>
                        </Grid>

                        <TextBlock Text="Reorder level (base units)" Style="{StaticResource FieldLabel}" />
                        <TextBox Text="{Binding Reorder, UpdateSourceTrigger=PropertyChanged}" />

                        <StackPanel Orientation="Horizontal" Margin="0,18,0,0">
                            <Button Content="Save" Style="{StaticResource PrimaryButton}" Command="{Binding SaveCommand}" Width="120" />
                            <Button Content="Cancel" Style="{StaticResource GhostButton}" Command="{Binding CancelFormCommand}" Margin="8,0,0,0" Width="100" />
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
    </Grid>
</UserControl>
