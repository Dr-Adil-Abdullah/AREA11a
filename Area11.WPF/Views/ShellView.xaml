<Window x:Class="Area11.WPF.Views.ShellView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:Area11.WPF.ViewModels"
        xmlns:views="clr-namespace:Area11.WPF.Views"
        Title="Area11 POS"
        Height="820"
        Width="1280"
        MinHeight="640"
        MinWidth="1000"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource AppBgBrush}">

    <Window.Resources>
        <DataTemplate DataType="{x:Type vm:DashboardViewModel}">
            <views:DashboardView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:ProductsViewModel}">
            <views:ProductsView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:SettingsViewModel}">
            <views:SettingsView />
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="250" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Background="{StaticResource BrandDarkBrush}">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top" Margin="22,26,22,18">
                    <TextBlock Text="{Binding AppName}"
                               FontSize="22"
                               FontWeight="Bold"
                               Foreground="White" />
                    <TextBlock Text="{Binding StoreName}"
                               FontSize="12"
                               Foreground="#FFA7F3D0"
                               Margin="0,4,0,0"
                               TextWrapping="Wrap" />
                </StackPanel>

                <Border DockPanel.Dock="Bottom" Margin="14,14,14,18" Padding="12" CornerRadius="8" Background="#22000000">
                    <StackPanel>
                        <TextBlock Text="{Binding UserName}" Foreground="White" FontSize="13" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding RoleText}" Foreground="#FFA7F3D0" FontSize="11" Margin="0,2,0,0" />
                    </StackPanel>
                </Border>

                <ListBox ItemsSource="{Binding NavItems}"
                         SelectedItem="{Binding SelectedNav, Mode=TwoWay}"
                         Background="Transparent"
                         BorderThickness="0"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Setter Property="Padding" Value="0" />
                            <Setter Property="Margin" Value="10,2" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Border x:Name="Root" CornerRadius="6" Background="Transparent" Padding="14,10">
                                            <ContentPresenter />
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Root" Property="Background" Value="#FF0F766E" />
                                            </Trigger>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="Root" Property="Background" Value="#FF10B981" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel>
                                <TextBlock Text="{Binding Title}" Foreground="White" FontSize="14" FontWeight="SemiBold" />
                                <TextBlock Text="{Binding Subtitle}" Foreground="#FFD1FAE5" FontSize="11" Margin="0,2,0,0" />
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Border>

        <ContentControl Grid.Column="1"
                        Content="{Binding CurrentViewModel}"
                        Margin="26,22,26,22"
                        HorizontalContentAlignment="Stretch"
                        VerticalContentAlignment="Stretch" />
    </Grid>
</Window>
