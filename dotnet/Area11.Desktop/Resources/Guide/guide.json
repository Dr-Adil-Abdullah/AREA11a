            ],
            [
              "Password or PIN",
              "اپنا موجودہ مقررکردہراز؛کسی اورشخص کی شناخت نہیں۔"
            ],
            [
              "Sign in",
              "دی گئی شناخت کی جانچ اورکامیابی پراس شخص کی نشست کا آغاز۔"
