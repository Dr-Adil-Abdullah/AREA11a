        {
          "kind": "heading",
          "text": "اہم فرق",
          "rows": []
        },
        {
          "kind": "item",
          "text": "Auto-print بند ہونے سے bill محفوظ ہونا بند نہیں ہوتا۔",
          "rows": []
        },
        {
          "kind": "item",
          "text": "پرنٹر fail ہو تو محفوظ sale خود cancel نہیں ہوتی۔",
          "rows": []
        },
        {
          "kind": "item",
          "text": "A4 summary ہر bill کی الگ مکمل رسید نہیں۔",
          "rows": []
        },
        {
          "kind": "item",
          "text": "PDF بننا، WhatsApp میں خود attach ہوکر چلے جانا نہیں۔",
