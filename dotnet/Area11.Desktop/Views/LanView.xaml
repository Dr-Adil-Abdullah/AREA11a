<UserControl x:Class="Area11.Desktop.Views.LanView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ================================ the heading ================================ -->
        <DockPanel Grid.Row="0" Margin="0,0,0,10">
            <StackPanel DockPanel.Dock="Left" VerticalAlignment="Center">
                <TextBlock Text="Second counter (LAN)" Style="{StaticResource PageTitle}" />
                <TextBlock Text="Two PCs, one shop database. The main counter keeps the file and shares its folder; the second counter opens that folder."
                           Style="{StaticResource PageSubtitle}" TextWrapping="Wrap" />
            </StackPanel>

            <Button DockPanel.Dock="Right" HorizontalAlignment="Right" VerticalAlignment="Center"
                    Content="Check again" Style="{StaticResource GhostButton}" Command="{Binding RefreshCommand}" />
        </DockPanel>

        <!-- ================================ where the file is ================================ -->
        <Border Grid.Row="1" Style="{StaticResource Card}" Padding="14" Margin="0,0,0,10">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="220" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="170" />
                        <ColumnDefinition Width="150" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="MODE" Style="{StaticResource FieldHint}" />
                        <TextBlock Text="{Binding ModeLabel}" FontSize="13" FontWeight="SemiBold" TextWrapping="Wrap" />
                    </StackPanel>

                    <StackPanel Grid.Column="1" Margin="10,0,10,0">
                        <TextBlock Text="DATABASE FOLDER" Style="{StaticResource FieldHint}" />
                        <TextBlock Text="{Binding FolderLabel}" FontSize="12.5" TextWrapping="Wrap" />
                    </StackPanel>

                    <StackPanel Grid.Column="2">
                        <TextBlock Text="JOURNAL" Style="{StaticResource FieldHint}" />
                        <TextBlock Text="{Binding JournalText}" FontSize="15" FontWeight="SemiBold" />
                        <TextBlock Text="WAL is not safe on a share" Style="{StaticResource FieldHint}" TextWrapping="Wrap" />
                    </StackPanel>

                    <StackPanel Grid.Column="3">
                        <TextBlock Text="THIS PC" Style="{StaticResource FieldHint}" />
                        <TextBlock Text="{Binding ThisPc}" FontSize="13" />
                    </StackPanel>
                </Grid>

                <StackPanel Grid.Row="1" Margin="0,10,0,0">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Left" Text="{Binding ReachText}" FontWeight="Bold" FontSize="12.5">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="{StaticResource DangerBrush}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Reachable}" Value="True">
                                            <Setter Property="Foreground" Value="{StaticResource SuccessBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <TextBlock Text="{Binding CheckMessage}" Style="{StaticResource FieldHint}" TextWrapping="Wrap"
                                   Margin="10,0,0,0" />
                    </DockPanel>

                    <TextBlock Text="{Binding IniFile}" Style="{StaticResource FieldHint}" TextWrapping="Wrap"
                               Margin="0,4,0,0" />

                    <TextBlock Text="{Binding RestartLabel}" FontWeight="SemiBold" FontSize="12" TextWrapping="Wrap"
                               Margin="0,6,0,0"
                               Visibility="{Binding RestartPending, Converter={StaticResource BoolToVis}}" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- ================================ the two buttons ================================ -->
        <Grid Grid.Row="2" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="14" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource Card}" Padding="14">
                <StackPanel>
                    <TextBlock Text="This PC keeps the database" Style="{StaticResource SectionTitle}" />
                    <TextBlock Text="The database stays exactly where it is. The program stops using the WAL journal (a network share cannot carry it) and writes the folder into shop.ini. Then you share that folder on the network."
                               Style="{StaticResource FieldHint}" TextWrapping="Wrap" Margin="0,4,0,0" />

                    <Button Content="{Binding PrepareLabel}" Style="{StaticResource PrimaryButton}" Height="38"
                            Margin="0,10,0,0" Command="{Binding PrepareCommand}"
                            IsEnabled="{Binding CanManage}" />
                </StackPanel>
            </Border>

            <Border Grid.Column="2" Style="{StaticResource Card}" Padding="14">
                <StackPanel>
                    <TextBlock Text="This PC uses the main counter's database" Style="{StaticResource SectionTitle}" />
                    <TextBlock Text="Type the main PC's shared folder. The program opens the file here to prove it can read and write it, writes one line into the main counter's black box, and saves the path."
                               Style="{StaticResource FieldHint}" TextWrapping="Wrap" Margin="0,4,0,0" />

                    <TextBox Text="{Binding SharePathText, UpdateSourceTrigger=PropertyChanged}"
                             Margin="0,8,0,0" IsEnabled="{Binding CanManage}"
                             ToolTip="For example \\MAIN-PC\Area11" />

                    <Button Content="{Binding JoinLabel}" Style="{StaticResource PrimaryButton}" Height="38"
                            Margin="0,8,0,0" Command="{Binding JoinCommand}"
                            IsEnabled="{Binding CanManage}" />
                </StackPanel>
            </Border>
        </Grid>

        <!-- ================================ who connected ================================ -->
        <Border Grid.Row="3" Style="{StaticResource Card}" Padding="12">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <DockPanel Grid.Row="0" Margin="0,0,0,6">
                    <TextBlock DockPanel.Dock="Left" Text="Counters that joined this shop's file"
                               Style="{StaticResource SectionTitle}" />
                    <Button DockPanel.Dock="Right" HorizontalAlignment="Right" Content="Test the connection"
                            Style="{StaticResource GhostButton}" Command="{Binding TestCommand}"
                            IsEnabled="{Binding CanManage}" />
                </DockPanel>

                <DataGrid Grid.Row="1" ItemsSource="{Binding Connections}" IsReadOnly="True"
                          AutoGenerateColumns="False" HeadersVisibility="Column"
                          GridLinesVisibility="Horizontal">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="When" Binding="{Binding WhenLabel, Mode=OneWay}" Width="150" />
                        <DataGridTextColumn Header="Computer" Binding="{Binding PcLabel, Mode=OneWay}" Width="1.4*" />
                        <DataGridTextColumn Header="Pressed by" Binding="{Binding UserLabel, Mode=OneWay}" Width="1.4*" />
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Border>

        <!-- ================================ the footer ================================ -->
        <TextBlock Grid.Row="4" Text="{Binding StatusText}" TextWrapping="Wrap" FontSize="11.5"
                   Margin="0,10,0,0">
            <TextBlock.Style>
                <Style TargetType="TextBlock">
                    <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsStatusError}" Value="True">
                            <Setter Property="Foreground" Value="{StaticResource DangerBrush}" />
                            <Setter Property="FontWeight" Value="Bold" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </TextBlock.Style>
        </TextBlock>
    </Grid>
</UserControl>
