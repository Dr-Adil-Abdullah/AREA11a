<UserControl x:Class="Area11.Desktop.Views.ExpensesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" Margin="0,0,0,10">
            <StackPanel DockPanel.Dock="Left" VerticalAlignment="Center">
                <TextBlock Text="{DynamicResource AppLabel.expenses}" Style="{StaticResource PageTitle}" />
                <TextBlock Text="Money the shop paid out, and money or medicine the owner took. Both are kept separate from purchases."
                           Style="{StaticResource PageSubtitle}" />
            </StackPanel>

            <Button DockPanel.Dock="Right" HorizontalAlignment="Right" VerticalAlignment="Center"
                    Content="Refresh" Style="{StaticResource GhostButton}" Command="{Binding RefreshCommand}" />
        </DockPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="430" />
                <ColumnDefinition Width="14" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- ============================ the two forms ============================ -->
            <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto">
                <StackPanel>

                    <Border Style="{StaticResource Card}" Padding="16"
                            Visibility="{Binding IsNotAllowed, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="You can read the list, but recording an expense needs the Cash / shifts permission."
                                   TextWrapping="Wrap" Foreground="{StaticResource WarningBrush}" />
                    </Border>

                    <!-- 1. what the shop spent -->
                    <Border Style="{StaticResource Card}" Padding="16"
                            Visibility="{Binding CanRecord, Converter={StaticResource BoolToVis}}">
                        <StackPanel>
                            <TextBlock Text="Money the shop spent" Style="{StaticResource SectionTitle}" />
                            <TextBlock Text="No stock arrives and no supplier's account moves — the money simply leaves the till."
                                       Style="{StaticResource FieldHint}" />

                            <TextBlock Text="Category" Style="{StaticResource FieldLabel}" Margin="0,12,0,0" />
                            <ComboBox ItemsSource="{Binding Categories}" DisplayMemberPath="Label"
                                      SelectedItem="{Binding Category, Mode=TwoWay}" Width="220"
                                      HorizontalAlignment="Left" />

                            <TextBlock Text="What was it" Style="{StaticResource FieldLabel}" Margin="0,10,0,0" />
                            <TextBox Text="{Binding Title, UpdateSourceTrigger=PropertyChanged}"
                                     ToolTip="For example: August rent, electricity bill, tea for the counter." />

                            <TextBlock Text="Amount (Rs)" Style="{StaticResource FieldLabel}" Margin="0,10,0,0" />
                            <TextBox Text="{Binding AmountText, UpdateSourceTrigger=PropertyChanged}" Width="200"
                                     HorizontalAlignment="Left" />

                            <TextBlock Text="Note (optional)" Style="{StaticResource FieldLabel}" Margin="0,10,0,0" />
                            <TextBox Text="{Binding ExpenseNote, UpdateSourceTrigger=PropertyChanged}" />

                            <Button Content="Save the expense" Style="{StaticResource PrimaryButton}" Margin="0,12,0,0"
                                    HorizontalAlignment="Left" Command="{Binding SaveExpenseCommand}" />
                        </StackPanel>
                    </Border>

                    <!-- 2. what the owner took -->
                    <Border Style="{StaticResource Card}" Padding="16" Margin="0,12,0,0"
                            Visibility="{Binding IsOwner, Converter={StaticResource BoolToVis}}">
                        <StackPanel>
                            <TextBlock Text="Owner took money or goods" Style="{StaticResource SectionTitle}" />
                            <TextBlock Text="Cash lowers the drawer count. Goods lower the shelf at purchase cost and leave the cash alone."
                                       Style="{StaticResource FieldHint}" />

                            <TextBlock Text="Kind" Style="{StaticResource FieldLabel}" Margin="0,12,0,0" />
                            <ComboBox ItemsSource="{Binding DrawingKinds}" SelectedItem="{Binding DrawingKind, Mode=TwoWay}"
                                      Width="200" HorizontalAlignment="Left" />

                            <!-- cash -->
                            <StackPanel Visibility="{Binding IsCashDrawing, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="Cash taken (Rs)" Style="{StaticResource FieldLabel}" Margin="0,10,0,0" />
                                <TextBox Text="{Binding DrawingAmountText, UpdateSourceTrigger=PropertyChanged}" Width="200"
                                         HorizontalAlignment="Left" />
                            </StackPanel>

                            <!-- goods -->
                            <StackPanel Visibility="{Binding IsGoodsDrawing, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="Find the medicine" Style="{StaticResource FieldLabel}" Margin="0,10,0,0" />
                                <DockPanel>
                                    <Button DockPanel.Dock="Right" Content="Find" Style="{StaticResource GhostButton}"
                                            Margin="6,0,0,0" Command="{Binding SearchCommand}" />
                                    <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" />
                                </DockPanel>

                                <ListBox ItemsSource="{Binding Results}" SelectedItem="{Binding SelectedProduct, Mode=TwoWay}"
                                         Height="110" Margin="0,6,0,0">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Margin="0,2">
                                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                                                <TextBlock Text="{Binding PackLabel}" FontSize="10.5"
                                                           Foreground="{StaticResource MutedBrush}" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>

                                <TextBlock Text="Batch" Style="{StaticResource FieldLabel}" Margin="0,8,0,0" />
                                <ComboBox ItemsSource="{Binding Batches}" DisplayMemberPath="PickLabel"
                                          SelectedItem="{Binding SelectedBatch, Mode=TwoWay}" />

                                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                    <StackPanel Width="120">
                                        <TextBlock Text="Quantity" Style="{StaticResource FieldLabel}" />
                                        <TextBox Text="{Binding QtyText, UpdateSourceTrigger=PropertyChanged}" />
                                    </StackPanel>
                                    <StackPanel Width="120" Margin="8,0,0,0">
                                        <TextBlock Text="Unit" Style="{StaticResource FieldLabel}" />
                                        <ComboBox ItemsSource="{Binding Units}" SelectedItem="{Binding Unit, Mode=TwoWay}" />
                                    </StackPanel>
                                </StackPanel>

                                <TextBlock Text="{Binding ValuePreview}" Style="{StaticResource FieldLabel}" Margin="0,8,0,0" />
                                <TextBlock Text="{Binding StockPreview}" Style="{StaticResource FieldHint}" />
                            </StackPanel>

                            <TextBlock Text="Note (optional)" Style="{StaticResource FieldLabel}" Margin="0,10,0,0" />
                            <TextBox Text="{Binding DrawingNote, UpdateSourceTrigger=PropertyChanged}" />

                            <Button Content="Save the drawing" Style="{StaticResource PrimaryButton}" Margin="0,12,0,0"
                                    HorizontalAlignment="Left" Command="{Binding SaveDrawingCommand}" />
                        </StackPanel>
                    </Border>

                    <Border Background="{StaticResource WarningSoftBrush}" CornerRadius="8" Padding="12" Margin="0,12,0,0"
                            Visibility="{Binding CanRecord, Converter={StaticResource BoolToVis}}">
                        <TextBlock TextWrapping="Wrap" FontSize="11.5" Foreground="{StaticResource WarningBrush}"
                                   Text="An entry that is already saved is never edited or deleted — a mistake is corrected by a second entry. Every entry goes into the black box with your name on it." />
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- ============================== the list ============================== -->
            <Border Grid.Column="2" Style="{StaticResource Card}" Padding="12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Margin="0,0,0,8">
                        <TextBlock Text="What went out" Style="{StaticResource SectionTitle}" />
                        <TextBlock Text="{Binding TodayText}" Style="{StaticResource FieldHint}" />
                    </StackPanel>

                    <DataGrid Grid.Row="1" ItemsSource="{Binding Rows}" IsReadOnly="True"
                              AutoGenerateColumns="False" HeadersVisibility="Column" GridLinesVisibility="Horizontal">
                        <DataGrid.RowStyle>
                            <Style TargetType="DataGridRow">
                                <Style.Triggers>
                                    <!-- A goods drawing took stock, not money: shown in a softer colour. -->
                                    <DataTrigger Binding="{Binding IsDrawing}" Value="True">
                                        <Setter Property="Background" Value="{StaticResource BrandSoftBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </DataGrid.RowStyle>
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="When" Binding="{Binding DateLabel, Mode=OneWay}" Width="120" />
                            <DataGridTextColumn Header="What" Binding="{Binding KindLabel, Mode=OneWay}" Width="150" />
                            <DataGridTextColumn Header="Detail" Binding="{Binding DetailLabel, Mode=OneWay}" Width="2*" />
                            <DataGridTextColumn Header="By" Binding="{Binding WhoLabel, Mode=OneWay}" Width="110" />
                            <DataGridTextColumn Header="Cash out" Binding="{Binding CashLabel, Mode=OneWay}" Width="110" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>
        </Grid>

        <Border Grid.Row="2" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource LineBrush}"
                BorderThickness="1" CornerRadius="8" Padding="12,8" Margin="0,10,0,0">
            <TextBlock Text="{Binding StatusText}" TextWrapping="Wrap">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="FontSize" Value="12" />
                        <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsStatusError}" Value="True">
                                <Setter Property="Foreground" Value="{StaticResource DangerBrush}" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
        </Border>
    </Grid>
</UserControl>
