<UserControl x:Class="Area11.Desktop.Views.HardwareView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ================================ the heading ================================ -->
        <DockPanel Grid.Row="0" Margin="0,0,0,10">
            <StackPanel DockPanel.Dock="Left" VerticalAlignment="Center">
                <TextBlock Text="Printer &amp; scanner" Style="{StaticResource PageTitle}" />
                <TextBlock Text="Test the thermal printer and the barcode scanner on this PC, and keep a record of what you saw (F-46)."
                           Style="{StaticResource PageSubtitle}" TextWrapping="Wrap" />
            </StackPanel>

            <Button DockPanel.Dock="Right" HorizontalAlignment="Right" VerticalAlignment="Center"
                    Content="Refresh" Style="{StaticResource GhostButton}" Command="{Binding RefreshCommand}" />
        </DockPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- ================================ the printer + the ticks ================================ -->
            <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <Border Style="{StaticResource Card}" Padding="14">
                        <StackPanel>
                            <TextBlock Text="THE PRINTER" Style="{StaticResource SectionTitle}" />
                            <TextBlock Style="{StaticResource FieldHint}" TextWrapping="Wrap" Margin="0,4,0,0"
                                       Text="These three come from Settings → Printing. An empty printer name means the Windows default printer." />

                            <UniformGrid Columns="3" Margin="0,10,0,0">
                                <StackPanel>
                                    <TextBlock Text="PRINTER" Style="{StaticResource MetricLabel}" />
                                    <TextBlock Text="{Binding PrinterText}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                </StackPanel>
                                <StackPanel>
                                    <TextBlock Text="PAPER" Style="{StaticResource MetricLabel}" />
                                    <TextBlock Text="{Binding PaperText}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                </StackPanel>
                                <StackPanel>
                                    <TextBlock Text="COPIES" Style="{StaticResource MetricLabel}" />
                                    <TextBlock Text="{Binding CopiesText}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                </StackPanel>
                            </UniformGrid>

                            <Button Content="Print test slip" Style="{StaticResource PrimaryButton}"
                                    Command="{Binding PrintCommand}" Margin="0,12,0,0" />
                            <TextBlock Style="{StaticResource FieldHint}" TextWrapping="Wrap" Margin="0,6,0,0"
                                       Text="The slip is not a bill. Its ruler fills the whole line, so one lost digit shows that the paper width is wrong." />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}" Padding="14" Margin="0,10,0,0">
                        <StackPanel>
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Left" Text="WHAT YOU CHECKED" Style="{StaticResource SectionTitle}" />
                                <TextBlock DockPanel.Dock="Right" HorizontalAlignment="Right" VerticalAlignment="Center"
                                           Text="{Binding ProgressText}" FontWeight="SemiBold" />
                            </DockPanel>

                            <ItemsControl ItemsSource="{Binding Rows}" Margin="0,8,0,0">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1" Padding="0,7">
                                            <StackPanel>
                                                <CheckBox Content="{Binding Text}" IsChecked="{Binding Passed, Mode=TwoWay}"
                                                          FontWeight="SemiBold" />
                                                <TextBlock Text="{Binding Hint}" Style="{StaticResource FieldHint}"
                                                           TextWrapping="Wrap" Margin="20,2,0,0" />
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <TextBlock Text="{Binding LastRunText}" Style="{StaticResource FieldHint}" Margin="0,8,0,0" />

                            <Border Background="{StaticResource WarningSoftBrush}" CornerRadius="8" Padding="10" Margin="0,8,0,0"
                                    Visibility="{Binding HasRecordWarning, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="{Binding RecordWarning}" TextWrapping="Wrap"
                                           Foreground="{StaticResource WarningBrush}" />
                            </Border>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- ================================ the scanner + the record ================================ -->
            <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <Border Style="{StaticResource Card}" Padding="14">
                        <StackPanel>
                            <TextBlock Text="THE SCANNER" Style="{StaticResource SectionTitle}" />
                            <TextBlock Style="{StaticResource FieldHint}" TextWrapping="Wrap" Margin="0,4,0,0"
                                       Text="A USB scanner behaves like a keyboard: click the box once, scan, and it types the code and presses Enter by itself." />

                            <TextBox Text="{Binding ScanText, UpdateSourceTrigger=PropertyChanged}"
                                     Margin="0,8,0,0" FontSize="16" Padding="8">
                                <TextBox.InputBindings>
                                    <KeyBinding Key="Return" Command="{Binding ScanCommand}" />
                                </TextBox.InputBindings>
                            </TextBox>

                            <Button Content="Check this code" Style="{StaticResource GhostButton}"
                                    Command="{Binding ScanCommand}" Margin="0,8,0,0" />

                            <TextBlock Text="{Binding LastScanText}" TextWrapping="Wrap" FontWeight="Bold"
                                       Margin="0,10,0,0"
                                       Visibility="{Binding HasLastScan, Converter={StaticResource BoolToVis}}" />
                            <TextBlock Text="{Binding ScanHint}" Style="{StaticResource FieldHint}"
                                       TextWrapping="Wrap" Margin="0,2,0,0" />

                            <TextBlock Text="SCANNED SO FAR" Style="{StaticResource MetricLabel}" Margin="0,12,0,0" />
                            <ItemsControl ItemsSource="{Binding Scans}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Text}" Style="{StaticResource FieldHint}"
                                                   TextWrapping="Wrap" Margin="0,2,0,0" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}" Padding="14" Margin="0,10,0,0">
                        <StackPanel>
                            <TextBlock Text="KEEP A NOTE" Style="{StaticResource SectionTitle}" />
                            <TextBlock Style="{StaticResource FieldHint}" TextWrapping="Wrap" Margin="0,4,0,0"
                                       Text="If a box is left empty, one line here is compulsory - the next person to read the record must know what to fix." />

                            <TextBox Text="{Binding NoteText, UpdateSourceTrigger=PropertyChanged}"
                                     AcceptsReturn="True" TextWrapping="Wrap" MinHeight="70"
                                     Margin="0,8,0,0" Padding="6" VerticalScrollBarVisibility="Auto" />

                            <Button Content="Save the result" Style="{StaticResource PrimaryButton}"
                                    Command="{Binding SaveCommand}" Margin="0,10,0,0" />
                            <TextBlock Style="{StaticResource FieldHint}" TextWrapping="Wrap" Margin="0,6,0,0"
                                       Text="Saving writes one line in the black box: the date, your name, the paper width and what was missing. It changes no bill and no stock." />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <!-- ================================ the footer ================================ -->
        <TextBlock Grid.Row="2" Text="{Binding StatusText}" TextWrapping="Wrap" FontSize="11.5" Margin="0,10,0,0">
            <TextBlock.Style>
                <Style TargetType="TextBlock">
                    <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsStatusError}" Value="True">
                            <Setter Property="Foreground" Value="{StaticResource DangerBrush}" />
                            <Setter Property="FontWeight" Value="Bold" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </TextBlock.Style>
        </TextBlock>
    </Grid>
</UserControl>
