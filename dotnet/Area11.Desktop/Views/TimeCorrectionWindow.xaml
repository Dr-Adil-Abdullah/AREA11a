<Window Icon="{DynamicResource Area11WindowIcon}" x:Class="Area11.Desktop.Views.TimeCorrectionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{Binding WindowTitle}" Width="680" Height="560" MinWidth="560" MinHeight="420"
        WindowStartupLocation="CenterOwner" Background="{StaticResource CanvasBrush}">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ================================ the drift ================================ -->
        <Border Grid.Row="0" Style="{StaticResource Card}" Margin="0,0,0,10" Padding="12">
            <StackPanel>
                <TextBlock Text="BILLS STAMPED WITH THE WRONG CLOCK" Style="{StaticResource SectionTitle}" />
                <TextBlock Text="{Binding DriftText}" TextWrapping="Wrap" Margin="0,6,0,0" />
            </StackPanel>
        </Border>

        <!-- ================================ the range ================================ -->
        <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0,0,0,10" Padding="12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Margin="0,0,10,0">
                    <TextBlock Text="FROM (2026-11-01)" Style="{StaticResource FieldLabel}" />
                    <TextBox Text="{Binding FromText, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,0" />
                </StackPanel>

                <StackPanel Grid.Column="1" Margin="0,0,10,0">
                    <TextBlock Text="TO" Style="{StaticResource FieldLabel}" />
                    <TextBox Text="{Binding ToText, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,0" />
                </StackPanel>

                <Button Grid.Column="2" Content="List bills" Style="{StaticResource PrimaryButton}"
                        Command="{Binding ListCommand}" VerticalAlignment="Bottom" />
            </Grid>
        </Border>

        <!-- ================================ the bills ================================ -->
        <Border Grid.Row="2" Style="{StaticResource Card}" Margin="0,0,0,10">
            <DataGrid ItemsSource="{Binding Bills}" IsReadOnly="True" AutoGenerateColumns="False"
                      HeadersVisibility="Column" GridLinesVisibility="Horizontal">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Bill" Binding="{Binding Code, Mode=OneWay}" Width="110" />
                    <DataGridTextColumn Header="Wrong time" Binding="{Binding WrongDate, Mode=OneWay}" Width="150" />
                    <DataGridTextColumn Header="Correct time" Binding="{Binding ProposedDate, Mode=OneWay}" Width="150" />
                    <DataGridTextColumn Header="Moves" Binding="{Binding ShiftLabel, Mode=OneWay}" Width="90" />
                    <DataGridTextColumn Header="Total" Binding="{Binding TotalLabel, Mode=OneWay}" Width="*" />
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <!-- ================================ the one action ================================ -->
        <Border Grid.Row="3" Style="{StaticResource Card}" Margin="0,0,0,10" Padding="12">
            <DockPanel>
                <TextBlock DockPanel.Dock="Left" Text="{Binding CountText}" VerticalAlignment="Center"
                           FontWeight="SemiBold" TextWrapping="Wrap" />
                <Button DockPanel.Dock="Right" Content="Fix every bill above" Style="{StaticResource PrimaryButton}"
                        Command="{Binding FixAllCommand}" IsEnabled="{Binding CanFix}" />
            </DockPanel>
        </Border>

        <!-- ================================ the status ================================ -->
        <TextBlock Grid.Row="4" Text="{Binding StatusText}" TextWrapping="Wrap" FontSize="11.5">
            <TextBlock.Style>
                <Style TargetType="TextBlock">
                    <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsStatusError}" Value="True">
                            <Setter Property="Foreground" Value="{StaticResource DangerBrush}" />
                            <Setter Property="FontWeight" Value="Bold" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </TextBlock.Style>
        </TextBlock>
    </Grid>
</Window>
