<Window x:Class="Area11.Desktop.Views.ShellWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:Area11.Desktop.ViewModels"
        xmlns:views="clr-namespace:Area11.Desktop.Views"
        xmlns:utils="clr-namespace:Area11.Core.Utils;assembly=Area11.Core"
        Title="Area11" Height="760" Width="1240"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource CanvasBrush}">

    <Window.Resources>
        <DataTemplate DataType="{x:Type vm:DashboardViewModel}">
            <views:DashboardView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:PosViewModel}">
            <views:PosView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:PurchasesViewModel}">
            <views:PurchasesView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:ProductsViewModel}">
            <views:ProductsView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:SettingsViewModel}">
            <views:SettingsView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:ReturnsViewModel}">
            <views:ReturnsView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:AlertsViewModel}">
            <views:AlertsView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:ProvisionalViewModel}">
            <views:ProvisionalView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:WriteOffViewModel}">
            <views:WriteOffView />
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="228" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Sidebar -->
        <Border Grid.Column="0" Background="{StaticResource SidebarBrush}">
            <Grid Margin="16,20,16,16">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0">
                    <StackPanel Orientation="Horizontal">
                        <Border Width="34" Height="34" CornerRadius="9" Background="{StaticResource BrandBrush}">
                            <TextBlock Text="A11" Foreground="White" FontSize="11" FontWeight="Bold"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="{Binding AppName}" Foreground="White" FontSize="15" FontWeight="Bold" />
                            <TextBlock Text="{Binding StoreName}" Foreground="#94A3B8" FontSize="10" />
                        </StackPanel>
                    </StackPanel>
                </StackPanel>

                <ListBox Grid.Row="1"
                         ItemsSource="{Binding NavItems}"
                         SelectedItem="{Binding SelectedNav, Mode=TwoWay}"
                         Background="Transparent"
                         BorderThickness="0"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         Margin="0,24,0,0">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Padding" Value="12,9" />
                            <Setter Property="Margin" Value="0,2" />
                            <Setter Property="Foreground" Value="#E2E8F0" />
                            <Setter Property="Cursor" Value="Hand" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Border x:Name="ItemBackground" Background="Transparent" CornerRadius="7"
                                                Padding="{TemplateBinding Padding}">
                                            <ContentPresenter />
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="ItemBackground" Property="Background"
                                                        Value="{StaticResource SidebarItemBrush}" />
                                            </Trigger>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="ItemBackground" Property="Background"
                                                        Value="{StaticResource BrandBrush}" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel>
                                <TextBlock Text="{Binding Title}" FontSize="12.5" FontWeight="SemiBold" />
                                <TextBlock Text="{Binding Subtitle}" FontSize="10" Opacity="0.72" />
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <StackPanel Grid.Row="2">
                    <Border Background="{StaticResource SidebarItemBrush}" CornerRadius="8" Padding="10">
                        <StackPanel Orientation="Horizontal">
                            <Border Width="30" Height="30" CornerRadius="15" Background="{StaticResource BrandBrush}">
                                <TextBlock Text="{Binding Initials}" Foreground="White" FontWeight="Bold" FontSize="12"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <StackPanel Margin="9,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="{Binding UserName}" Foreground="White" FontSize="12" FontWeight="SemiBold" />
                                <TextBlock Text="{Binding RoleText}" Foreground="#94A3B8" FontSize="10" />
                            <TextBlock Text="{x:Static utils:BuildInfo.Label}" Foreground="#64748B"
                                       FontSize="9" Margin="0,2,0,0" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Button Content="Sign out"
                            Style="{StaticResource GhostButton}"
                            Foreground="#E2E8F0"
                            BorderBrush="#334155"
                            Margin="0,8,0,0"
                            Command="{Binding LogoutCommand}" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Page. Row 0 is the global alert bar: it sits above every page (Spec 16.2.1). -->
        <Grid Grid.Column="1" Margin="22">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Background="{StaticResource DangerBrush}" CornerRadius="8" Padding="12,8"
                    Margin="0,0,0,10"
                    Visibility="{Binding HasAlertBar, Converter={StaticResource BoolToVis}}">
                <DockPanel>
                    <Button DockPanel.Dock="Right" Content="Hide for this session"
                            Style="{StaticResource GhostButton}" Foreground="White" BorderBrush="#FCA5A5"
                            FontSize="11" Padding="9,4" Command="{Binding HideAlertBarCommand}" />

                    <Button DockPanel.Dock="Right" Content="See now" Foreground="White" FontWeight="SemiBold"
                            Background="Transparent" BorderThickness="0" FontSize="12" Padding="9,4"
                            Cursor="Hand" Command="{Binding OpenAlertsCommand}" Margin="0,0,6,0" />

                    <TextBlock Text="{Binding AlertText}" Foreground="White" FontWeight="SemiBold"
                               FontSize="12.5" VerticalAlignment="Center" TextWrapping="Wrap" />
                </DockPanel>
            </Border>

            <ContentControl Grid.Row="1" Content="{Binding CurrentViewModel}" />
        </Grid>
    </Grid>
</Window>
