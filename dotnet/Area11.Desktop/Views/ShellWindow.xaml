<Window x:Class="Area11.Desktop.Views.ShellWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:Area11.Desktop.ViewModels"
        xmlns:views="clr-namespace:Area11.Desktop.Views"
        xmlns:utils="clr-namespace:Area11.Core.Utils;assembly=Area11.Core"
        Title="Area11" Height="760" Width="1240"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource CanvasBrush}">

    <!--
        The frame as the owner drew it (D-51):

          ┌───────────────────────────────────────────────────────────────┐
          │ A · Area11 ................ [Shop name] (badge) ⋯ 🔔  (photo)│  <- 46px, small
          ├───────────┬───────────────────────────────────────────────────┤
          │ SELL    ▾ │                                                   │
          │  Counter  │                 the page                          │
          │  Returns  │                                                   │
          │ ...       │                                                   │
          │ (me) sign │                                                   │
          └───────────┴───────────────────────────────────────────────────┘

        · The word **Area11 is small**: it is a mark, not a title, so the header costs 46 pixels
          instead of the 56 the previous version spent on a large one.
        · The **shop name sits in the centre** and opens the shop's Settings page.
        · The **bell sits beside the shop name**, showing how many alerts are live. It opens the
          alerts page (no sliding panel over the work) and it is the only door to that page.
        · The **signed-in person's photo is in the left bar**, at the bottom, beside the version
          label. Clicking it opens their own menu: their settings and "Sign out".
        · Every heading (SELL, STOCK ...) is a fold (D-51): one click puts its pages away and the
          fold is remembered for the next start.
    -->
    <Window.Resources>
        <DataTemplate DataType="{x:Type vm:DashboardViewModel}">
            <views:DashboardView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:PosViewModel}">
            <views:PosView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:PurchasesViewModel}">
            <views:PurchasesView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:ProductsViewModel}">
            <views:ProductsView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:SettingsViewModel}">
            <views:SettingsView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:ReturnsViewModel}">
            <views:ReturnsView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:AlertsViewModel}">
            <views:AlertsView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:ProvisionalViewModel}">
            <views:ProvisionalView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:WriteOffViewModel}">
            <views:WriteOffView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:StockTakeViewModel}">
            <views:StockTakeView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:PartnersViewModel}">
            <views:PartnersView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:ShiftViewModel}">
            <views:ShiftView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:ExpensesViewModel}">
            <views:ExpensesView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:ReportsViewModel}">
            <views:ReportsView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:AuditViewModel}">
            <views:AuditView />
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="46" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="176" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- ===================== Header (46 px, one line) ===================== -->
        <Border Grid.Row="0" Grid.ColumnSpan="2" Background="{StaticResource SidebarBrush}">
            <Grid Margin="12,0,12,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="176" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="176" />
                </Grid.ColumnDefinitions>

                <!-- The wordmark. Small on purpose: the shop's name is what people recognise. -->
                <Button Grid.Column="0" Style="{StaticResource SidebarBrandButton}"
                        Command="{Binding GoHomeCommand}" ToolTip="Dashboard">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Width="24" Height="24" CornerRadius="6" Background="{StaticResource BrandBrush}">
                            <TextBlock Text="A11" Foreground="White" FontSize="8.5" FontWeight="Bold"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <TextBlock Text="{Binding AppName}" Foreground="#E2E8F0" FontSize="12.5"
                                   FontWeight="SemiBold" VerticalAlignment="Center" Margin="8,0,0,0" />
                    </StackPanel>
                </Button>

                <!-- The shop name, in the middle, opening Settings. The bell sits right beside it,
                     so "where am I" and "is anything wrong" are one glance and two clicks. -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center"
                            VerticalAlignment="Center">
                    <Button Style="{StaticResource SidebarBrandButton}"
                            Padding="10,5"
                            Command="{Binding OpenSettingsCommand}"
                            IsEnabled="{Binding CanOpenSettings}"
                            ToolTip="Shop settings">
                        <TextBlock Text="{Binding StoreName}" Foreground="#F1F5F9" FontSize="12"
                                   FontWeight="SemiBold" TextTrimming="CharacterEllipsis" MaxWidth="330" />
                    </Button>

                    <Button x:Name="Bell" Command="{Binding OpenAlertsCommand}"
                            ToolTip="{Binding BellSummaryText}" Margin="2,0,0,0">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource SidebarBrandButton}">
                                <Setter Property="Padding" Value="5,4" />
                                <Style.Triggers>
                                    <!-- Lit while the alerts page is open, so the bell says
                                         "this is the page you are on" as well as "this is the door". -->
                                    <DataTrigger Binding="{Binding IsShowingAlerts}" Value="True">
                                        <Setter Property="Background" Value="{StaticResource BrandBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <Grid Width="26" Height="22">
                            <TextBlock Text="&#xE7ED;" FontFamily="Segoe MDL2 Assets" FontSize="14"
                                       Foreground="#E2E8F0" HorizontalAlignment="Center"
                                       VerticalAlignment="Center" />
                            <!-- Light chip, dark figure: readable on the dark bar AND on the brand
                                 colour (a dark red chip would disappear into the brand brush). -->
                            <Border CornerRadius="7" MinWidth="14" Height="14" Padding="3,0"
                                    HorizontalAlignment="Right" VerticalAlignment="Top"
                                    Margin="0,-5,-6,0"
                                    Visibility="{Binding HasBellAlerts, Converter={StaticResource BoolToVis}}">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background" Value="#FCD34D" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsShowingAlerts}" Value="True">
                                                <Setter Property="Background" Value="#FFFFFF" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <TextBlock Text="{Binding BellBadgeText}" Foreground="#111827" FontSize="8.5"
                                           FontWeight="Bold" HorizontalAlignment="Center"
                                           VerticalAlignment="Center" />
                            </Border>
                        </Grid>
                    </Button>
                </StackPanel>

                <!-- The right third is left empty on purpose: the signed-in person lives in the
                     left bar now (D-51), and an empty third keeps the shop name in the true centre
                     instead of being pushed right by a row of icons. -->
            </Grid>
        </Border>

        <!-- ===================== Sidebar ===================== -->
        <Border Grid.Row="1" Grid.Column="0" Background="{StaticResource SidebarBrush}">
            <Grid Margin="10,8,10,10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <ListBox Grid.Row="0"
                         ItemsSource="{Binding NavItems}"
                         SelectedItem="{Binding SelectedNav, Mode=TwoWay}"
                         Background="Transparent"
                         BorderThickness="0"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         ScrollViewer.VerticalScrollBarVisibility="Auto">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <!-- A folded row is hidden, never removed: a rebuilt list loses the
                                 selected row, and with it the page the operator is reading. -->
                            <Setter Property="Visibility"
                                    Value="{Binding IsVisible, Converter={StaticResource BoolToVis}}" />
                            <Setter Property="Padding" Value="9,6" />
                            <Setter Property="Margin" Value="0,1" />
                            <Setter Property="Foreground" Value="#E2E8F0" />
                            <Setter Property="Cursor" Value="Hand" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Border x:Name="ItemBackground" Background="Transparent" CornerRadius="6"
                                                Padding="{TemplateBinding Padding}">
                                            <ContentPresenter />
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="ItemBackground" Property="Background"
                                                        Value="{StaticResource SidebarItemBrush}" />
                                            </Trigger>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="ItemBackground" Property="Background"
                                                        Value="{StaticResource BrandBrush}" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsHeader}" Value="True">
                                    <!-- The heading's own padding moves inside the button (below), so
                                         the button covers the whole row and every pixel of it folds
                                         the group. The item itself must stay hit-testable or the
                                         button inside it would stop receiving clicks too. -->
                                    <Setter Property="Padding" Value="0" />
                                    <Setter Property="Focusable" Value="False" />
                                    <Setter Property="Cursor" Value="Arrow" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <!-- A page: its title only. The subtitle is the tooltip, so the menu
                                     stays one line high inside 176 pixels. -->
                                <TextBlock Text="{Binding Title}" FontSize="12" FontWeight="SemiBold"
                                           TextTrimming="CharacterEllipsis"
                                           ToolTip="{Binding Tooltip}"
                                           Visibility="{Binding IsPage, Converter={StaticResource BoolToVis}}" />

                                <!-- A heading: the row is a button that folds its pages. It never
                                     opens a page. -->
                                <Button Style="{StaticResource SidebarBrandButton}"
                                        Padding="9,6"
                                        IsEnabled="{Binding DataContext.CanFoldMenu,
                                                    RelativeSource={RelativeSource AncestorType=ListBox}}"
                                        HorizontalAlignment="Stretch"
                                        HorizontalContentAlignment="Stretch"
                                        Command="{Binding DataContext.ToggleGroupCommand,
                                                  RelativeSource={RelativeSource AncestorType=ListBox}}"
                                        CommandParameter="{Binding}"
                                        Visibility="{Binding IsHeader, Converter={StaticResource BoolToVis}}">
                                    <Button.ToolTip>
                                        <TextBlock Text="Click to put these pages away (Settings can keep every group open)" />
                                    </Button.ToolTip>
                                    <DockPanel>
                                        <TextBlock DockPanel.Dock="Left" Text="{Binding Chevron}"
                                                   FontSize="8" Foreground="#94A3B8"
                                                   VerticalAlignment="Center" Margin="0,1,6,0" />
                                        <TextBlock Text="{Binding Title}" FontSize="9.5"
                                                   FontWeight="SemiBold" Foreground="#94A3B8"
                                                   VerticalAlignment="Center"
                                                   TextTrimming="CharacterEllipsis" />
                                    </DockPanel>
                                </Button>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <StackPanel Grid.Row="1" Margin="0,8,0,0">
                    <!-- The person: photo, name, role - and the way out of the app. -->
                    <Button x:Name="UserChip"
                            Style="{StaticResource SidebarBrandButton}"
                            Command="{Binding OpenUserMenuCommand}"
                            HorizontalContentAlignment="Stretch"
                            Padding="6,6"
                            ToolTip="My settings and sign out">
                        <DockPanel>
                            <Border DockPanel.Dock="Left" Width="26" Height="26" CornerRadius="13"
                                    Background="{StaticResource BrandBrush}">
                                <TextBlock Text="{Binding Initials}" Foreground="White" FontWeight="Bold"
                                           FontSize="11" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <StackPanel Margin="7,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="{Binding UserName}" Foreground="White" FontSize="11.5"
                                           FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{Binding RoleText}" Foreground="#94A3B8" FontSize="9" />
                            </StackPanel>
                        </DockPanel>
                    </Button>

                    <TextBlock Text="{x:Static utils:BuildInfo.Label}" Foreground="#64748B" FontSize="9"
                               Margin="2,6,0,0" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- ===================== The page ===================== -->
        <ContentControl Grid.Row="1" Grid.Column="1" Margin="20,16,20,18"
                        Content="{Binding CurrentViewModel}" />

        <!-- ===================== The person's own menu ===================== -->
        <Popup IsOpen="{Binding UserMenuOpen, Mode=TwoWay}"
               StaysOpen="False"
               AllowsTransparency="True"
               Placement="Top"
               PlacementTarget="{Binding ElementName=UserChip}"
               VerticalOffset="-4"
               PopupAnimation="Fade">
            <Border Background="{StaticResource SurfaceBrush}" CornerRadius="10"
                    BorderBrush="{StaticResource LineBrush}" BorderThickness="1"
                    Padding="12" Width="220">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="14" ShadowDepth="2" Opacity="0.2" />
                </Border.Effect>
                <StackPanel>
                    <DockPanel Margin="0,0,0,10">
                        <Border DockPanel.Dock="Left" Width="30" Height="30" CornerRadius="15"
                                Background="{StaticResource BrandSoftBrush}">
                            <TextBlock Text="{Binding Initials}" Foreground="{StaticResource BrandDarkBrush}"
                                       FontWeight="Bold" HorizontalAlignment="Center"
                                       VerticalAlignment="Center" />
                        </Border>
                        <StackPanel Margin="8,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="{Binding UserName}" FontSize="12" FontWeight="SemiBold"
                                       Foreground="{StaticResource TextBrush}"
                                       TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{Binding RoleText}" FontSize="10"
                                       Foreground="{StaticResource MutedBrush}" />
                        </StackPanel>
                    </DockPanel>

                    <!-- A fixed width, because the shared ghost template centres its content: with
                         the button exactly as wide as the card's inner column, the words sit left. -->
                    <Button Style="{StaticResource GhostButton}"
                            Width="196" HorizontalAlignment="Left"
                            Padding="9,6" Margin="0,0,0,6"
                            Command="{Binding OpenOwnerSettingsCommand}"
                            IsEnabled="{Binding CanOpenSettings}">
                        <TextBlock Text="My settings" />
                    </Button>

                    <Button Style="{StaticResource GhostButton}"
                            Width="196" HorizontalAlignment="Left"
                            Padding="9,6"
                            Foreground="{StaticResource DangerBrush}"
                            BorderBrush="{StaticResource DangerBrush}"
                            Command="{Binding LogoutCommand}">
                        <TextBlock Text="Sign out" />
                    </Button>
                </StackPanel>
            </Border>
        </Popup>
    </Grid>
</Window>
