<Window x:Class="Area11.Desktop.Views.ShellWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:Area11.Desktop.ViewModels"
        xmlns:views="clr-namespace:Area11.Desktop.Views"
        xmlns:utils="clr-namespace:Area11.Core.Utils;assembly=Area11.Core"
        Title="{x:Static utils:BuildInfo.WindowTitle}" Height="760" Width="1240"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource CanvasBrush}"
        PreviewMouseDown="OnActivity" PreviewKeyDown="OnActivity">

    <!-- Phase-1 frame: fixed Area11 wordmark, permission-filtered modules, a large top-right bell,
         and one contextual row for module pages / Settings sections / Product categories. There is
         no left sidebar. Existing page templates, alert state, session notice and fault cards stay. -->
    <Window.Resources>
        <Style x:Key="ModuleButton" TargetType="Button" BasedOn="{StaticResource HeaderNavButton}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsCurrentModule}" Value="True">
                    <Setter Property="Background" Value="{StaticResource BrandBrush}" />
                    <Setter Property="Foreground" Value="White" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="ContextPageButton" TargetType="Button" BasedOn="{StaticResource HeaderNavButton}">
            <Setter Property="Padding" Value="10,6" />
            <Setter Property="MinHeight" Value="32" />
            <Setter Property="FontSize" Value="11.5" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsCurrentPage}" Value="True">
                    <Setter Property="Background" Value="{StaticResource BrandBrush}" />
                    <Setter Property="Foreground" Value="White" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="SettingsSectionButton" TargetType="Button" BasedOn="{StaticResource HeaderNavButton}">
            <Setter Property="Padding" Value="10,6" />
            <Setter Property="MinHeight" Value="32" />
            <Setter Property="FontSize" Value="11.5" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                    <Setter Property="Background" Value="{StaticResource BrandBrush}" />
                    <Setter Property="Foreground" Value="White" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <DataTemplate DataType="{x:Type vm:DashboardViewModel}">
            <views:DashboardView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:PageFaultViewModel}">
            <views:PageFaultView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:PosViewModel}">
            <views:PosView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:PurchasesViewModel}">
            <views:PurchasesView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:ProductsViewModel}">
            <views:ProductsView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:SettingsViewModel}">
            <views:SettingsView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:ReturnsViewModel}">
            <views:ReturnsView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:AlertsViewModel}">
            <views:AlertsView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:ProvisionalViewModel}">
            <views:ProvisionalView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:WriteOffViewModel}">
            <views:WriteOffView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:StockTakeViewModel}">
            <views:StockTakeView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:PartnersViewModel}">
            <views:PartnersView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:ShiftViewModel}">
            <views:ShiftView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:ExpensesViewModel}">
            <views:ExpensesView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:ReportsViewModel}">
            <views:ReportsView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:AuditViewModel}">
            <views:AuditView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:BackupViewModel}">
            <views:BackupView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:ImportExportViewModel}">
            <views:ImportExportView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:ReorderViewModel}">
            <views:ReorderView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:StockMinusViewModel}">
            <views:StockMinusView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:CustomFieldsViewModel}">
            <views:CustomFieldsView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:DoctorsViewModel}">
            <views:DoctorsView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:LanViewModel}">
            <views:LanView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:TaxViewModel}">
            <views:TaxView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:HardwareViewModel}">
            <views:HardwareView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:CloudSyncViewModel}">
            <views:CloudSyncView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:SaleHistoryViewModel}">
            <views:SaleHistoryView />
        </DataTemplate>
        <!-- F-54: the read-only "do the books add up?" page. A page without a template is a blank
             screen, not a missing page - WPF cannot say which one is wrong. -->
        <DataTemplate DataType="{x:Type vm:BookCheckViewModel}">
            <views:BookCheckView />
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ===================== Main dark header ===================== -->
        <Border Grid.Row="0" Background="{StaticResource SidebarBrush}">
            <Grid Margin="14,5">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- The application title is deliberately fixed: no shop name or editable alias. -->
                <Button Grid.Column="0" Style="{StaticResource SidebarBrandButton}"
                        Command="{Binding GoHomeCommand}" ToolTip="{DynamicResource AppLabel.dashboard}"
                        Padding="6,3" Margin="0,0,12,0" VerticalAlignment="Center"
                        AutomationProperties.Name="Area11 - Dashboard">
                    <TextBlock Text="Area11" Foreground="White" FontSize="22"
                               FontWeight="Bold" VerticalAlignment="Center" />
                </Button>

                <!-- Dashboard + permission-filtered module headings. WrapPanel keeps every module
                     reachable on a narrower PC instead of clipping the row. -->
                <ItemsControl Grid.Column="1" ItemsSource="{Binding ModuleItems}"
                              VerticalAlignment="Center">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Style="{StaticResource ModuleButton}"
                                    Content="{Binding Title}"
                                    ToolTip="{Binding Tooltip}"
                                    Command="{Binding DataContext.OpenModuleCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                    CommandParameter="{Binding}" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- The person precedes the bell, so Alerts remains the extreme top-right action. -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="UserChip" Style="{StaticResource SidebarBrandButton}"
                            Command="{Binding OpenUserMenuCommand}"
                            HorizontalContentAlignment="Stretch" Padding="7,4" Margin="0,0,8,0"
                            ToolTip="My settings and sign out"
                            AutomationProperties.Name="Current user">
                        <DockPanel>
                            <Border DockPanel.Dock="Left" Width="30" Height="30" CornerRadius="15"
                                    Background="{StaticResource BrandBrush}">
                                <TextBlock Text="{Binding Initials}" Foreground="White" FontWeight="Bold"
                                           FontSize="11" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <StackPanel Margin="7,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="{Binding UserName}" Foreground="White" FontSize="11.5"
                                           FontWeight="SemiBold" TextTrimming="CharacterEllipsis" MaxWidth="115" />
                                <TextBlock Text="{Binding RoleText}" Foreground="#94A3B8" FontSize="9" />
                            </StackPanel>
                        </DockPanel>
                    </Button>

                    <Button x:Name="Bell" Command="{Binding OpenAlertsCommand}"
                            ToolTip="{Binding BellSummaryText}" Width="44" Height="44" Padding="0"
                            VerticalAlignment="Center" HorizontalContentAlignment="Center"
                            AutomationProperties.Name="Alerts"
                            AutomationProperties.HelpText="{Binding BellSummaryText}">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource SidebarBrandButton}">
                                <Setter Property="Padding" Value="0" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsShowingAlerts}" Value="True">
                                        <Setter Property="Background" Value="{StaticResource BrandBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <Grid Width="34" Height="34">
                            <TextBlock Text="&#xE7ED;" FontFamily="Segoe MDL2 Assets" FontSize="22"
                                       HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="#E2E8F0" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding BellSeverity}" Value="Red">
                                                <Setter Property="Foreground" Value="#F87171" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding BellSeverity}" Value="Yellow">
                                                <Setter Property="Foreground" Value="#FCD34D" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding BellSeverity}" Value="Green">
                                                <Setter Property="Foreground" Value="#4ADE80" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <Border CornerRadius="9" MinWidth="18" Height="18" Padding="4,0"
                                    HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-1,-2,0"
                                    Visibility="{Binding HasBellAlerts, Converter={StaticResource BoolToVis}}">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background" Value="#FCD34D" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding BellSeverity}" Value="Red">
                                                <Setter Property="Background" Value="#F87171" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding BellSeverity}" Value="Yellow">
                                                <Setter Property="Background" Value="#FCD34D" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding BellSeverity}" Value="Green">
                                                <Setter Property="Background" Value="#4ADE80" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <TextBlock Text="{Binding BellBadgeText}" Foreground="#111827" FontSize="9.5"
                                           FontWeight="Bold" HorizontalAlignment="Center"
                                           VerticalAlignment="Center" />
                            </Border>
                        </Grid>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ===================== Contextual dark header ===================== -->
        <Border Grid.Row="1" Background="#111C30" BorderBrush="#263449" BorderThickness="0,0,0,1"
                Padding="12,3" Visibility="{Binding HasContextNavigation, Converter={StaticResource BoolToVis}}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <ItemsControl ItemsSource="{Binding SubNavItems}"
                                  Visibility="{Binding HasSubNavigation, Converter={StaticResource BoolToVis}}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Style="{StaticResource ContextPageButton}"
                                        Content="{Binding Title}" ToolTip="{Binding Tooltip}"
                                        Command="{Binding DataContext.OpenPageCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                        CommandParameter="{Binding}" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- Settings keeps its existing six contents, but their clickable section controls
                         live here rather than consuming a second in-content tab strip. The ordinary
                         SYSTEM destinations stay above this row so Settings never traps navigation. -->
                    <ItemsControl ItemsSource="{Binding SettingsTabItems}" Margin="0,3,0,0"
                                  Visibility="{Binding IsShowingSettings, Converter={StaticResource BoolToVis}}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Style="{StaticResource SettingsSectionButton}"
                                        Content="{Binding Title}" ToolTip="{Binding Title}"
                                        Command="{Binding DataContext.OpenSettingsTabCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                        CommandParameter="{Binding}" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>

                <!-- Type-ahead category/folder picker. Its id drives the existing Products filter;
                     the product editor's SelectedCategory is deliberately not bound here. -->
                <ComboBox Grid.Column="1" ItemsSource="{Binding ProductCategories}"
                          SelectedItem="{Binding SelectedProductCategory, Mode=TwoWay}"
                          DisplayMemberPath="DisplayName"
                          IsTextSearchEnabled="True" TextSearch.TextPath="DisplayName"
                          Width="250" Height="34" Margin="10,2,0,2"
                          Background="#F8FAFC" Foreground="{StaticResource TextBrush}"
                          HorizontalAlignment="Right" VerticalAlignment="Center"
                          ToolTip="Product folder / category - type letters to find one"
                          Visibility="{Binding IsShowingProducts, Converter={StaticResource BoolToVis}}"
                          AutomationProperties.Name="Product category filter" />
            </Grid>
        </Border>

        <!-- Session warnings stay visible without displacing Alerts from the top-right. -->
        <Border Grid.Row="2" Background="{StaticResource SidebarBrush}" Padding="16,0,16,8"
                Visibility="{Binding HasSessionNotice, Converter={StaticResource BoolToVis}}">
            <TextBlock Text="{Binding SessionNotice}" Foreground="#FCD34D" FontSize="11.5"
                       TextWrapping="Wrap" />
        </Border>

        <!-- ===================== The page ===================== -->
        <Grid Grid.Row="3" Margin="14,12,14,14">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Background="{StaticResource DangerSoftBrush}"
                    BorderBrush="{StaticResource DangerBrush}" BorderThickness="1"
                    CornerRadius="8" Padding="12,8" Margin="0,0,0,10"
                    Visibility="{Binding HasFaultBanner, Converter={StaticResource BoolToVis}}"
                    AutomationProperties.Name="The last button failed">
                <DockPanel>
                    <Button DockPanel.Dock="Right" Content="Dismiss"
                            Command="{Binding DismissFaultCommand}"
                            Style="{StaticResource GhostButton}" Padding="10,4" FontSize="11.5"
                            Margin="10,0,0,0" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding FaultBanner, Mode=OneWay}" TextWrapping="Wrap"
                               FontSize="12" Foreground="{StaticResource TextBrush}"
                               VerticalAlignment="Center" />
                </DockPanel>
            </Border>

            <ContentControl Grid.Row="1" Content="{Binding CurrentViewModel}" />

            <Border Grid.Row="2" Style="{StaticResource EmptyCard}"
                    Visibility="{Binding EmptyHint, Converter={StaticResource EmptyHintVis}}"
                    AutomationProperties.Name="Why this page is empty">
                <StackPanel>
                    <TextBlock Text="{Binding EmptyHint, Converter={StaticResource EmptyHintText}, ConverterParameter=Headline}"
                               FontSize="12.5" FontWeight="SemiBold" TextWrapping="Wrap"
                               Foreground="{StaticResource BrandDarkBrush}" />
                    <TextBlock Text="{Binding EmptyHint, Converter={StaticResource EmptyHintText}, ConverterParameter=Advice}"
                               Style="{StaticResource FieldHint}" Margin="0,4,0,0" />
                </StackPanel>
            </Border>
        </Grid>

        <!-- ===================== The person's own menu ===================== -->
        <Popup IsOpen="{Binding UserMenuOpen, Mode=TwoWay}"
               StaysOpen="False" AllowsTransparency="True"
               Placement="Bottom" PlacementTarget="{Binding ElementName=UserChip}"
               VerticalOffset="6" PopupAnimation="Fade">
            <Border Background="{StaticResource SurfaceBrush}" CornerRadius="10"
                    BorderBrush="{StaticResource LineBrush}" BorderThickness="1"
                    Padding="12" Width="220">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="14" ShadowDepth="2" Opacity="0.2" />
                </Border.Effect>
                <StackPanel>
                    <DockPanel Margin="0,0,0,10">
                        <Border DockPanel.Dock="Left" Width="30" Height="30" CornerRadius="15"
                                Background="{StaticResource BrandSoftBrush}">
                            <TextBlock Text="{Binding Initials}" Foreground="{StaticResource BrandDarkBrush}"
                                       FontWeight="Bold" HorizontalAlignment="Center"
                                       VerticalAlignment="Center" />
                        </Border>
                        <StackPanel Margin="8,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="{Binding UserName}" FontSize="12" FontWeight="SemiBold"
                                       Foreground="{StaticResource TextBrush}" TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{Binding RoleText}" FontSize="10"
                                       Foreground="{StaticResource MutedBrush}" />
                        </StackPanel>
                    </DockPanel>

                    <Button Style="{StaticResource GhostButton}"
                            Width="196" HorizontalAlignment="Left"
                            Padding="9,6" Margin="0,0,0,6"
                            Command="{Binding OpenOwnerSettingsCommand}"
                            IsEnabled="{Binding CanOpenSettings}">
                        <TextBlock Text="My settings" />
                    </Button>

                    <Button Style="{StaticResource GhostButton}"
                            Width="196" HorizontalAlignment="Left"
                            Padding="9,6" Foreground="{StaticResource DangerBrush}"
                            BorderBrush="{StaticResource DangerBrush}"
                            Command="{Binding LogoutCommand}">
                        <TextBlock Text="Sign out" />
                    </Button>

                    <TextBlock Text="{x:Static utils:BuildInfo.Label}" Foreground="{StaticResource MutedBrush}"
                               FontSize="9" Margin="2,10,0,0" />
                </StackPanel>
            </Border>
        </Popup>
    </Grid>
</Window>
