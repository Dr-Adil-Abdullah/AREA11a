<Window Icon="{DynamicResource Area11WindowIcon}" x:Class="Area11.Desktop.Views.ProductHistoryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{Binding WindowTitle}" Height="620" Width="860" MinHeight="540" MinWidth="780"
        WindowStartupLocation="CenterOwner" Background="{StaticResource CanvasBrush}">

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,8">
            <TextBlock Text="{Binding Title}" Style="{StaticResource PageTitle}" TextWrapping="Wrap" />
            <TextBlock Text="{Binding TotalsText}" Style="{StaticResource PageSubtitle}" TextWrapping="Wrap" />
            <TextBlock Text="{Binding ProfitText, StringFormat='Item profit before bill Extra Discount: {0}'}" Style="{StaticResource PageSubtitle}" TextWrapping="Wrap" />
        </StackPanel>

        <TextBlock Grid.Row="1" Text="Every purchase and sale, oldest first. Original rates; sale amounts/profit are before separate bill Extra Discount."
                   Style="{StaticResource FieldHint}" Margin="0,0,0,8" TextWrapping="Wrap" />

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="14" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource Card}" Padding="12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="BOUGHT" Style="{StaticResource SectionTitle}" Margin="0,0,0,8" />

                    <DataGrid Grid.Row="1" ItemsSource="{Binding Purchases}" IsReadOnly="True"
                              AutoGenerateColumns="False" HeadersVisibility="Column" GridLinesVisibility="Horizontal">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Date" Binding="{Binding DateLabel, Mode=OneWay}" Width="90" />
                            <DataGridTextColumn Header="Supplier" Binding="{Binding SupplierName, Mode=OneWay}" Width="*" />
                            <DataGridTextColumn Header="Qty" Binding="{Binding QtyLabel, Mode=OneWay}" Width="70" />
                            <DataGridTextColumn Header="Rate" Binding="{Binding RateLabel, Mode=OneWay}" Width="90" />
                            <DataGridTextColumn Header="Total" Binding="{Binding TotalLabel, Mode=OneWay}" Width="90" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>

            <Border Grid.Column="2" Style="{StaticResource Card}" Padding="12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="SOLD" Style="{StaticResource SectionTitle}" Margin="0,0,0,8" />

                    <DataGrid Grid.Row="1" ItemsSource="{Binding Sales}" IsReadOnly="True"
                              AutoGenerateColumns="False" HeadersVisibility="Column" GridLinesVisibility="Horizontal">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Date" Binding="{Binding DateLabel, Mode=OneWay}" Width="90" />
                            <DataGridTextColumn Header="Bill" Binding="{Binding BillCode, Mode=OneWay}" Width="90" />
                            <DataGridTextColumn Header="Buyer" Binding="{Binding BuyerLabel, Mode=OneWay}" Width="*" />
                            <DataGridTextColumn Header="Qty" Binding="{Binding QtyLabel, Mode=OneWay}" Width="70" />
                            <DataGridTextColumn Header="Before Extra" Binding="{Binding TotalLabel, Mode=OneWay}" Width="90" />
                            <DataGridTextColumn Header="Profit" Binding="{Binding ProfitLabel, Mode=OneWay}" Width="90"
                                                Visibility="{Binding DataContext.ProfitVisible, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVis}}" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>
        </Grid>

        <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,12,0,0">
            <Button Content="Print" Style="{StaticResource PrimaryButton}" Width="120"
                    Command="{Binding PrintCommand}" />
            <Button Content="WhatsApp…" Style="{StaticResource GhostButton}" Width="130" Margin="8,0,0,0"
                    Command="{Binding WhatsAppCommand}"
                    ToolTip="Send this history on WhatsApp (PDF prepared for attaching by hand)" />
            <Button Content="Save CSV" Style="{StaticResource GhostButton}" Width="120" Margin="8,0,0,0"
                    Command="{Binding SaveCsvCommand}"
                    ToolTip="Save every line as a CSV file for the accountant" />
            <Button Content="Close" Style="{StaticResource GhostButton}" Width="120" Margin="8,0,0,0"
                    Click="CloseButton_Click" />
        </StackPanel>

        <TextBlock Grid.Row="4" Text="{Binding StatusText}" TextWrapping="Wrap" FontSize="11.5"
                   Margin="0,10,0,0">
            <TextBlock.Style>
                <Style TargetType="TextBlock">
                    <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsStatusError}" Value="True">
                            <Setter Property="Foreground" Value="{StaticResource DangerBrush}" />
                            <Setter Property="FontWeight" Value="Bold" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </TextBlock.Style>
        </TextBlock>
    </Grid>
</Window>
