<UserControl x:Class="Area11.Desktop.Views.BackupView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Title on the left, the folder on the right: the owner must be able to find his files. -->
        <DockPanel Grid.Row="0" Margin="0,0,0,10">
            <StackPanel DockPanel.Dock="Left" VerticalAlignment="Center">
                <TextBlock Text="{DynamicResource AppLabel.backup}" Style="{StaticResource PageTitle}" />
                <TextBlock Text="One zip holds the whole shop - the database and the photos - so a new computer can be up in minutes."
                           Style="{StaticResource PageSubtitle}" />
            </StackPanel>

            <Button DockPanel.Dock="Right" HorizontalAlignment="Right" VerticalAlignment="Center"
                    Content="Open the folder" Style="{StaticResource GhostButton}"
                    Command="{Binding OpenFolderCommand}" />
        </DockPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="420" />
                <ColumnDefinition Width="14" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- ============================ left: make one ============================ -->
            <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto">
                <StackPanel>

                    <Border Style="{StaticResource Card}" Padding="16">
                        <StackPanel>
                            <TextBlock Text="Back up now" Style="{StaticResource SectionTitle}" />
                            <TextBlock Text="The copy is taken by the database itself while other people keep billing - a half-written file can never end up in the zip."
                                       Style="{StaticResource FieldHint}" TextWrapping="Wrap" />

                            <CheckBox Content="Include the photos (recommended)"
                                      IsChecked="{Binding IncludePhotos, Mode=TwoWay}"
                                      Margin="0,12,0,0" />
                            <TextBlock Text="Without them the zip is smaller, but a restored shop has no pictures at all."
                                       Style="{StaticResource FieldHint}" TextWrapping="Wrap" />

                            <Button Content="Back up now" Style="{StaticResource PrimaryButton}"
                                    HorizontalAlignment="Left" Margin="0,14,0,0"
                                    Command="{Binding CreateCommand}" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}" Padding="16">
                        <StackPanel>
                            <TextBlock Text="Where the files go" Style="{StaticResource SectionTitle}" />
                            <TextBlock Text="{Binding FolderText}" Style="{StaticResource FieldHint}"
                                       TextWrapping="Wrap" Margin="0,6,0,0" />

                            <TextBlock Style="{StaticResource FieldHint}" TextWrapping="Wrap" Margin="0,10,0,0"
                                       Text="A backup that stays on the same computer does not protect against that computer failing. Copy the zip to a USB stick, or send it to yourself once a week." />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}" Padding="16">
                        <StackPanel>
                            <TextBlock Text="Automatic backup" Style="{StaticResource SectionTitle}" />
                            <TextBlock Text="{Binding LastAutomatic}" Style="{StaticResource FieldHint}"
                                       TextWrapping="Wrap" Margin="0,4,0,0" />

                            <CheckBox Content="Make a backup by itself"
                                      IsChecked="{Binding AutoEnabled, Mode=TwoWay}"
                                      Margin="0,12,0,0" />

                            <Grid Margin="0,10,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="12" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Every (hours)" Style="{StaticResource FieldLabel}" />
                                    <TextBox Text="{Binding EveryHoursText, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>

                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Keep this many" Style="{StaticResource FieldLabel}" />
                                    <TextBox Text="{Binding KeepText, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>
                            </Grid>

                            <TextBlock Text="Only the program's own automatic files are removed when the old ones are trimmed. Backups you made yourself are never deleted."
                                       Style="{StaticResource FieldHint}" TextWrapping="Wrap" />

                            <Button Content="Save the schedule" Style="{StaticResource GhostButton}"
                                    HorizontalAlignment="Left" Margin="0,12,0,0"
                                    Command="{Binding SaveScheduleCommand}" />
                        </StackPanel>
                    </Border>

                </StackPanel>
            </ScrollViewer>

            <!-- ============================ right: the list ============================ -->
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <DockPanel Grid.Row="0" Margin="0,0,0,8">
                    <TextBlock DockPanel.Dock="Left" Text="Backups on this computer"
                               Style="{StaticResource SectionTitle}" VerticalAlignment="Center" />

                    <Button DockPanel.Dock="Right" HorizontalAlignment="Right" Content="Refresh"
                            Style="{StaticResource GhostButton}" Command="{Binding RefreshCommand}" />
                </DockPanel>

                <Border Grid.Row="1" Style="{StaticResource Card}" Padding="0">
                    <Grid>
                        <ListBox ItemsSource="{Binding Files}"
                                 SelectedItem="{Binding Selected, Mode=TwoWay}"
                                 BorderThickness="0" Background="Transparent"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="4,6">
                                        <TextBlock Text="{Binding FileName}" FontSize="12.5" FontWeight="SemiBold"
                                                   Foreground="{StaticResource TextBrush}"
                                                   TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding Caption}" FontSize="10.5"
                                                   Foreground="{StaticResource MutedBrush}" Margin="0,2,0,0" />
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <TextBlock Text="No backup yet. Press &quot;Back up now&quot; - it takes a few seconds."
                                   Style="{StaticResource FieldHint}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   TextWrapping="Wrap" MaxWidth="320"
                                   Visibility="{Binding HasNoFiles, Converter={StaticResource BoolToVis}}" />
                    </Grid>
                </Border>

                <StackPanel Grid.Row="2" Margin="0,12,0,0">

                    <!-- The first click only asks. Nothing is replaced yet. -->
                    <Button Content="Restore this backup…" Style="{StaticResource GhostButton}"
                            HorizontalAlignment="Left"
                            Command="{Binding AskRestoreCommand}" />

                    <!-- The second click is red and names the file. This is the last moment before
                         the shop's data is replaced. -->
                    <Border Background="{StaticResource DangerSoftBrush}" CornerRadius="8" Padding="14"
                            Margin="0,10,0,0"
                            Visibility="{Binding ConfirmRestore, Converter={StaticResource BoolToVis}}">
                        <StackPanel>
                            <TextBlock Text="This replaces everything" FontWeight="Bold"
                                       Foreground="{StaticResource DangerBrush}" />
                            <TextBlock Text="{Binding ConfirmText}" TextWrapping="Wrap" Margin="0,6,0,0"
                                       Foreground="{StaticResource TextBrush}" />
                            <TextBlock Text="A copy of today's data is saved next to the backups first, so a mistake can be undone by restoring that copy."
                                       TextWrapping="Wrap" Margin="0,6,0,0"
                                       Foreground="{StaticResource MutedBrush}" FontSize="11" />

                            <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                <Button Content="Restore now" Background="{StaticResource DangerBrush}"
                                        BorderBrush="{StaticResource DangerBrush}"
                                        Foreground="White" Style="{StaticResource PrimaryButton}"
                                        Command="{Binding RestoreCommand}" />
                                <Button Content="Cancel" Style="{StaticResource GhostButton}"
                                        Margin="10,0,0,0"
                                        Command="{Binding CancelRestoreCommand}" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </Grid>

        <!-- One status line for the whole page: the same place for success and refusal. -->
        <Border Grid.Row="2" Margin="0,10,0,0" CornerRadius="6" Padding="10,8">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Background" Value="{StaticResource BrandSoftBrush}" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsStatusError}" Value="True">
                            <Setter Property="Background" Value="{StaticResource DangerSoftBrush}" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <TextBlock Text="{Binding StatusText}" TextWrapping="Wrap" FontSize="11.5">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Foreground" Value="{StaticResource BrandDarkBrush}" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsStatusError}" Value="True">
                                <Setter Property="Foreground" Value="{StaticResource DangerBrush}" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
        </Border>
    </Grid>
</UserControl>
