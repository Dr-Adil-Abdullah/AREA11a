<Window Icon="{DynamicResource Area11WindowIcon}" x:Class="Area11.Desktop.Views.ExpenseCategoriesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{Binding WindowTitle}" Height="560" Width="640" MinHeight="440" MinWidth="520"
        WindowStartupLocation="CenterOwner" Background="{StaticResource CanvasBrush}">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,12">
            <TextBlock Text="Expense categories" Style="{StaticResource SectionTitle}" />
            <TextBlock Text="Owner: your own words for spending, under running cost or stock goods. Old expenses keep the spelling they were saved with."
                       Style="{StaticResource FieldHint}" TextWrapping="Wrap" />
            <TextBlock Text="{Binding StatusText}" TextWrapping="Wrap" Margin="0,6,0,0" FontSize="11.5">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Foreground" Value="{StaticResource BrandDarkBrush}" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsStatusError}" Value="True">
                                <Setter Property="Foreground" Value="{StaticResource DangerBrush}" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
        </StackPanel>

        <DataGrid Grid.Row="1" ItemsSource="{Binding Rows}" SelectedItem="{Binding Selected, Mode=TwoWay}" IsReadOnly="True">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Category" Binding="{Binding Name}" Width="2*" />
                <DataGridTextColumn Header="Type" Binding="{Binding TypeLabel, Mode=OneWay}" Width="130" />
                <DataGridTextColumn Header="State" Binding="{Binding StateLabel, Mode=OneWay}" Width="90" />
            </DataGrid.Columns>
        </DataGrid>

        <StackPanel Grid.Row="2" Margin="0,12,0,0">
            <TextBlock Text="Add a category" Style="{StaticResource FieldLabel}" />
            <StackPanel Orientation="Horizontal">
                <TextBox Text="{Binding NameText, UpdateSourceTrigger=PropertyChanged}" Width="240" />
                <ComboBox ItemsSource="{Binding TypeOptions}" DisplayMemberPath="Label"
                          SelectedItem="{Binding SelectedType, Mode=TwoWay}" Width="150" Margin="8,0,0,0" />
                <Button Content="Add" Command="{Binding AddCommand}" Margin="8,0,0,0" MinWidth="70" />
            </StackPanel>
        </StackPanel>

        <StackPanel Grid.Row="3" Margin="0,10,0,0">
            <TextBlock Text="Rename or put away the selected category" Style="{StaticResource FieldLabel}" />
            <StackPanel Orientation="Horizontal">
                <TextBox Text="{Binding RenameText, UpdateSourceTrigger=PropertyChanged}" Width="240" />
                <Button Content="Rename" Command="{Binding RenameCommand}" Margin="8,0,0,0" MinWidth="70" />
                <Button Content="{Binding ToggleLabel}" Command="{Binding ToggleCommand}" Margin="8,0,0,0" MinWidth="80" />
            </StackPanel>
        </StackPanel>
    </Grid>
</Window>
