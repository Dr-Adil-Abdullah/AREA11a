<UserControl x:Class="Area11.Desktop.Views.NativeFieldsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="8">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" TextWrapping="Wrap" Margin="0,0,0,8"
                                Text="Owner only. A product field marked required pops up a warning on the product form (you can still save anyway). Customer and supplier phone and the agency flag are checked on file import only. Sale and purchase rows are preferences: posting still enforces its own rules." />
                            <DataGrid Grid.Row="1" ItemsSource="{Binding Fields}" SelectedItem="{Binding Selected, Mode=TwoWay}"
                                      IsReadOnly="True" AutoGenerateColumns="False">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Form" Binding="{Binding SectionKey}" Width="90" />
                                    <DataGridTextColumn Header="Field" Binding="{Binding Label}" Width="*" />
                                    <DataGridTextColumn Header="Data type" Binding="{Binding DataType}" Width="110" />
                                    <DataGridTextColumn Header="Input" Binding="{Binding InputMethod}" Width="110" />
                                    <DataGridCheckBoxColumn Header="Required" Binding="{Binding Required}" Width="90" />
                                    <DataGridCheckBoxColumn Header="Critical" Binding="{Binding Critical}" Width="80" />
                                </DataGrid.Columns>
                            </DataGrid>
                            <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,8,0,0">
                                <Button Content="Mark required" Command="{Binding RequireCommand}" IsEnabled="{Binding IsOwner}" />
                                <Button Content="Mark optional…" Command="{Binding OptionalCommand}" IsEnabled="{Binding IsOwner}" Margin="8,0,0,0" />
                            </StackPanel>
                            <TextBlock Grid.Row="3" Text="{Binding StatusText}" TextWrapping="Wrap" Margin="0,8,0,0" />
                        </Grid>
</UserControl>
