<Window x:Class="Area11.Desktop.Views.PhotoGalleryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Photos - Area11" Height="620" Width="880"
        WindowStartupLocation="CenterOwner" Background="{StaticResource CanvasBrush}">

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ================================ the heading ================================ -->
        <DockPanel Grid.Row="0" Margin="0,0,0,12">
            <StackPanel DockPanel.Dock="Left" VerticalAlignment="Center">
                <TextBlock Text="{Binding Title}" Style="{StaticResource PageTitle}" TextWrapping="Wrap" />
                <TextBlock Text="{Binding Subtitle}" Style="{StaticResource PageSubtitle}" />
            </StackPanel>

            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right"
                        VerticalAlignment="Center">
                <Button Content="Add a photo…" Style="{StaticResource PrimaryButton}" Margin="0,0,8,0"
                        Command="{Binding AddCommand}" IsEnabled="{Binding CanEdit}" />
                <Button Content="Take a photo (camera)" Style="{StaticResource GhostButton}"
                        Command="{Binding TakePhotoCommand}" IsEnabled="{Binding CanEdit}"
                        ToolTip="Opens the Windows Camera app. Then press Add a photo and pick the picture it saved." />
            </StackPanel>
        </DockPanel>

        <!-- ================================ the two frames ================================ -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="14" />
                <ColumnDefinition Width="300" />
            </Grid.ColumnDefinitions>

            <!-- the big picture -->
            <Border Grid.Column="0" Style="{StaticResource Card}" Padding="12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Background="{StaticResource CanvasBrush}" CornerRadius="6">
                        <Grid>
                            <Image Source="{Binding Preview}" Stretch="Uniform" Margin="8" />

                            <TextBlock Text="No photo chosen. Add one with the button above - two or three pictures are enough."
                                       TextWrapping="Wrap" HorizontalAlignment="Center" VerticalAlignment="Center"
                                       FontSize="12" Foreground="{StaticResource MutedBrush}" MaxWidth="320"
                                       Visibility="{Binding HasNoPhotos, Converter={StaticResource BoolToVis}}" />

                            <TextBlock Text="The picture is missing from the photos folder. The row is still here, so the owner can see what is gone."
                                       TextWrapping="Wrap" HorizontalAlignment="Center" VerticalAlignment="Center"
                                       FontSize="12" Foreground="{StaticResource DangerBrush}" MaxWidth="360"
                                       Visibility="{Binding SelectedMissing, Converter={StaticResource BoolToVis}}" />
                        </Grid>
                    </Border>

                    <DockPanel Grid.Row="1" Margin="0,10,0,0">
                        <StackPanel DockPanel.Dock="Left" VerticalAlignment="Center">
                            <TextBlock Text="{Binding SelectedCaption}" Style="{StaticResource SectionTitle}" />
                            <TextBlock Text="{Binding SelectedWhen}" Style="{StaticResource FieldHint}" />
                        </StackPanel>

                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right"
                                    VerticalAlignment="Center">
                            <Button Content="Open full size" Style="{StaticResource GhostButton}" Margin="0,0,8,0"
                                    Command="{Binding OpenCommand}" />
                            <Button Content="Put away" Style="{StaticResource GhostButton}" Margin="0,0,8,0"
                                    Command="{Binding HideCommand}" IsEnabled="{Binding CanHide}"
                                    ToolTip="Hides the picture. Nothing is deleted - the file stays on the disk." />
                            <Button Content="Bring back" Style="{StaticResource GhostButton}"
                                    Command="{Binding RestoreCommand}" IsEnabled="{Binding CanRestore}" />
                        </StackPanel>
                    </DockPanel>
                </Grid>
            </Border>

            <!-- the strip -->
            <Border Grid.Column="2" Style="{StaticResource Card}" Padding="12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <DockPanel Grid.Row="0" Margin="0,0,0,8">
                        <TextBlock DockPanel.Dock="Left" Text="{Binding CountText}" FontWeight="SemiBold"
                                   VerticalAlignment="Center" />
                        <TextBlock DockPanel.Dock="Right" HorizontalAlignment="Right" Text="{Binding HiddenText}"
                                   Style="{StaticResource FieldHint}" VerticalAlignment="Center" />
                    </DockPanel>

                    <Grid Grid.Row="1">
                        <ListBox ItemsSource="{Binding Photos}" SelectedItem="{Binding Selected, Mode=TwoWay}"
                                 BorderBrush="{StaticResource LineBrush}" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border Padding="6" Margin="0,0,0,4" CornerRadius="6"
                                            Background="{StaticResource CanvasBrush}">
                                        <StackPanel Orientation="Horizontal">
                                            <Image Source="{Binding Thumbnail}" Width="64" Height="48" Stretch="UniformToFill" />
                                            <StackPanel Margin="8,0,0,0" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Caption}" FontSize="12" FontWeight="SemiBold" />
                                                <TextBlock Text="{Binding StateLabel}" Style="{StaticResource FieldHint}" />
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <TextBlock Text="No photos yet." HorizontalAlignment="Center" VerticalAlignment="Center"
                                   FontSize="12" Foreground="{StaticResource MutedBrush}"
                                   Visibility="{Binding HasNoPhotos, Converter={StaticResource BoolToVis}}" />
                    </Grid>

                    <Button Grid.Row="2" Margin="0,8,0,0" Command="{Binding ShowHiddenCommand}">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource GhostButton}">
                                <Setter Property="Content" Value="{Binding HiddenToggleLabel}" />
                            </Style>
                        </Button.Style>
                    </Button>
                </Grid>
            </Border>
        </Grid>

        <!-- ================================ the footer ================================ -->
        <StackPanel Grid.Row="2" Margin="0,10,0,0">
            <TextBlock Text="{Binding StatusText}" TextWrapping="Wrap" FontSize="11.5">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsStatusError}" Value="True">
                                <Setter Property="Foreground" Value="{StaticResource DangerBrush}" />
                                <Setter Property="FontWeight" Value="Bold" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>

            <TextBlock Text="{Binding CameraHint}" Style="{StaticResource FieldHint}" TextWrapping="Wrap"
                       Margin="0,6,0,0" />
        </StackPanel>
    </Grid>
</Window>
