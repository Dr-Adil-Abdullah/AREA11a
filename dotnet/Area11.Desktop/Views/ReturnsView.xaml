<UserControl x:Class="Area11.Desktop.Views.ReturnsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,6">
            <TextBlock Text="Returns" Style="{StaticResource PageTitle}" />
            <TextBlock Text="Never more than was sold · never more money than was collected · every return keeps its own number"
                       Style="{StaticResource PageSubtitle}" />
        </StackPanel>

        <TabControl Grid.Row="1">

            <!-- ======================= TAKE A RETURN ======================= -->
            <TabItem Header="Take a return">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.6*" />
                        <ColumnDefinition Width="14" />
                        <ColumnDefinition Width="1*" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Style="{StaticResource Card}" Padding="12">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <Grid Grid.Row="0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="8" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Bill number" Style="{StaticResource FieldLabel}" />
                                    <TextBox Text="{Binding BillCode, UpdateSourceTrigger=PropertyChanged}"
                                             ToolTip="For example INV-0001" />
                                </StackPanel>

                                <StackPanel Grid.Column="2" VerticalAlignment="Bottom" Orientation="Horizontal">
                                    <Button Content="Find bill" Style="{StaticResource PrimaryButton}"
                                            Command="{Binding FindCommand}" />
                                    <Button Content="Clear" Style="{StaticResource GhostButton}" Margin="8,0,0,0"
                                            Command="{Binding ClearCommand}" />
                                </StackPanel>
                            </Grid>

                            <!-- No bill number? Find it by anything the customer remembers (F-20). -->
                            <Expander Grid.Row="1" Header="No bill number? Find it" Margin="0,8,0,0"
                                      IsExpanded="False">
                                <StackPanel>
                                    <Grid Margin="0,6,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="8" />
                                            <ColumnDefinition Width="110" />
                                            <ColumnDefinition Width="8" />
                                            <ColumnDefinition Width="110" />
                                            <ColumnDefinition Width="8" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="Bill number, phone, name or medicine"
                                                       Style="{StaticResource FieldLabel}" />
                                            <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                                     ToolTip="0300-1234567, Ali Raza, Panadol, INV-0007 - any part of it" />
                                        </StackPanel>

                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="From" Style="{StaticResource FieldLabel}" />
                                            <TextBox Text="{Binding FromDate, UpdateSourceTrigger=PropertyChanged}"
                                                     ToolTip="2026-10-01 - leave empty for no limit" />
                                        </StackPanel>

                                        <StackPanel Grid.Column="4">
                                            <TextBlock Text="To" Style="{StaticResource FieldLabel}" />
                                            <TextBox Text="{Binding ToDate, UpdateSourceTrigger=PropertyChanged}"
                                                     ToolTip="2026-10-31 - leave empty for no limit" />
                                        </StackPanel>

                                        <Button Grid.Column="6" Content="Search" VerticalAlignment="Bottom"
                                                Style="{StaticResource PrimaryButton}"
                                                Command="{Binding SearchCommand}" />
                                    </Grid>

                                    <TextBlock Text="{Binding SearchCaption}" Style="{StaticResource FieldHint}"
                                               TextWrapping="Wrap" Margin="0,6,0,4" />

                                    <StackPanel Orientation="Horizontal">
                                        <Button Content="Open this bill" Style="{StaticResource GhostButton}"
                                                Command="{Binding OpenMatchCommand}" />
                                    </StackPanel>

                                    <DataGrid ItemsSource="{Binding Matches}" Height="140" Margin="0,6,0,0"
                                              SelectedItem="{Binding SelectedMatch, Mode=TwoWay}"
                                              Visibility="{Binding HasMatches, Converter={StaticResource BoolToVis}}">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="Bill" Binding="{Binding Code}" Width="90" />
                                            <DataGridTextColumn Header="When" Binding="{Binding DateLabel, Mode=OneWay}" Width="120" />
                                            <DataGridTextColumn Header="Customer" Binding="{Binding CustomerLabel, Mode=OneWay}" Width="*" />
                                            <DataGridTextColumn Header="Items" Binding="{Binding ItemsLabel, Mode=OneWay}" Width="70" />
                                            <DataGridTextColumn Header="Total" Binding="{Binding TotalText, Mode=OneWay}" Width="90" />
                                            <DataGridTextColumn Header="Due" Binding="{Binding DueLabel, Mode=OneWay}" Width="90" />
                                            <DataGridTextColumn Header="Status" Binding="{Binding StatusLabel, Mode=OneWay}" Width="90" />
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </StackPanel>
                            </Expander>

                            <TextBlock Grid.Row="2" Text="{Binding BillSummary}" Style="{StaticResource FieldHint}"
                                       Margin="0,8,0,8" />

                            <DataGrid Grid.Row="3" ItemsSource="{Binding Lines}">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Medicine" Binding="{Binding Name, Mode=OneWay}" Width="2*" />
                                    <DataGridTextColumn Header="Sold" Binding="{Binding SoldLabel, Mode=OneWay}" Width="80" />
                                    <DataGridTextColumn Header="Returned" Binding="{Binding ReturnedLabel, Mode=OneWay}" Width="80" />
                                    <DataGridTextColumn Header="Can return" Binding="{Binding RemainingLabel, Mode=OneWay}" Width="90" />
                                    <DataGridTextColumn Header="Refund if all" Binding="{Binding MoneyLabel, Mode=OneWay}" Width="100" />

                                    <!-- The only editable cell: how many units are coming back (base units). -->
                                    <DataGridTemplateColumn Header="Coming back" Width="100">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBox Text="{Binding QtyText, UpdateSourceTrigger=PropertyChanged}"
                                                         IsEnabled="{Binding CanReturn}" Margin="2" />
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </Border>

                    <Border Grid.Column="2" Style="{StaticResource Card}" Padding="14">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <TextBlock Text="Refund" Style="{StaticResource SectionTitle}" />

                                <TextBlock Text="Reason" Style="{StaticResource FieldLabel}" />
                                <ComboBox ItemsSource="{Binding Reasons}" SelectedItem="{Binding Reason, Mode=TwoWay}" />

                                <TextBlock Text="Note (optional)" Style="{StaticResource FieldLabel}" />
                                <TextBox Text="{Binding Note, UpdateSourceTrigger=PropertyChanged}" />

                                <TextBlock Text="Where do the goods go?" Style="{StaticResource FieldLabel}" />
                                <RadioButton GroupName="Destination" Content="Back on the shelf now (default)"
                                             IsChecked="{Binding Restock, Mode=TwoWay}" Margin="0,2,0,0" />
                                <RadioButton GroupName="Destination" Content="Quarantine - decide later (gets a Q-number)"
                                             IsChecked="{Binding ToQuarantine, Mode=TwoWay}" Margin="0,4,0,0" />

                                <Border Background="{StaticResource BrandSoftBrush}" CornerRadius="8" Padding="12"
                                        Margin="0,14,0,0">
                                    <StackPanel>
                                        <TextBlock Text="TOTAL REFUND" Style="{StaticResource MetricLabel}" />
                                        <TextBlock Text="{Binding RefundText}" FontSize="26" FontWeight="Bold"
                                                   Foreground="{StaticResource BrandBrush}" />

                                        <Grid Margin="0,8,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="Cash out" Style="{StaticResource MetricLabel}" />
                                                <TextBlock Text="{Binding CashText}" FontSize="14" FontWeight="SemiBold" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="1">
                                                <TextBlock Text="Khata reduced" Style="{StaticResource MetricLabel}" />
                                                <TextBlock Text="{Binding CreditText}" FontSize="14" FontWeight="SemiBold" />
                                            </StackPanel>
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <Button Content="Take the return  (RET)" Style="{StaticResource PrimaryButton}"
                                        Height="38" Margin="0,14,0,0" Command="{Binding TakeCommand}" />

                                <TextBlock Text="The refund is capped by what this bill actually collected. A credit bill reduces the khata first."
                                           Style="{StaticResource FieldHint}" />
                            </StackPanel>
                        </ScrollViewer>
                    </Border>
                </Grid>
            </TabItem>

            <!-- ========================= QUARANTINE ========================= -->
            <TabItem Header="Quarantine">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.15*" />
                        <ColumnDefinition Width="14" />
                        <ColumnDefinition Width="1*" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Style="{StaticResource Card}" Padding="12">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <DockPanel Grid.Row="0" Margin="0,0,0,8">
                                <TextBlock Text="Waiting for a decision" Style="{StaticResource SectionTitle}"
                                           VerticalAlignment="Center" />
                                <Button DockPanel.Dock="Right" Content="Refresh" HorizontalAlignment="Right"
                                        Style="{StaticResource GhostButton}" Command="{Binding RefreshQuarantineCommand}" />
                            </DockPanel>

                            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                                <StackPanel>
                                    <TextBlock Text="{Binding QuarantineCaption}" Style="{StaticResource FieldHint}"
                                               Margin="0,0,0,8" />

                                    <ItemsControl ItemsSource="{Binding Pending}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border BorderBrush="{StaticResource LineBrush}" BorderThickness="1"
                                                        CornerRadius="8" Padding="10" Margin="0,0,0,10">
                                                    <StackPanel>
                                                        <DockPanel>
                                                            <TextBlock Text="{Binding QCode}" FontWeight="Bold" FontSize="13" />
                                                            <TextBlock Text="{Binding ProductName}" Margin="10,0,0,0" FontSize="12.5" />
                                                        </DockPanel>

                                                        <TextBlock Style="{StaticResource FieldHint}">
                                                            <Run Text="{Binding QuantityLabel, Mode=OneWay}" />
                                                            <Run Text=" · reason: " />
                                                            <Run Text="{Binding ReasonLabel, Mode=OneWay}" />
                                                            <Run Text=" · " />
                                                            <Run Text="{Binding DateLabel, Mode=OneWay}" />
                                                        </TextBlock>

                                                        <TextBox Text="{Binding NoteText, UpdateSourceTrigger=PropertyChanged}"
                                                                 Margin="0,6,0,0" ToolTip="Note (needed when destroying)" />

                                                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                                            <Button Content="Back in stock" Style="{StaticResource PrimaryButton}"
                                                                    FontSize="11" Padding="10,6"
                                                                    Command="{Binding RestockCommand}" />
                                                            <Button Content="Damaged / expired" Style="{StaticResource GhostButton}"
                                                                    Margin="6,0,0,0" Command="{Binding ExpiredCommand}" />
                                                            <Button Content="Sold on" Style="{StaticResource GhostButton}"
                                                                    Margin="6,0,0,0" Command="{Binding SoldCommand}" />
                                                        </StackPanel>
                                                    </StackPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </ScrollViewer>
                        </Grid>
                    </Border>

                    <Border Grid.Column="2" Style="{StaticResource Card}" Padding="12">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <StackPanel Grid.Row="0" Margin="0,0,0,8">
                                <TextBlock Text="Where the goods went" Style="{StaticResource SectionTitle}" />
                                <TextBlock Text="Every decision is kept forever: number, medicine, outcome, time, note."
                                           Style="{StaticResource FieldHint}" />
                            </StackPanel>

                            <DataGrid Grid.Row="1" ItemsSource="{Binding History}">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Q no." Binding="{Binding QCode}" Width="80" />
                                    <DataGridTextColumn Header="Medicine" Binding="{Binding ProductName}" Width="2*" />
                                    <DataGridTextColumn Header="Qty" Binding="{Binding QuantityLabel, Mode=OneWay}" Width="80" />
                                    <DataGridTextColumn Header="Outcome" Binding="{Binding DispositionLabel, Mode=OneWay}" Width="120" />
                                    <DataGridTextColumn Header="When" Binding="{Binding DisposedAt}" Width="130" />
                                    <DataGridTextColumn Header="By" Binding="{Binding DisposedBy}" Width="90" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </Border>
                </Grid>
            </TabItem>

        </TabControl>

        <Border Grid.Row="2" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource LineBrush}"
                BorderThickness="1" CornerRadius="8" Padding="12,8" Margin="0,10,0,0">
            <TextBlock Text="{Binding StatusText}" TextWrapping="Wrap">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="FontSize" Value="12" />
                        <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsStatusError}" Value="True">
                                <Setter Property="Foreground" Value="{StaticResource DangerBrush}" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
        </Border>
    </Grid>
</UserControl>
