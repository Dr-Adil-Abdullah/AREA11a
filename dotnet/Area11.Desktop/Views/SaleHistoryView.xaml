<UserControl x:Class="Area11.Desktop.Views.SaleHistoryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ================================ the heading ================================ -->
        <DockPanel Grid.Row="0" Margin="0,0,0,10">
            <StackPanel DockPanel.Dock="Left" VerticalAlignment="Center">
                <TextBlock Text="{DynamicResource AppLabel.bills}" Style="{StaticResource PageTitle}" />
                <TextBlock Text="Every bill the shop has made: find it, open it, print it again (F-52)."
                           Style="{StaticResource PageSubtitle}" TextWrapping="Wrap" />
            </StackPanel>

            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Content="Today" Style="{StaticResource GhostButton}" Margin="0,0,6,0"
                        Command="{Binding TodayCommand}" />
                <Button Content="7 days" Style="{StaticResource GhostButton}" Margin="0,0,6,0"
                        Command="{Binding WeekCommand}" />
                <Button Content="30 days" Style="{StaticResource GhostButton}" Margin="0,0,6,0"
                        Command="{Binding MonthCommand}" />
                <Button Content="Search" Style="{StaticResource PrimaryButton}"
                        Command="{Binding RefreshCommand}" />
            </StackPanel>
        </DockPanel>

        <!-- ================================ the filters ================================ -->
        <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0,0,0,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Margin="0,0,10,0">
                    <TextBlock Text="SEARCH" Style="{StaticResource FieldLabel}" />
                    <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,0">
                        <TextBox.InputBindings>
                            <KeyBinding Key="Return" Command="{Binding RefreshCommand}" />
                        </TextBox.InputBindings>
                    </TextBox>
                    <TextBlock Text="Bill number, customer name or phone." Style="{StaticResource PageSubtitle}" />
                </StackPanel>

                <StackPanel Grid.Column="1" Margin="0,0,10,0">
                    <TextBlock Text="FROM (2026-10-01)" Style="{StaticResource FieldLabel}" />
                    <TextBox Text="{Binding FromText, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,0" />
                </StackPanel>

                <StackPanel Grid.Column="2" Margin="0,0,10,0">
                    <TextBlock Text="TO" Style="{StaticResource FieldLabel}" />
                    <TextBox Text="{Binding ToText, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,0" />
                </StackPanel>

                <StackPanel Grid.Column="3" Margin="0,0,10,0">
                    <TextBlock Text="PAID BY" Style="{StaticResource FieldLabel}" />
                    <ComboBox ItemsSource="{Binding Methods}" SelectedItem="{Binding SelectedMethod}"
                              Margin="0,4,0,0" />
                </StackPanel>

                <StackPanel Grid.Column="4" VerticalAlignment="Bottom">
                    <Button Content="Clear" Style="{StaticResource GhostButton}" Command="{Binding ClearCommand}" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- ================================ the list and the opened bill ================================ -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*" />
                <ColumnDefinition Width="10" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource Card}">
                <DataGrid ItemsSource="{Binding Rows}" SelectedItem="{Binding Selected, Mode=TwoWay}"
                          IsReadOnly="True" AutoGenerateColumns="False" HeadersVisibility="Column"
                          GridLinesVisibility="Horizontal" SelectionMode="Single">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Bill" Binding="{Binding Code}" Width="110" />
                        <DataGridTextColumn Header="When" Binding="{Binding WhenLabel, Mode=OneWay}" Width="150" />
                        <DataGridTextColumn Header="Customer" Binding="{Binding CustomerLabel, Mode=OneWay}" Width="*" />
                        <DataGridTextColumn Header="Lines" Binding="{Binding ItemsLabel, Mode=OneWay}" Width="70" />
                        <DataGridTextColumn Header="Total" Binding="{Binding TotalLabel, Mode=OneWay}" Width="100" />
                        <DataGridTextColumn Header="Due" Binding="{Binding DueLabel, Mode=OneWay}" Width="90" />
                        <DataGridTextColumn Header="Paid by" Binding="{Binding MethodLabel, Mode=OneWay}" Width="80" />
                        <DataGridTextColumn Header="Status" Binding="{Binding StatusLabel, Mode=OneWay}" Width="90" />
                    </DataGrid.Columns>
                </DataGrid>
            </Border>

            <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <Border Style="{StaticResource Card}" Padding="14">
                        <StackPanel>
                            <TextBlock Text="THE BILL" Style="{StaticResource SectionTitle}" />
                            <TextBlock Text="{Binding SelectedTitle}" FontWeight="SemiBold" TextWrapping="Wrap"
                                       Margin="0,4,0,0" />

                            <ItemsControl ItemsSource="{Binding Lines}" Margin="0,8,0,0">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1" Padding="0,5">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="90" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0">
                                                    <TextBlock Text="{Binding Name}" TextWrapping="Wrap" />
                                                    <TextBlock Style="{StaticResource FieldHint}">
                                                        <Run Text="{Binding QtyLabel, Mode=OneWay}" />
                                                        <Run Text=" x " />
                                                        <Run Text="{Binding RateLabel, Mode=OneWay}" />
                                                    </TextBlock>
                                                </StackPanel>
                                                <TextBlock Grid.Column="1" Text="{Binding TotalLabel}"
                                                           HorizontalAlignment="Right" FontWeight="SemiBold" />
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <Grid Margin="0,8,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Subtotal" Style="{StaticResource FieldHint}" />
                                    <TextBlock Text="Discount" Style="{StaticResource FieldHint}"
                                               Visibility="{Binding HasDiscount, Converter={StaticResource BoolToVis}}" />
                                    <TextBlock Text="Tax" Style="{StaticResource FieldHint}"
                                               Visibility="{Binding HasTax, Converter={StaticResource BoolToVis}}" />
                                    <TextBlock Text="Round-off" Style="{StaticResource FieldHint}"
                                               Visibility="{Binding HasRoundOff, Converter={StaticResource BoolToVis}}" />
                                    <TextBlock Text="Paid" Style="{StaticResource FieldHint}" />
                                    <TextBlock Text="Left on the khata" Style="{StaticResource FieldHint}" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" HorizontalAlignment="Right">
                                    <TextBlock Text="{Binding SubtotalLabel}" HorizontalAlignment="Right" />
                                    <TextBlock Text="{Binding DiscountLabel}" HorizontalAlignment="Right"
                                               Visibility="{Binding HasDiscount, Converter={StaticResource BoolToVis}}" />
                                    <TextBlock Text="{Binding TaxLabel}" HorizontalAlignment="Right"
                                               Visibility="{Binding HasTax, Converter={StaticResource BoolToVis}}" />
                                    <TextBlock Text="{Binding RoundOffLabel}" HorizontalAlignment="Right"
                                               Visibility="{Binding HasRoundOff, Converter={StaticResource BoolToVis}}" />
                                    <TextBlock Text="{Binding PaidLabel}" HorizontalAlignment="Right" />
                                    <TextBlock Text="{Binding DueLabel}" HorizontalAlignment="Right"
                                               FontWeight="SemiBold" />
                                </StackPanel>
                            </Grid>

                            <DockPanel Margin="0,10,0,0">
                                <TextBlock DockPanel.Dock="Left" Text="TOTAL" Style="{StaticResource SectionTitle}" />
                                <TextBlock DockPanel.Dock="Right" HorizontalAlignment="Right" FontSize="18"
                                           FontWeight="Bold" Text="{Binding TotalLabel}" />
                            </DockPanel>

                            <Button Content="Print this bill again" Style="{StaticResource PrimaryButton}"
                                    Command="{Binding PrintCommand}" IsEnabled="{Binding CanPrint}"
                                    Margin="0,10,0,0" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}" Padding="14" Margin="0,10,0,0"
                            Visibility="{Binding HasReturns, Converter={StaticResource BoolToVis}}">
                        <StackPanel>
                            <TextBlock Text="RETURNS ON THIS BILL" Style="{StaticResource SectionTitle}" />

                            <ListBox ItemsSource="{Binding Returns}" SelectedItem="{Binding SelectedReturn, Mode=TwoWay}"
                                     Margin="0,8,0,0" MaxHeight="150">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Margin="0,2">
                                            <DockPanel>
                                                <TextBlock DockPanel.Dock="Left" Text="{Binding Code}" FontWeight="SemiBold" />
                                                <TextBlock DockPanel.Dock="Right" Text="{Binding AmountLabel}"
                                                           HorizontalAlignment="Right" FontWeight="SemiBold" />
                                                <TextBlock Text="{Binding WhenLabel}" Style="{StaticResource FieldHint}"
                                                           Margin="10,0,0,0" />
                                            </DockPanel>
                                            <TextBlock Text="{Binding WhereLabel}" Style="{StaticResource FieldHint}" />
                                            <TextBlock Text="{Binding MoneyLabel}" Style="{StaticResource FieldHint}" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>

                            <Button Content="Print this return receipt" Style="{StaticResource GhostButton}"
                                    Command="{Binding PrintReturnCommand}" IsEnabled="{Binding CanPrintReturn}"
                                    HorizontalAlignment="Left" Margin="0,8,0,0" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}" Padding="14" Margin="0,10,0,0"
                            Visibility="{Binding HasPayments, Converter={StaticResource BoolToVis}}">
                        <StackPanel>
                            <TextBlock Text="MONEY THAT CAME IN" Style="{StaticResource SectionTitle}" />
                            <ItemsControl ItemsSource="{Binding Payments}" Margin="0,8,0,0">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <DockPanel Margin="0,3,0,0">
                                            <TextBlock DockPanel.Dock="Right" Text="{Binding AmountLabel}"
                                                       HorizontalAlignment="Right" />
                                            <TextBlock>
                                                <Run Text="{Binding WhenLabel, Mode=OneWay}" />
                                                <Run Text=" - " />
                                                <Run Text="{Binding MethodLabel, Mode=OneWay}" />
                                            </TextBlock>
                                        </DockPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}" Padding="14" Margin="0,10,0,0"
                            Visibility="{Binding HasSelection, Converter={StaticResource BoolToVis}}">
                        <StackPanel>
                            <TextBlock Text="WHAT WILL PRINT" Style="{StaticResource SectionTitle}" />
                            <TextBlock Style="{StaticResource FieldHint}" TextWrapping="Wrap" Margin="0,4,0,0"
                                       Text="The paper, character for character, at the width in Settings. A missing last digit here is a missing digit on the printer." />
                            <TextBox Text="{Binding PreviewText, Mode=OneWay}" IsReadOnly="True"
                                     FontFamily="Consolas" FontSize="12" Margin="0,8,0,0" Padding="8"
                                     AcceptsReturn="True" TextWrapping="NoWrap" MaxHeight="260"
                                     VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <!-- ================================ the footer ================================ -->
        <Grid Grid.Row="3" Margin="0,10,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0" Text="{Binding CountText}" Style="{StaticResource SectionTitle}"
                       VerticalAlignment="Center" Margin="0,0,14,0" />
            <TextBlock Grid.Column="1" Text="{Binding TotalText}" Style="{StaticResource PageSubtitle}"
                       VerticalAlignment="Center" Margin="0,0,14,0" />
            <TextBlock Grid.Column="2" Text="{Binding DueText}" Style="{StaticResource PageSubtitle}"
                       VerticalAlignment="Center" Margin="0,0,14,0" />

            <TextBlock Grid.Column="3" Text="{Binding StatusText}" TextWrapping="Wrap" FontSize="11.5"
                       VerticalAlignment="Center">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsStatusError}" Value="True">
                                <Setter Property="Foreground" Value="{StaticResource DangerBrush}" />
                                <Setter Property="FontWeight" Value="Bold" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
        </Grid>
    </Grid>
</UserControl>
