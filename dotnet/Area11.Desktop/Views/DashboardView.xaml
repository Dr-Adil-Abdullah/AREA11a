<UserControl x:Class="Area11.Desktop.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel>
            <DockPanel Margin="0,0,0,16">
                <StackPanel DockPanel.Dock="Left">
                    <TextBlock Text="{DynamicResource AppLabel.dashboard}" Style="{StaticResource PageTitle}" />
                    <TextBlock Text="{Binding TodayText}" Style="{StaticResource PageSubtitle}" />
                </StackPanel>
                <Button Content="Refresh" Style="{StaticResource GhostButton}"
                        HorizontalAlignment="Right" VerticalAlignment="Center"
                        Command="{Binding RefreshCommand}" />
            </DockPanel>

            <Border Background="{StaticResource DangerSoftBrush}" BorderBrush="{StaticResource DangerBrush}"
                    BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,14">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding HasAlert}" Value="True">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <TextBlock Text="{Binding StatusMessage}" Foreground="{StaticResource DangerBrush}"
                           FontWeight="SemiBold" FontSize="12" TextWrapping="Wrap" />
            </Border>

            <UniformGrid Columns="4" Margin="0,0,0,14">
                <Border Style="{StaticResource Card}" Margin="0,0,6,0">
                    <Button Command="{Binding OpenBillsCommand}" Background="Transparent" BorderThickness="0" Padding="0"
                            HorizontalContentAlignment="Stretch" ToolTip="Open today's bills">
                        <StackPanel>
                            <TextBlock Text="TODAY'S BILLS" Style="{StaticResource MetricLabel}" />
                            <TextBlock Text="{Binding BillsText}" Style="{StaticResource MetricValue}" />
                        </StackPanel>
                    </Button>
                </Border>
                <Border Style="{StaticResource Card}" Margin="6,0,6,0">
                    <Button Command="{Binding OpenSalesCommand}" Background="Transparent" BorderThickness="0" Padding="0"
                            HorizontalContentAlignment="Stretch" ToolTip="Open today's sales report">
                        <StackPanel>
                            <TextBlock Text="TODAY'S SALES" Style="{StaticResource MetricLabel}" />
                            <TextBlock Text="{Binding SalesText}" Style="{StaticResource MetricValue}"
                                   Foreground="{StaticResource BrandBrush}" />
                    </StackPanel>
                    </Button>
                </Border>
                <Border Style="{StaticResource Card}" Margin="6,0,6,0"
                        Visibility="{Binding CanSeeProfit, Converter={StaticResource BoolToVis}}">
                    <Button Command="{Binding OpenProfitCommand}" Background="Transparent" BorderThickness="0" Padding="0"
                            HorizontalContentAlignment="Stretch" ToolTip="Open the profit report">
                        <StackPanel>
                            <TextBlock Text="TODAY'S PROFIT" Style="{StaticResource MetricLabel}" />
                            <TextBlock Text="{Binding ProfitText}" Style="{StaticResource MetricValue}"
                                   Foreground="{StaticResource SuccessBrush}" />
                    </StackPanel>
                    </Button>
                </Border>
                <Border Style="{StaticResource Card}" Margin="6,0,0,0">
                    <Button Command="{Binding OpenCreditCommand}" Background="Transparent" BorderThickness="0" Padding="0"
                            HorizontalContentAlignment="Stretch" ToolTip="Open customer credit">
                        <StackPanel>
                            <TextBlock Text="CUSTOMER CREDIT" Style="{StaticResource MetricLabel}" />
                            <TextBlock Text="{Binding CreditText}" Style="{StaticResource MetricValue}" />
                    </StackPanel>
                    </Button>
                </Border>
            </UniformGrid>

            <UniformGrid Columns="4">
                <Border Style="{StaticResource Card}" Margin="0,0,6,0">
                    <Button Command="{Binding OpenProductsCommand}" Background="Transparent" BorderThickness="0" Padding="0"
                            HorizontalContentAlignment="Stretch" ToolTip="Open all active products">
                        <StackPanel>
                            <TextBlock Text="PRODUCTS" Style="{StaticResource MetricLabel}" />
                            <TextBlock Text="{Binding ProductsText}" Style="{StaticResource MetricValue}" />
                    </StackPanel>
                    </Button>
                </Border>
                <Border Style="{StaticResource Card}" Margin="6,0,6,0">
                    <Button Command="{Binding OpenLowStockCommand}" Background="Transparent" BorderThickness="0" Padding="0"
                            HorizontalContentAlignment="Stretch" ToolTip="Open the low-stock product list">
                        <StackPanel>
                            <TextBlock Text="LOW STOCK" Style="{StaticResource MetricLabel}" />
                            <TextBlock Text="{Binding LowStockText}" Style="{StaticResource MetricValue}"
                                   Foreground="{StaticResource WarningBrush}" />
                    </StackPanel>
                    </Button>
                </Border>
                <Border Style="{StaticResource Card}" Margin="6,0,6,0">
                    <Button Command="{Binding OpenStockMinusCommand}" Background="Transparent" BorderThickness="0" Padding="0"
                            HorizontalContentAlignment="Stretch" ToolTip="Open the stock-minus review">
                        <StackPanel>
                            <TextBlock Text="STOCK MINUS" Style="{StaticResource MetricLabel}" />
                            <TextBlock Text="{Binding NegativeText}" Style="{StaticResource MetricValue}"
                                   Foreground="{StaticResource DangerBrush}" />
                    </StackPanel>
                    </Button>
                </Border>
                <Border Style="{StaticResource Card}" Margin="6,0,0,0">
                    <Button Command="{Binding OpenExpiryCommand}" Background="Transparent" BorderThickness="0" Padding="0"
                            HorizontalContentAlignment="Stretch" ToolTip="Open expiry alerts">
                        <StackPanel>
                        <TextBlock Text="NEAR EXPIRY / EXPIRED" Style="{StaticResource MetricLabel}" />
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding ExpiringText}" Style="{StaticResource MetricValue}"
                                       Foreground="{StaticResource WarningBrush}" />
                            <TextBlock Text=" / " Style="{StaticResource MetricValue}"
                                       Foreground="{StaticResource MutedBrush}" />
                            <TextBlock Text="{Binding ExpiryText}" Style="{StaticResource MetricValue}"
                                       Foreground="{StaticResource DangerBrush}" />
                        </StackPanel>
                        <TextBlock Text="inside the nearest band / already past the date"
                                   Style="{StaticResource FieldHint}" TextWrapping="Wrap" />
                    </StackPanel>
                    </Button>
                </Border>
            </UniformGrid>

            <Border Style="{StaticResource Card}" Margin="0,14,0,0">
                <StackPanel>
                    <TextBlock Text="Cash drawer" Style="{StaticResource SectionTitle}" />
                    <TextBlock Text="{Binding ShiftText}" Style="{StaticResource PageSubtitle}" />
                    <Button Command="{Binding OpenPayableCommand}" Background="Transparent" BorderThickness="0" Padding="0"
                            HorizontalContentAlignment="Left" Margin="0,6,0,0" ToolTip="Open supplier payables">
                        <TextBlock Text="{Binding PayableText, StringFormat=Supplier payable: {0}}"
                                   Style="{StaticResource PageSubtitle}" />
                    </Button>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
