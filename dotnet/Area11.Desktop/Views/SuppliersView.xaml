<UserControl x:Class="Area11.Desktop.Views.SuppliersView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:Area11.Desktop.Views">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" Margin="0,0,0,10">
            <StackPanel DockPanel.Dock="Left" VerticalAlignment="Center">
                <TextBlock Text="Suppliers" Style="{StaticResource PageTitle}" />
                <TextBlock Text="What the shop owes, what was paid, and the goods that went back (SR)."
                           Style="{StaticResource PageSubtitle}" />
            </StackPanel>

            <Button DockPanel.Dock="Right" HorizontalAlignment="Right" VerticalAlignment="Center"
                    Content="Refresh" Style="{StaticResource GhostButton}" Command="{Binding RefreshCommand}" />
        </DockPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="300" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="360" />
            </Grid.ColumnDefinitions>

            <!-- =============================== supplier list =============================== -->
            <Border Grid.Column="0" Style="{StaticResource Card}" Padding="12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <TextBox Grid.Row="0" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                             ToolTip="Name, agency or phone" />

                    <DockPanel Grid.Row="1" Margin="0,8,0,8">
                        <CheckBox Content="Only with money to pay" IsChecked="{Binding OnlyOwing, Mode=TwoWay}"
                                  VerticalAlignment="Center" />
                    </DockPanel>

                    <ListBox Grid.Row="2" ItemsSource="{Binding Suppliers}"
                             SelectedItem="{Binding Selected, Mode=TwoWay}">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="0,4">
                                    <DockPanel>
                                        <TextBlock DockPanel.Dock="Right" Text="{Binding PayableText}"
                                                   FontWeight="SemiBold" Margin="6,0,0,0" />
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold"
                                                   TextTrimming="CharacterEllipsis" />
                                    </DockPanel>
                                    <TextBlock Text="{Binding AgencyLabel}" FontSize="11"
                                               Foreground="{StaticResource MutedBrush}"
                                               TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>

            <!-- ================================ one supplier ================================ -->
            <Grid Grid.Column="2">
                <Grid Visibility="{Binding HasSupplier, Converter={StaticResource BoolToVis}}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Style="{StaticResource Card}" Padding="14" Margin="0,0,0,10">
                      <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="{Binding NameText}" Style="{StaticResource SectionTitle}" FontSize="16" />
                                <DockPanel Margin="0,2,0,0">
                                    <TextBlock Text="{Binding AgencyText}" Style="{StaticResource FieldHint}"
                                               Margin="0,0,10,0" />
                                    <TextBlock Text="{Binding PhoneText}" Style="{StaticResource FieldHint}" />
                                </DockPanel>
                                <TextBlock Text="{Binding ActivityText}" Style="{StaticResource FieldHint}" />
                                <TextBlock Text="{Binding LastPurchaseText}" Style="{StaticResource FieldHint}" />
                            </StackPanel>

                            <StackPanel Grid.Column="1" HorizontalAlignment="Right">
                                <TextBlock Text="{Binding PayableText}" Style="{StaticResource MetricValue}"
                                           HorizontalAlignment="Right" />
                                <TextBlock Text="{Binding PayableLabel}" Style="{StaticResource MetricLabel}"
                                           HorizontalAlignment="Right" />
                            </StackPanel>
                        </Grid>

                        <!-- the owner's own questions (F-42): shown only when he has made any -->
                        <views:CustomFieldsEditorView DataContext="{Binding Editor}" />
                      </StackPanel>
                    </Border>

                    <Border Grid.Row="1" Style="{StaticResource Card}" Padding="14">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <DockPanel Grid.Row="0" Margin="0,0,0,6">
                                <TextBlock DockPanel.Dock="Left" Text="The account" Style="{StaticResource SectionTitle}" />
                                <TextBlock DockPanel.Dock="Right" HorizontalAlignment="Right" TextWrapping="Wrap"
                                           Text="{Binding BooksLabel}" MaxWidth="360" TextAlignment="Right">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="FontSize" Value="11" />
                                            <Setter Property="Foreground" Value="{StaticResource SuccessBrush}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding BooksMismatch}" Value="True">
                                                    <Setter Property="Foreground" Value="{StaticResource DangerBrush}" />
                                                    <Setter Property="FontWeight" Value="SemiBold" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </DockPanel>

                            <DataGrid Grid.Row="1" ItemsSource="{Binding Movements}" IsReadOnly="True">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Date" Binding="{Binding DateLabel, Mode=OneWay}" Width="110" />
                                    <DataGridTextColumn Header="What" Binding="{Binding KindLabel, Mode=OneWay}" Width="120" />
                                    <DataGridTextColumn Header="No." Binding="{Binding Code}" Width="90" />
                                    <DataGridTextColumn Header="Detail" Binding="{Binding Description}" Width="*" />
                                    <DataGridTextColumn Header="Owed" Binding="{Binding DebitLabel, Mode=OneWay}" Width="80" />
                                    <DataGridTextColumn Header="Paid" Binding="{Binding CreditLabel, Mode=OneWay}" Width="80" />
                                    <DataGridTextColumn Header="Balance" Binding="{Binding RunningLabel, Mode=OneWay}" Width="90" />
                                </DataGrid.Columns>
                            </DataGrid>

                            <UniformGrid Grid.Row="2" Columns="3" Margin="0,8,0,0">
                                <StackPanel>
                                    <TextBlock Text="Purchases" Style="{StaticResource MetricLabel}" />
                                    <TextBlock Text="{Binding PurchasesText}" Style="{StaticResource MetricValue}" FontSize="14" />
                                </StackPanel>
                                <StackPanel>
                                    <TextBlock Text="Paid" Style="{StaticResource MetricLabel}" />
                                    <TextBlock Text="{Binding PaidText}" Style="{StaticResource MetricValue}" FontSize="14" />
                                </StackPanel>
                                <StackPanel>
                                    <TextBlock Text="Credit notes" Style="{StaticResource MetricLabel}" />
                                    <TextBlock Text="{Binding CreditedText}" Style="{StaticResource MetricValue}" FontSize="14" />
                                </StackPanel>
                            </UniformGrid>
                        </Grid>
                    </Border>

                    <StackPanel Grid.Row="2" Margin="0,10,0,0">
                        <Border Style="{StaticResource Card}" Padding="14"
                                Visibility="{Binding CanWork, Converter={StaticResource BoolToVis}}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="10" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="10" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="10" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Money paid" Style="{StaticResource FieldLabel}" />
                                    <TextBox Text="{Binding AmountText, UpdateSourceTrigger=PropertyChanged}"
                                             ToolTip="Rupees, for example 5000. More than the payable is refused." />
                                </StackPanel>

                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="How" Style="{StaticResource FieldLabel}" />
                                    <ComboBox ItemsSource="{Binding Methods}" SelectedItem="{Binding Method, Mode=TwoWay}" />
                                </StackPanel>

                                <StackPanel Grid.Column="4">
                                    <TextBlock Text="Note (optional)" Style="{StaticResource FieldLabel}" />
                                    <TextBox Text="{Binding PayNote, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>

                                <StackPanel Grid.Column="6" VerticalAlignment="Bottom" Orientation="Horizontal">
                                    <Button Content="Pay" Style="{StaticResource PrimaryButton}"
                                            Command="{Binding PayCommand}" Margin="0,0,6,0" />
                                    <Button Content="Statement" Style="{StaticResource GhostButton}"
                                            Command="{Binding StatementCommand}" Margin="0,0,6,0" />
                                    <Button Content="Photos…" Style="{StaticResource GhostButton}"
                                            Command="{Binding PhotosCommand}"
                                            ToolTip="The supplier's papers - licence, visiting card. A copy is kept in the shop's folder." />
                                </StackPanel>
                            </Grid>
                        </Border>

                        <Border Background="{StaticResource WarningSoftBrush}" CornerRadius="8" Padding="12"
                                Visibility="{Binding IsNotAllowed, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="Only the owner or a manager can pay a supplier or send goods back."
                                       FontSize="11.5" TextWrapping="Wrap" Foreground="{StaticResource WarningBrush}" />
                        </Border>
                    </StackPanel>
                </Grid>

                <Border Padding="24" VerticalAlignment="Center">
                    <Border.Style>
                        <Style TargetType="Border" BasedOn="{StaticResource Card}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasSupplier}" Value="True">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <TextBlock Text="Pick a supplier on the left to see the account."
                               TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" />
                </Border>
            </Grid>

            <!-- ============================== send goods back ============================== -->
            <ScrollViewer Grid.Column="4" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <Border Style="{StaticResource Card}" Padding="14" Margin="0,0,0,10">
                        <StackPanel>
                            <TextBlock Text="Return goods (SR)" Style="{StaticResource SectionTitle}" />
                            <TextBlock Text="The stock leaves the batch and the credit note lowers what you owe. Cash from the supplier is taken instead, not as well."
                                       Style="{StaticResource FieldHint}" />

                            <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                <TextBox Width="200" Text="{Binding ProductSearch, UpdateSourceTrigger=PropertyChanged}"
                                         ToolTip="Medicine name" />
                                <Button Content="Search" Style="{StaticResource GhostButton}" Margin="6,0,0,0"
                                        Command="{Binding ProductSearchCommand}" />
                            </StackPanel>

                            <ListBox ItemsSource="{Binding Found}" Height="80" Margin="0,6,0,0"
                                     DisplayMemberPath="Name"
                                     SelectedItem="{Binding SelectedProduct, Mode=TwoWay}" />

                            <TextBlock Text="{Binding BatchHint}" Style="{StaticResource FieldHint}" />
                            <ComboBox ItemsSource="{Binding Batches}" SelectedItem="{Binding SelectedBatch, Mode=TwoWay}"
                                      DisplayMemberPath="PickLabel" />

                            <Grid Margin="0,4,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="8" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Quantity" Style="{StaticResource FieldLabel}" />
                                    <TextBox Text="{Binding QtyText, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>

                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Unit" Style="{StaticResource FieldLabel}" />
                                    <ComboBox ItemsSource="{Binding Units}" SelectedItem="{Binding Unit, Mode=TwoWay}" />
                                </StackPanel>
                            </Grid>

                            <Button Content="Add this batch to the tray" Style="{StaticResource GhostButton}"
                                    Margin="0,8,0,0" Command="{Binding AddLineCommand}" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}" Padding="14" Margin="0,0,0,10">
                        <StackPanel>
                            <TextBlock Text="Expired on the shelf (one click)" Style="{StaticResource SectionTitle}" />
                            <ListBox ItemsSource="{Binding Expired}" Height="90" Margin="0,4,0,0"
                                     DisplayMemberPath="Caption"
                                     SelectedItem="{Binding SelectedExpired, Mode=TwoWay}" />
                            <Button Content="Put the selected expired batch in the tray" Style="{StaticResource GhostButton}"
                                    Margin="0,6,0,0" Command="{Binding AddExpiredCommand}" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}" Padding="14">
                        <StackPanel>
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Left" Text="The tray" Style="{StaticResource SectionTitle}" />
                                <TextBlock DockPanel.Dock="Right" Text="{Binding TrayTotalText}"
                                           HorizontalAlignment="Right" FontWeight="SemiBold" />
                            </DockPanel>

                            <DataGrid ItemsSource="{Binding Tray}" Height="110" Margin="0,4,0,0" IsReadOnly="True"
                                      SelectedItem="{Binding SelectedTrayRow, Mode=TwoWay}">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Batch" Binding="{Binding Caption, Mode=OneWay}" Width="*" />
                                    <DataGridTextColumn Header="Qty" Binding="{Binding QtyLabel, Mode=OneWay}" Width="70" />
                                    <DataGridTextColumn Header="Value" Binding="{Binding ValueLabel, Mode=OneWay}" Width="85" />
                                </DataGrid.Columns>
                            </DataGrid>

                            <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                <Button Content="Remove line" Style="{StaticResource GhostButton}"
                                        Command="{Binding RemoveLineCommand}" Margin="0,0,6,0" />
                                <Button Content="Clear" Style="{StaticResource GhostButton}"
                                        Command="{Binding ClearTrayCommand}" />
                            </StackPanel>

                            <TextBlock Text="Reason" Style="{StaticResource FieldLabel}" />
                            <ComboBox ItemsSource="{Binding Reasons}" SelectedItem="{Binding Reason, Mode=TwoWay}" />

                            <TextBlock Text="Note (optional)" Style="{StaticResource FieldLabel}" />
                            <TextBox Text="{Binding SrNote, UpdateSourceTrigger=PropertyChanged}" />

                            <CheckBox Content="The supplier gave the money in cash"
                                      IsChecked="{Binding CashReceived, Mode=TwoWay}" Margin="0,8,0,0" />

                            <Button Content="Save the return (SR)" Style="{StaticResource PrimaryButton}"
                                    Margin="0,10,0,0" Command="{Binding PostReturnCommand}" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <Border Grid.Row="2" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource LineBrush}"
                BorderThickness="1" CornerRadius="8" Padding="12,8" Margin="0,10,0,0">
            <TextBlock Text="{Binding StatusText}" TextWrapping="Wrap">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="FontSize" Value="12" />
                        <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsStatusError}" Value="True">
                                <Setter Property="Foreground" Value="{StaticResource DangerBrush}" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
        </Border>
    </Grid>
</UserControl>
