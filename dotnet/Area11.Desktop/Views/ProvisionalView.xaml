<UserControl x:Class="Area11.Desktop.Views.ProvisionalView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" Margin="0,0,0,10">
            <StackPanel DockPanel.Dock="Left" VerticalAlignment="Center">
                <TextBlock Text="No bill (rush return)" Style="{StaticResource PageTitle}" />
                <TextBlock Text="The customer has no paper bill. Refund now, put the goods on the shelf, keep the PR number - the bill comes later."
                           Style="{StaticResource PageSubtitle}" />
            </StackPanel>

            <Button DockPanel.Dock="Right" HorizontalAlignment="Right" VerticalAlignment="Center"
                    Content="Refresh" Style="{StaticResource GhostButton}" Command="{Binding RefreshCommand}" />
        </DockPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.25*" />
                <ColumnDefinition Width="14" />
                <ColumnDefinition Width="1*" />
            </Grid.ColumnDefinitions>

            <!-- ============================= the counter ============================= -->
            <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto">
                <Border Style="{StaticResource Card}" Padding="14" VerticalAlignment="Top">
                    <StackPanel>
                        <TextBlock Text="1. What came back" Style="{StaticResource SectionTitle}" />

                        <DockPanel Margin="0,4,0,0">
                            <Button DockPanel.Dock="Right" Content="Search" Style="{StaticResource GhostButton}"
                                    Margin="6,0,0,0" Command="{Binding SearchCommand}" />
                            <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                     ToolTip="Medicine name, for example Panadol" />
                        </DockPanel>

                        <ListBox ItemsSource="{Binding Results}" Height="110" Margin="0,6,0,0"
                                 SelectedItem="{Binding SelectedProduct, Mode=TwoWay}">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding Name}" Width="210" />
                                        <TextBlock Text="{Binding StockLabel}" Width="110" Foreground="{StaticResource MutedBrush}" />
                                        <TextBlock Text="{Binding PackLabel}" Foreground="{StaticResource MutedBrush}" />
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <Grid Margin="0,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="90" />
                                <ColumnDefinition Width="8" />
                                <ColumnDefinition Width="120" />
                                <ColumnDefinition Width="8" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <TextBox Grid.Column="0" Text="{Binding QtyText, UpdateSourceTrigger=PropertyChanged}"
                                     ToolTip="How many came back" />
                            <ComboBox Grid.Column="2" ItemsSource="{Binding Units}"
                                      SelectedItem="{Binding Unit, Mode=TwoWay}" />
                            <Button Grid.Column="4" Content="Add this item" Style="{StaticResource PrimaryButton}"
                                    Command="{Binding AddCommand}" />
                        </Grid>

                        <TextBlock Text="2. Items on the counter" Style="{StaticResource SectionTitle}" Margin="0,12,0,0" />

                        <DataGrid ItemsSource="{Binding Lines}" Height="120" Margin="0,4,0,0"
                                  SelectedItem="{Binding SelectedLine, Mode=TwoWay}">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Medicine" Binding="{Binding Name}" Width="*" />
                                <DataGridTextColumn Header="How many" Binding="{Binding Quantity}" Width="90" />
                                <DataGridTextColumn Header="Unit" Binding="{Binding Unit}" Width="70" />
                            </DataGrid.Columns>
                        </DataGrid>

                        <Button Content="Remove the selected line" Style="{StaticResource GhostButton}"
                                HorizontalAlignment="Left" Margin="0,6,0,0" Command="{Binding RemoveCommand}" />

                        <TextBlock Text="3. Money and customer" Style="{StaticResource SectionTitle}" Margin="0,12,0,0" />

                        <Grid Margin="0,2,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Customer name" Style="{StaticResource FieldLabel}" />
                                <TextBox Text="{Binding CustomerName, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>

                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Phone" Style="{StaticResource FieldLabel}" />
                                <TextBox Text="{Binding Phone, UpdateSourceTrigger=PropertyChanged}"
                                         ToolTip="The phone is how the bill is found later" />
                            </StackPanel>
                        </Grid>

                        <Grid Margin="0,4,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Money paid back (Rs)" Style="{StaticResource FieldLabel}" />
                                <TextBox Text="{Binding RefundText, UpdateSourceTrigger=PropertyChanged}"
                                         ToolTip="What you actually handed to the customer" />
                            </StackPanel>

                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Reason" Style="{StaticResource FieldLabel}" />
                                <ComboBox ItemsSource="{Binding Reasons}" SelectedItem="{Binding Reason, Mode=TwoWay}" />
                            </StackPanel>
                        </Grid>

                        <TextBlock Text="Note (optional)" Style="{StaticResource FieldLabel}" />
                        <TextBox Text="{Binding Notes, UpdateSourceTrigger=PropertyChanged}" />

                        <Button Content="Save and give the slip" Style="{StaticResource PrimaryButton}"
                                Margin="0,12,0,0" Command="{Binding SaveCommand}" />

                        <Border Background="{StaticResource WarningSoftBrush}" CornerRadius="8" Padding="10" Margin="0,10,0,0">
                            <TextBlock TextWrapping="Wrap" FontSize="11.5" Foreground="{StaticResource WarningBrush}"
                                       Text="With no bill there is nothing to check the refund against. That is why the PR number is permanent and the red badge does not stop until the bill is attached." />
                        </Border>
                    </StackPanel>
                </Border>
            </ScrollViewer>

            <!-- ============================= the paper trail ============================= -->
            <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <Border Style="{StaticResource Card}" Padding="14" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="Waiting for a bill" Style="{StaticResource SectionTitle}" />
                            <TextBlock Text="{Binding PendingCaption}" Style="{StaticResource FieldHint}"
                                       Foreground="{StaticResource DangerBrush}" FontWeight="SemiBold" />

                            <DataGrid ItemsSource="{Binding Pending}" Height="130" Margin="0,6,0,0"
                                      SelectedItem="{Binding SelectedEntry, Mode=TwoWay}">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="No." Binding="{Binding Code}" Width="90" />
                                    <DataGridTextColumn Header="Customer" Binding="{Binding CustomerLabel}" Width="*" />
                                    <DataGridTextColumn Header="Refund" Binding="{Binding RefundText}" Width="90" />
                                </DataGrid.Columns>
                            </DataGrid>

                            <TextBlock Text="{Binding SelectedCaption}" Style="{StaticResource FieldHint}" />

                            <Button Content="Print this slip" Style="{StaticResource GhostButton}"
                                    HorizontalAlignment="Left" Margin="0,6,0,0" Command="{Binding ReprintCommand}" />

                            <StackPanel Visibility="{Binding IsOwnerOrManager, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="Attach the real bill" Style="{StaticResource SectionTitle}" Margin="0,12,0,0" />

                                <DockPanel>
                                    <Button DockPanel.Dock="Right" Content="Attach this bill" Style="{StaticResource PrimaryButton}"
                                            Margin="6,0,0,0" Padding="10,6" Command="{Binding LinkCommand}" />
                                    <TextBox Text="{Binding BillCode, UpdateSourceTrigger=PropertyChanged}"
                                             ToolTip="For example INV-0001" />
                                </DockPanel>

                                <TextBlock Text="Do not remember the bill? Search by phone, name, medicine or date."
                                           Style="{StaticResource FieldHint}" />

                                <DockPanel>
                                    <Button DockPanel.Dock="Right" Content="Find bills" Style="{StaticResource GhostButton}"
                                            Margin="6,0,0,0" Command="{Binding LookupCommand}" />
                                    <TextBox Text="{Binding LookupText, UpdateSourceTrigger=PropertyChanged}" />
                                </DockPanel>

                                <DataGrid ItemsSource="{Binding Lookup}" Height="110" Margin="0,6,0,0"
                                          SelectedItem="{Binding SelectedLookup, Mode=TwoWay}">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Bill" Binding="{Binding Code}" Width="90" />
                                        <DataGridTextColumn Header="Date" Binding="{Binding DateLabel}" Width="115" />
                                        <DataGridTextColumn Header="Total" Binding="{Binding TotalText}" Width="85" />
                                        <DataGridTextColumn Header="Items" Binding="{Binding ItemsLabel}" Width="*" />
                                    </DataGrid.Columns>
                                </DataGrid>

                                <Button Content="Use the selected bill" Style="{StaticResource GhostButton}"
                                        HorizontalAlignment="Left" Margin="0,6,0,0" Command="{Binding PickBillCommand}" />

                                <TextBlock Text="Cancel the entry (reason compulsory)" Style="{StaticResource SectionTitle}"
                                           Margin="0,12,0,0" />
                                <TextBox Text="{Binding CancelReason, UpdateSourceTrigger=PropertyChanged}"
                                         ToolTip="For example: typed twice by mistake" />
                                <Button Content="Cancel this entry and take the stock back" Style="{StaticResource GhostButton}"
                                        HorizontalAlignment="Left" Margin="0,6,0,0" Command="{Binding CancelCommand}" />
                            </StackPanel>

                            <Border Background="{StaticResource WarningSoftBrush}" CornerRadius="8" Padding="10" Margin="0,8,0,0"
                                    Visibility="{Binding IsNotOwnerOrManager, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="Only the owner or a manager can attach the bill or cancel an entry."
                                           FontSize="11.5" TextWrapping="Wrap" Foreground="{StaticResource WarningBrush}" />
                            </Border>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}" Padding="14">
                        <StackPanel>
                            <TextBlock Text="Closed entries" Style="{StaticResource SectionTitle}" />
                            <TextBlock Text="Linked or cancelled - kept for good." Style="{StaticResource FieldHint}" />

                            <DataGrid ItemsSource="{Binding History}" Height="150" Margin="0,6,0,0"
                                      SelectedItem="{Binding SelectedEntry, Mode=TwoWay}">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="No." Binding="{Binding Code}" Width="85" />
                                    <DataGridTextColumn Header="Refund" Binding="{Binding RefundText}" Width="85" />
                                    <DataGridTextColumn Header="State" Binding="{Binding StatusLabel}" Width="*" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <Border Grid.Row="2" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource LineBrush}"
                BorderThickness="1" CornerRadius="8" Padding="12,8" Margin="0,10,0,0">
            <TextBlock Text="{Binding StatusText}" TextWrapping="Wrap">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="FontSize" Value="12" />
                        <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsStatusError}" Value="True">
                                <Setter Property="Foreground" Value="{StaticResource DangerBrush}" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
        </Border>
    </Grid>
</UserControl>
