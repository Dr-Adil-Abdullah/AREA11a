<UserControl x:Class="Area11.Desktop.Views.CustomersView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:Area11.Desktop.Views">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" Margin="0,0,0,10">
            <StackPanel DockPanel.Dock="Left" VerticalAlignment="Center">
                <TextBlock Text="Customers (khata)" Style="{StaticResource PageTitle}" />
                <TextBlock Text="Who owes what, what they bought, and the money you receive at the counter."
                           Style="{StaticResource PageSubtitle}" />
            </StackPanel>

            <Button DockPanel.Dock="Right" HorizontalAlignment="Right" VerticalAlignment="Center"
                    Content="Refresh" Style="{StaticResource GhostButton}" Command="{Binding RefreshCommand}" />
        </DockPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="330" />
                <ColumnDefinition Width="14" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- ============================== the customer list ============================== -->
            <Border Grid.Column="0" Style="{StaticResource Card}" Padding="12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <TextBox Grid.Row="0" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                             ToolTip="Name or phone. Leave empty and press Refresh for everybody." />

                    <DockPanel Grid.Row="1" Margin="0,8,0,8">
                        <!-- The form the owner asked for (D-50): adding a customer needed one button
                             and one card, and every rule stays in PartnerService. -->
                        <Button DockPanel.Dock="Right" Content="+ New" FontSize="11" Padding="9,4"
                                Style="{StaticResource PrimaryButton}"
                                Command="{Binding AddNewCommand}"
                                IsEnabled="{Binding CanOpenAddForm}"
                                ToolTip="Add a customer who is not in the book yet" />
                        <CheckBox Content="Only with udhaar" IsChecked="{Binding OnlyCredit, Mode=TwoWay}"
                                  VerticalAlignment="Center" />
                    </DockPanel>

                    <ListBox Grid.Row="2" ItemsSource="{Binding Customers}"
                             SelectedItem="{Binding Selected, Mode=TwoWay}">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="0,4">
                                    <DockPanel>
                                        <TextBlock DockPanel.Dock="Right" Text="{Binding BalanceText}"
                                                   FontWeight="SemiBold" Margin="6,0,0,0" />
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold"
                                                   TextTrimming="CharacterEllipsis" />
                                    </DockPanel>
                                    <DockPanel>
                                        <TextBlock DockPanel.Dock="Right" Text="{Binding CategoryLabel}"
                                                   FontSize="10.5" Foreground="{StaticResource MutedBrush}" />
                                        <TextBlock Text="{Binding CreditStateLabel}" FontSize="11"
                                                   Foreground="{StaticResource MutedBrush}"
                                                   TextTrimming="CharacterEllipsis" />
                                    </DockPanel>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>

            <!-- ================================ one customer ================================ -->
            <Grid Grid.Column="2">
                <Grid Visibility="{Binding IsViewing, Converter={StaticResource BoolToVis}}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- head: name, balance, stars, and the owner's own questions (F-42) -->
                    <Border Grid.Row="0" Style="{StaticResource Card}" Padding="14" Margin="0,0,0,12">
                      <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="{Binding NameText}" Style="{StaticResource SectionTitle}" FontSize="16" />
                                <TextBlock Text="{Binding PhoneText}" Style="{StaticResource FieldHint}" />
                                <DockPanel Margin="0,4,0,0">
                                    <TextBlock Text="{Binding CategoryText}" FontSize="11" Margin="0,0,10,0" />
                                    <TextBlock Text="{Binding StarsText}" FontSize="11" Margin="0,0,10,0"
                                               Foreground="{StaticResource WarningBrush}" />
                                    <TextBlock Text="{Binding PointsText}" FontSize="11"
                                               Foreground="{StaticResource MutedBrush}" />
                                </DockPanel>
                            </StackPanel>

                            <StackPanel Grid.Column="1" HorizontalAlignment="Right">
                                <TextBlock Text="{Binding BalanceText}" Style="{StaticResource MetricValue}"
                                           HorizontalAlignment="Right" />
                                <TextBlock Text="udhaar" Style="{StaticResource MetricLabel}" HorizontalAlignment="Right" />
                                <TextBlock Text="{Binding LimitText}" Style="{StaticResource FieldHint}"
                                           HorizontalAlignment="Right" />
                                <Button Content="Edit" Style="{StaticResource GhostButton}" Margin="0,6,0,0"
                                        HorizontalAlignment="Right" Command="{Binding EditCommand}" />
                                <Button Content="Photos…" Style="{StaticResource GhostButton}" Margin="0,4,0,0"
                                        HorizontalAlignment="Right" Command="{Binding PhotosCommand}"
                                        ToolTip="The customer's picture - a copy is kept in the shop's folder." />
                            </StackPanel>
                        </Grid>

                        <views:CustomFieldsEditorView DataContext="{Binding Editor}" />
                      </StackPanel>
                    </Border>

                    <!-- the book -->
                    <Border Grid.Row="1" Style="{StaticResource Card}" Padding="14">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <DockPanel Grid.Row="0" Margin="0,0,0,6">
                                <TextBlock DockPanel.Dock="Left" Text="The khata book" Style="{StaticResource SectionTitle}" />
                                <TextBlock DockPanel.Dock="Right" HorizontalAlignment="Right" TextWrapping="Wrap"
                                           Text="{Binding BooksLabel}" MaxWidth="480" TextAlignment="Right">
                                    <!-- the colour is the message: green = the khata is explained, red = it is not -->
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="FontSize" Value="11" />
                                            <Setter Property="Foreground" Value="{StaticResource SuccessBrush}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding BooksMismatch}" Value="True">
                                                    <Setter Property="Foreground" Value="{StaticResource DangerBrush}" />
                                                    <Setter Property="FontWeight" Value="SemiBold" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </DockPanel>

                            <DataGrid Grid.Row="1" ItemsSource="{Binding Lines}" IsReadOnly="True">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Date" Binding="{Binding DateLabel}" Width="115" />
                                    <DataGridTextColumn Header="What" Binding="{Binding KindLabel}" Width="105" />
                                    <DataGridTextColumn Header="No." Binding="{Binding Code}" Width="95" />
                                    <DataGridTextColumn Header="Detail" Binding="{Binding Description}" Width="*" />
                                    <DataGridTextColumn Header="Udhaar" Binding="{Binding DebitLabel}" Width="85" />
                                    <DataGridTextColumn Header="Paid" Binding="{Binding CreditLabel}" Width="85" />
                                    <DataGridTextColumn Header="Balance" Binding="{Binding RunningLabel}" Width="95" />
                                </DataGrid.Columns>
                            </DataGrid>

                            <!-- the four numbers the owner asks for -->
                            <UniformGrid Grid.Row="2" Columns="4" Margin="0,8,0,0">
                                <StackPanel>
                                    <TextBlock Text="Bills" Style="{StaticResource MetricLabel}" />
                                    <TextBlock Text="{Binding BillsText}" Style="{StaticResource MetricValue}" FontSize="14" />
                                </StackPanel>
                                <StackPanel>
                                    <TextBlock Text="Lifetime" Style="{StaticResource MetricLabel}" />
                                    <TextBlock Text="{Binding LifetimeText}" Style="{StaticResource MetricValue}" FontSize="14" />
                                </StackPanel>
                                <StackPanel>
                                    <TextBlock Text="Profit" Style="{StaticResource MetricLabel}" />
                                    <TextBlock Text="{Binding ProfitText}" Style="{StaticResource MetricValue}" FontSize="14" />
                                </StackPanel>
                                <StackPanel>
                                    <TextBlock Text="Returns" Style="{StaticResource MetricLabel}" />
                                    <TextBlock Text="{Binding ReturnsText}" Style="{StaticResource MetricValue}" FontSize="14" />
                                </StackPanel>
                            </UniformGrid>
                        </Grid>
                    </Border>

                    <!-- receive money -->
                    <StackPanel Grid.Row="2" Margin="0,12,0,0">
                        <Border Style="{StaticResource Card}" Padding="14" Visibility="{Binding CanCollect, Converter={StaticResource BoolToVis}}">
                            <StackPanel><Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="10" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="10" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="10" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Money received" Style="{StaticResource FieldLabel}" />
                                    <TextBox Text="{Binding AmountText, UpdateSourceTrigger=PropertyChanged}"
                                             ToolTip="Rupees, for example 500. More than the udhaar is refused." />
                                </StackPanel>

                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="How" Style="{StaticResource FieldLabel}" />
                                    <ComboBox ItemsSource="{Binding Methods}" SelectedItem="{Binding Method, Mode=TwoWay}" />
                                </StackPanel>

                                <StackPanel Grid.Column="4">
                                    <TextBlock Text="Note (optional)" Style="{StaticResource FieldLabel}" />
                                    <TextBox Text="{Binding Note, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>

                                <StackPanel Grid.Column="6" VerticalAlignment="Bottom" Orientation="Horizontal">
                                    <Button Content="Receive" Style="{StaticResource PrimaryButton}"
                                            Command="{Binding CollectCommand}" Margin="0,0,6,0" />
                                    <Button Content="Statement" Style="{StaticResource GhostButton}"
                                            Command="{Binding StatementCommand}" />
                                </StackPanel>
                            </Grid>
                                <!-- the paper: the month's statement and the slip of the last collection (F-49) -->
                                <Grid Margin="0,10,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Grid.Column="0" Text="Month" Style="{StaticResource FieldLabel}"
                                               VerticalAlignment="Center" Margin="0,0,8,0" />
                                    <TextBox Grid.Column="1" Width="110"
                                             Text="{Binding StatementMonth, UpdateSourceTrigger=PropertyChanged}"
                                             ToolTip="For the monthly statement: 2026-10. Empty prints every movement." />
                                    <Button Grid.Column="2" Content="Month statement" Style="{StaticResource GhostButton}"
                                            Command="{Binding MonthStatementCommand}" Margin="8,0,0,0" />
                                    <Button Grid.Column="4" Content="Receipt (last collection)" Style="{StaticResource GhostButton}"
                                            Command="{Binding ReceiptCommand}" IsEnabled="{Binding CanPrintReceipt}" />
                                </Grid>
                        </StackPanel>
                        </Border>

                        <Border Background="{StaticResource WarningSoftBrush}" CornerRadius="8" Padding="12"
                                Visibility="{Binding IsNotAllowed, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="You can look at the khata, but receiving money needs the Customers permission."
                                       FontSize="11.5" TextWrapping="Wrap" Foreground="{StaticResource WarningBrush}" />
                        </Border>
                    </StackPanel>
                </Grid>

                <!-- nothing picked -->
                <Border Padding="24" VerticalAlignment="Center">
                    <Border.Style>
                        <Style TargetType="Border" BasedOn="{StaticResource Card}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasCustomer}" Value="True">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <TextBlock Text="Pick a customer on the left to see the khata."
                               TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" />
                </Border>

                <!-- correction form (F-11): the book is hidden while this is open -->
                <Border Style="{StaticResource Card}" Padding="18"
                        VerticalAlignment="Top"
                        Visibility="{Binding IsEditing, Converter={StaticResource BoolToVis}}">
                    <StackPanel>
                        <TextBlock Text="Edit customer" Style="{StaticResource SectionTitle}" />
                        <TextBlock Text="The udhaar itself is history and cannot be typed over — only these details change."
                                   Style="{StaticResource FieldHint}" />

                        <TextBlock Text="Name" Style="{StaticResource FieldLabel}" Margin="0,12,0,0" />
                        <TextBox Text="{Binding EditName, UpdateSourceTrigger=PropertyChanged}" />

                        <TextBlock Text="Phone" Style="{StaticResource FieldLabel}" Margin="0,10,0,0" />
                        <TextBox Text="{Binding EditPhone, UpdateSourceTrigger=PropertyChanged}" Width="240"
                                 HorizontalAlignment="Left" />
                        <TextBlock Text="The number the cashier types at the counter to find this customer."
                                   Style="{StaticResource FieldHint}" />

                        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                            <StackPanel Width="200">
                                <TextBlock Text="Category" Style="{StaticResource FieldLabel}" />
                                <ComboBox ItemsSource="{Binding Categories}"
                                          SelectedItem="{Binding EditCategory, Mode=TwoWay}" />
                            </StackPanel>
                            <StackPanel Width="200" Margin="12,0,0,0">
                                <TextBlock Text="Credit limit (Rs)" Style="{StaticResource FieldLabel}" />
                                <TextBox Text="{Binding EditLimitText, UpdateSourceTrigger=PropertyChanged}"
                                         IsEnabled="{Binding CanEditLimit}" />
                            </StackPanel>
                        </StackPanel>
                        <TextBlock Text="0 = no limit. Only the owner or a manager can change this line."
                                   Style="{StaticResource FieldHint}" />
                        <TextBlock Text="The category picks the rate on the bill: a VIP or Doctor customer pays the rates set on the product."
                                   Style="{StaticResource FieldHint}" />

                        <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                            <Button Content="Save" Style="{StaticResource PrimaryButton}"
                                    Command="{Binding SaveEditCommand}" />
                            <Button Content="Cancel" Style="{StaticResource GhostButton}" Margin="8,0,0,0"
                                    Command="{Binding CancelEditCommand}" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- new customer card (D-50) -->
                <Border Style="{StaticResource Card}" Padding="18"
                        VerticalAlignment="Top"
                        Visibility="{Binding IsAdding, Converter={StaticResource BoolToVis}}">
                    <StackPanel>
                        <TextBlock Text="New customer" Style="{StaticResource SectionTitle}" />
                        <TextBlock Text="The khata starts at zero. Nothing is owed until the first bill on credit."
                                   Style="{StaticResource FieldHint}" />

                        <TextBlock Text="Name" Style="{StaticResource FieldLabel}" Margin="0,12,0,0" />
                        <TextBox Text="{Binding NewName, UpdateSourceTrigger=PropertyChanged}" />

                        <TextBlock Text="Phone (optional)" Style="{StaticResource FieldLabel}" Margin="0,10,0,0" />
                        <TextBox Text="{Binding NewPhone, UpdateSourceTrigger=PropertyChanged}" Width="240"
                                 HorizontalAlignment="Left" />
                        <TextBlock Text="A phone number can belong to only one customer: two rows with the same number split one family's udhaar."
                                   Style="{StaticResource FieldHint}" TextWrapping="Wrap" />

                        <TextBlock Text="Category" Style="{StaticResource FieldLabel}" Margin="0,10,0,0" />
                        <ComboBox ItemsSource="{Binding Categories}" Width="200" HorizontalAlignment="Left"
                                  SelectedItem="{Binding NewCategory, Mode=TwoWay}" />

                        <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                            <Button Content="Add customer" Style="{StaticResource PrimaryButton}"
                                    Command="{Binding SaveNewCommand}" />
                            <Button Content="Cancel" Style="{StaticResource GhostButton}" Margin="8,0,0,0"
                                    Command="{Binding CancelNewCommand}" />
                        </StackPanel>
                    </StackPanel>
                </Border>

            </Grid>
        </Grid>

        <Border Grid.Row="2" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource LineBrush}"
                BorderThickness="1" CornerRadius="8" Padding="12,8" Margin="0,10,0,0">
            <TextBlock Text="{Binding StatusText}" TextWrapping="Wrap">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="FontSize" Value="12" />
                        <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsStatusError}" Value="True">
                                <Setter Property="Foreground" Value="{StaticResource DangerBrush}" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
        </Border>
    </Grid>
</UserControl>
