<UserControl x:Class="Area11.Desktop.Views.PosView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:Area11.Desktop.Views"
             PreviewKeyDown="OnCounterPreviewKeyDown">
    <!-- Trial B: a reserved narrow search pane beside the cart, not over it.
         Trial A remains in v0.74.0 for comparison; the owner has not chosen a final layout. -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <DockPanel Grid.Row="0" Margin="0,0,0,8">
            <StackPanel DockPanel.Dock="Left">
                <TextBlock Text="{DynamicResource AppLabel.counter}" Style="{StaticResource PageTitle}" />
                <TextBlock Text="Search beside the cart · trial B" Style="{StaticResource PageSubtitle}" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <TextBlock Text="{Binding CashierName, StringFormat=Cashier: {0}}"
                           Style="{StaticResource PageSubtitle}" VerticalAlignment="Center" Margin="0,0,12,0" />
                <Button Content="Refresh" Style="{StaticResource GhostButton}" Command="{Binding RefreshCommand}" />
            </StackPanel>
        </DockPanel>
        <Border Grid.Row="1" Style="{StaticResource Card}" Padding="8" Margin="0,0,0,8">
            <Grid>
                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" /><ColumnDefinition Width="100" />
                    <ColumnDefinition Width="80" /><ColumnDefinition Width="116" />
                </Grid.ColumnDefinitions>
                <TextBox x:Name="MedicineSearchBox" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                         ToolTip="Search name, strength, pack, salt or barcode. Enter scans an exact barcode, never a guessed name.">
                    <TextBox.InputBindings><KeyBinding Key="Enter" Command="{Binding ScanCommand}" /></TextBox.InputBindings>
                </TextBox>
                <ComboBox Grid.Column="1" ItemsSource="{Binding Units}" SelectedItem="{Binding Unit, Mode=TwoWay}"
                          Margin="8,0,0,0" ToolTip="Unit to add" />
                <TextBox Grid.Column="2" Text="{Binding Quantity, UpdateSourceTrigger=PropertyChanged}"
                         Margin="8,0,0,0" ToolTip="Quantity to add" />
                <Button Grid.Column="3" Content="Add to cart" Command="{Binding AddCommand}"
                        Style="{StaticResource PrimaryButton}" Margin="8,0,0,0" Click="OnAddToCartClick" />
                <TextBlock Grid.Row="1" Grid.ColumnSpan="3" Text="{Binding SelectedProduct.Name}" FontWeight="SemiBold"
                           FontSize="11" Margin="0,3,0,0" TextTrimming="CharacterEllipsis" />
                <TextBlock Grid.Row="1" Grid.Column="3" Text="{Binding PriceHint}" Style="{StaticResource MetricLabel}"
                           Margin="8,3,0,0" />
            </Grid>
        </Border>
        <Grid x:Name="CounterWorkspace" Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1*" MinWidth="200" MaxWidth="340" />
                <ColumnDefinition Width="8" />
                <ColumnDefinition Width="2.4*" />
            </Grid.ColumnDefinitions>
            <Border x:Name="CartPanel" Grid.Column="2" Style="{StaticResource Card}" Padding="8">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                    <DockPanel Grid.Row="0" Margin="0,0,0,5">
                        <TextBlock Text="Cart" Style="{StaticResource SectionTitle}" VerticalAlignment="Center" />
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Content="Remove" Command="{Binding RemoveCommand}" Style="{StaticResource GhostButton}" Padding="10,4" />
                            <Button Content="Clear" Command="{Binding ClearCommand}" Style="{StaticResource GhostButton}" Padding="10,4" Margin="6,0,0,0" />
                        </StackPanel>
                    </DockPanel>
                    <DataGrid x:Name="CartGrid" Grid.Row="1" ItemsSource="{Binding Cart}"
                              ToolTip="Rate is rupees per this line's unit. Owner/Manager may edit an agreed custom price; an unchanged retail rate still allows the VIP/Doctor Yes/No choice.">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Item" Binding="{Binding Name, Mode=OneWay}" Width="2*" />
                            <DataGridTextColumn Header="Unit" Binding="{Binding UnitLabel, Mode=OneWay}" Width="60" />
                            <DataGridTextColumn Header="Qty" Binding="{Binding QuantityText, Mode=OneWay}" Width="60" />
                            <DataGridTemplateColumn Header="Rate Rs" Width="85">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding RateText, Mode=OneWay}" VerticalAlignment="Center" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                                <DataGridTemplateColumn.CellEditingTemplate>
                                    <DataTemplate>
                                        <TextBox Text="{Binding RateText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                 IsEnabled="{Binding DataContext.CanEditRates, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellEditingTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>
            <Border x:Name="CheckoutDetailsPanel" Grid.Column="2" Width="320" Margin="8,0,0,0"
                    HorizontalAlignment="Right" Panel.ZIndex="10" MaxWidth="{Binding ElementName=CartPanel, Path=ActualWidth}"
                    Style="{StaticResource Card}" Padding="10"
                    Visibility="{Binding ShowCheckoutDetails, Converter={StaticResource BoolToVis}}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <Button Content="Close details" Command="{Binding ToggleCheckoutDetailsCommand}" Style="{StaticResource GhostButton}" />
                        <Border Background="{StaticResource BrandSoftBrush}" CornerRadius="6" Padding="9"
                                Margin="0,6,0,0"
                                Visibility="{Binding IsAddingCustomer, Converter={StaticResource BoolToVis}}">
                            <StackPanel>
                                <TextBlock Text="The cart stays as it is. Only the name on the bill changes."
                                           Style="{StaticResource FieldHint}" TextWrapping="Wrap" />
                                <TextBlock Text="Name" Style="{StaticResource FieldLabel}" Margin="0,6,0,0" />
                                <TextBox Text="{Binding NewCustomerName, UpdateSourceTrigger=PropertyChanged}" />
                                <TextBlock Text="Phone" Style="{StaticResource FieldLabel}" Margin="0,6,0,0" />
                                <TextBox Text="{Binding NewCustomerPhone, UpdateSourceTrigger=PropertyChanged}" />
                                <views:CustomFieldsEditorView DataContext="{Binding NewCustomerEditor}" />
                                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                    <Button Content="Save customer" Style="{StaticResource PrimaryButton}"
                                            Command="{Binding SaveCustomerCommand}" Margin="0,0,8,0" />
                                    <Button Content="Cancel" Style="{StaticResource GhostButton}"
                                            Command="{Binding CancelAddCustomerCommand}" />
                                </StackPanel>
                            </StackPanel>
                        </Border>
                        <TextBlock Text="Doctor (prescription, optional)" Style="{StaticResource FieldLabel}" Margin="0,8,0,0" />
                        <ComboBox ItemsSource="{Binding Doctors}" DisplayMemberPath="Name"
                                  SelectedItem="{Binding SelectedDoctor, Mode=TwoWay}"
                                  ToolTip="Which doctor wrote the prescription. A doctor is a customer with the category Doctor." />
                        <TextBlock Text="{Binding DoctorHint}" Style="{StaticResource FieldHint}"
                                   TextWrapping="Wrap" />

                        <!-- loyalty points, only for a customer who has some (F-40) -->
                        <StackPanel Margin="0,6,0,0"
                                    Visibility="{Binding CanRedeem, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="Points to use (1 point = Rs 1)" Style="{StaticResource FieldLabel}" />
                            <TextBox Text="{Binding RedeemPointsText, UpdateSourceTrigger=PropertyChanged}"
                                     ToolTip="Leave empty to pay the full bill." />
                            <TextBlock Text="{Binding RedeemHint}" Style="{StaticResource FieldHint}"
                                       TextWrapping="Wrap" />
                        </StackPanel>

<Border Background="{StaticResource BrandSoftBrush}" CornerRadius="6" Padding="9"
                                Margin="0,6,0,0"
                                Visibility="{Binding IsSplit, Converter={StaticResource BoolToVis}}">
                            <StackPanel>
                                <TextBlock Text="Split payment - the rest of the bill is cash"
                                           Style="{StaticResource FieldHint}" Margin="0,0,0,6" />

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="8" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="Paid by" Style="{StaticResource FieldLabel}" />
                                        <ComboBox ItemsSource="{Binding SplitMethods}"
                                                  SelectedItem="{Binding SecondMethod, Mode=TwoWay}" />
                                    </StackPanel>

                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="Amount (Rs)" Style="{StaticResource FieldLabel}" />
                                        <TextBox Text="{Binding SecondAmountText, UpdateSourceTrigger=PropertyChanged}" />
                                    </StackPanel>
                                </Grid>

                                <Grid Margin="0,8,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="Cash part" Style="{StaticResource MetricLabel}" />
                                        <TextBlock Text="{Binding CashPartText}" FontSize="13" FontWeight="SemiBold" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="On credit (khata)" Style="{StaticResource MetricLabel}" />
                                        <TextBlock Text="{Binding CreditPartText}" FontSize="13" FontWeight="SemiBold" />
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>
                        <views:CustomFieldsEditorView DataContext="{Binding DocEditor}" />
                    </StackPanel>
                </ScrollViewer>
            </Border>
            <Border Grid.Column="2" Width="320" Margin="8,0,0,0" Style="{StaticResource Card}" Padding="8"
                    HorizontalAlignment="Right" Panel.ZIndex="10" MaxWidth="{Binding ElementName=CartPanel, Path=ActualWidth}"
                    Visibility="{Binding ShowParkedCarts, Converter={StaticResource BoolToVis}}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <Button Content="Close parked carts" Command="{Binding ToggleParkedCartsCommand}" Style="{StaticResource GhostButton}" />
                        <Border BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="8"
                                Padding="10" Margin="0,10,0,0">
                            <StackPanel>
                                <DockPanel>
                                    <TextBlock Text="Parked carts" Style="{StaticResource SectionTitle}"
                                               VerticalAlignment="Center" />
                                    <Button DockPanel.Dock="Right" Content="Refresh" HorizontalAlignment="Right"
                                            Style="{StaticResource GhostButton}" FontSize="11" Padding="8,4"
                                            Command="{Binding RefreshHeldCommand}" />
                                </DockPanel>

                                <TextBlock Text="{Binding HeldCartsCaption}" Style="{StaticResource FieldHint}" />

                                <ItemsControl ItemsSource="{Binding HeldCarts}" Margin="0,6,0,0">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="#F8FAFC" CornerRadius="6" Padding="8" Margin="0,0,0,6">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>

                                                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding Code}" FontSize="12" FontWeight="SemiBold" />
                                                        <TextBlock Text="{Binding TotalLabel}" FontSize="12" />
                                                        <TextBlock Text="{Binding CustomerLabel}" Style="{StaticResource FieldHint}" Margin="0,1,0,0" />
                                                        <TextBlock Text="{Binding ItemsLabel}" Style="{StaticResource FieldHint}" Margin="0,1,0,0" />
                                                        <TextBlock Text="{Binding WhenLabel}" Style="{StaticResource FieldHint}" Margin="0,1,0,0" />
                                                    </StackPanel>

                                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                        <Button Content="Bring back" Style="{StaticResource GhostButton}"
                                                                FontSize="11" Padding="8,4" Command="{Binding ResumeCommand}" />
                                                        <Button Content="Throw away" Style="{StaticResource GhostButton}"
                                                                FontSize="11" Padding="8,4" Margin="0,4,0,0"
                                                                Command="{Binding DiscardCommand}" />
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Border>
            <!-- Search keeps its own reserved width even when empty. Only matches clear after
                 Add/scan; no result row can cover or resize the cart. -->
            <Border x:Name="SearchResultsPanel" Grid.Column="0" Style="{StaticResource Card}" Padding="8">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <DockPanel Grid.Row="0" Margin="0,0,0,5">
                        <Button DockPanel.Dock="Right" Content="Hide (Esc)" Command="{Binding CloseSearchResultsCommand}"
                                Style="{StaticResource GhostButton}" Padding="7,4"
                                Visibility="{Binding IsSearchResultsOpen, Converter={StaticResource BoolToVis}}" />
                        <TextBlock Text="Search matches" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" />
                    </DockPanel>
                    <StackPanel Grid.Row="1" Visibility="{Binding IsSearchResultsOpen, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="Suggestions only — check before adding." TextWrapping="Wrap"
                                   Style="{StaticResource FieldHint}" Foreground="{StaticResource WarningBrush}"
                                   Visibility="{Binding IsSearchGuessing, Converter={StaticResource BoolToVis}}" />
                        <TextBlock Text="{Binding SearchHint}" TextWrapping="Wrap" FontWeight="Bold" FontSize="11.5"
                                   Foreground="{StaticResource BrandDarkBrush}" />
                    </StackPanel>
                    <TextBlock x:Name="SearchStandbyHint" Grid.Row="2" Text="Type or edit the search above to show matches here. Pick the correct strength / pack, then Add to cart."
                               TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="3,10,3,0">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Visible" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsSearchResultsOpen}" Value="True">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <DataGrid x:Name="SearchMatchesGrid" Grid.Row="2" RowHeight="NaN" ItemsSource="{Binding Products}"
                              SelectedItem="{Binding SelectedProduct, Mode=TwoWay}" IsReadOnly="True"
                              HeadersVisibility="None" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                              Visibility="{Binding IsSearchResultsOpen, Converter={StaticResource BoolToVis}}">
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Width="*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Grid Margin="2,5">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                            <Button Command="{Binding DataContext.OpenProductPhotoCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                    CommandParameter="{Binding Id}" Padding="0" BorderThickness="0"
                                                    Background="Transparent" VerticalAlignment="Top" Margin="0,0,7,0"
                                                    ToolTip="Open this medicine's photo gallery">
                                                <Border Width="{DynamicResource ProductThumbnailSize}" Height="{DynamicResource ProductThumbnailSize}"
                                                        CornerRadius="10" BorderThickness="1" BorderBrush="{StaticResource LineBrush}">
                                                    <Border.Background><ImageBrush ImageSource="{Binding PhotoPath}" Stretch="UniformToFill" /></Border.Background>
                                                    <TextBlock Text="No photo" FontSize="9" TextWrapping="Wrap" TextAlignment="Center"
                                                               VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}"
                                                               Visibility="{Binding HasNoPhoto, Converter={StaticResource BoolToVis}}" />
                                                </Border>
                                            </Button>
                                            <StackPanel Grid.Column="1">
                                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                                <WrapPanel>
                                                    <TextBlock Text="{Binding StrengthLabel, Mode=OneWay}" FontSize="11" Margin="0,0,6,0" />
                                                    <TextBlock Text="{Binding PackSizeLabel, Mode=OneWay}" FontSize="11" TextWrapping="Wrap" />
                                                </WrapPanel>
                                                <WrapPanel>
                                                    <TextBlock Text="{Binding StockLabel, Mode=OneWay}" FontSize="11" Margin="0,0,7,0" />
                                                    <TextBlock Text="{Binding RetailText, Mode=OneWay}" FontSize="11" FontWeight="SemiBold" />
                                                </WrapPanel>
                                                <TextBlock Text="{Binding Generic}" FontSize="10" TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" />
                                                <TextBlock Text="{Binding RackNo, StringFormat=Rack: {0}}" FontSize="10" Foreground="{StaticResource MutedBrush}" />
                                            </StackPanel>
                                        </Grid>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>
        </Grid>
        <!-- Fixed checkout: routine fields and compact actions never depend on cart row count. -->
        <Border x:Name="CheckoutFooter" Grid.Row="3" Style="{StaticResource Card}" Padding="8" Margin="0,8,0,0">
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="90" />
                        <ColumnDefinition Width="*" /><ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="Customer" Style="{StaticResource MetricLabel}" />
                        <ComboBox ItemsSource="{Binding Customers}" DisplayMemberPath="Name"
                                  SelectedItem="{Binding SelectedCustomer, Mode=TwoWay}" ToolTip="{Binding CustomerHint}" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Margin="8,0,0,0">
                        <TextBlock Text="Payment" Style="{StaticResource MetricLabel}" />
                        <ComboBox ItemsSource="{Binding PaymentMethods}" SelectedItem="{Binding PaymentMethod, Mode=TwoWay}" />
                    </StackPanel>
                    <StackPanel Grid.Column="2" Margin="8,0,0,0">
                        <TextBlock Text="Discount %" Style="{StaticResource MetricLabel}" />
                        <TextBox Text="{Binding DiscountPercent, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>
                    <StackPanel Grid.Column="3" Margin="8,0,0,0">
                        <TextBlock Text="Subtotal" Style="{StaticResource MetricLabel}" />
                        <TextBlock Text="{Binding SubtotalText}" FontSize="14" VerticalAlignment="Center" />
                    </StackPanel>
                    <StackPanel Grid.Column="4" Margin="8,0,0,0">
                        <TextBlock Text="Discount" Style="{StaticResource MetricLabel}" />
                        <TextBlock Text="{Binding DiscountText}" FontSize="14" />
                    </StackPanel>
                </Grid>
                <Grid Margin="0,5,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" /><ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" /><ColumnDefinition Width="180" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="TOTAL" Style="{StaticResource MetricLabel}" />
                        <TextBlock Text="{Binding TotalText}" FontSize="26" FontWeight="Bold" Foreground="{StaticResource BrandBrush}" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Margin="8,0,0,0">
                        <TextBlock Text="Cash received" Style="{StaticResource MetricLabel}" />
                        <TextBox Text="{Binding TenderedText, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding IsCashOrSplit}" />
                    </StackPanel>
                    <StackPanel Grid.Column="2" Margin="8,0,0,0">
                        <TextBlock Text="Give back" Style="{StaticResource MetricLabel}" />
                        <TextBlock Text="{Binding ChangeText}" FontSize="26" FontWeight="Bold" Foreground="{StaticResource BrandBrush}" />
                    </StackPanel>
                    <Button x:Name="CompleteSaleButton" Grid.Column="3" Content="Complete sale  (F4)"
                            Command="{Binding CompleteCommand}" Style="{StaticResource PrimaryButton}" Height="42" Margin="8,0,0,0" />
                </Grid>
                <WrapPanel x:Name="CounterActions" Margin="0,5,0,0">
                    <Button Content="Park cart" Command="{Binding HoldCommand}" Style="{StaticResource GhostButton}" Padding="10,4" Margin="0,0,5,3" ToolTip="Nothing is sold. Keep this cart for later." />
                    <Button Content="Save draft" Command="{Binding SaveDraftCommand}" Style="{StaticResource GhostButton}" Padding="10,4" Margin="0,0,5,3" />
                    <Button Content="Open drafts" Command="{Binding DraftsCommand}" Style="{StaticResource GhostButton}" Padding="10,4" Margin="0,0,5,3" />
                    <Button Content="Parked carts" Command="{Binding ToggleParkedCartsCommand}" Style="{StaticResource GhostButton}" Padding="10,4" Margin="0,0,5,3" />
                    <Button Content="Reprint" Command="{Binding PrintLastCommand}" Style="{StaticResource GhostButton}" Padding="10,4" Margin="0,0,5,3" ToolTip="Print last bill again; never a new sale." />
                    <Button Content="More / split" Command="{Binding ToggleCheckoutDetailsCommand}" Style="{StaticResource GhostButton}" Padding="10,4" Margin="0,0,5,3" ToolTip="Doctor, points, split payment and extra answers. Closing this panel does not reset answers." />
                    <Button Content="New customer" Command="{Binding BeginAddCustomerCommand}" Style="{StaticResource GhostButton}" Padding="10,4" Margin="0,0,5,3" Visibility="{Binding CanAddCustomer, Converter={StaticResource BoolToVis}}" />
                    <CheckBox Content="Print automatically" IsChecked="{Binding AutoPrint, Mode=TwoWay}" Margin="6,4,0,0" />
                </WrapPanel>
                <TextBlock Text="{Binding PointsUsedText}" FontSize="11" Visibility="{Binding HasPointsUsed, Converter={StaticResource BoolToVis}}" />
                <TextBlock Text="{Binding StatusMessage}" FontSize="11" TextWrapping="Wrap" MaxHeight="32"
                           ToolTip="{Binding StatusMessage}">
                    <TextBlock.Style><Style TargetType="TextBlock">
                        <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
                        <Style.Triggers><DataTrigger Binding="{Binding IsStatusError}" Value="True"><Setter Property="Foreground" Value="{StaticResource DangerBrush}" /></DataTrigger></Style.Triggers>
                    </Style></TextBlock.Style>
                </TextBlock>
                <TextBlock Text="Open draft — Complete sale posts this draft." Style="{StaticResource FieldHint}"
                           Visibility="{Binding HasOpenDraft, Converter={StaticResource BoolToVis}}" />
                <TextBlock Text="{Binding LastBill}" FontSize="11" TextTrimming="CharacterEllipsis" ToolTip="{Binding LastBill}" />
            </StackPanel>
        </Border>
        <Border Grid.Row="0" Grid.RowSpan="4" Background="#B3FFFFFF"
                Visibility="{Binding IsBlocked, Converter={StaticResource BoolToVis}}">
            <Border Style="{StaticResource Card}" MaxWidth="620" VerticalAlignment="Center"
                    HorizontalAlignment="Center" Padding="26">
                <StackPanel>
                    <TextBlock Text="The drawer (galla) is closed" Style="{StaticResource PageTitle}"
                               Foreground="{StaticResource BrandBrush}" />
                    <TextBlock Text="{Binding BlockedText}" TextWrapping="Wrap" FontSize="13"
                               Foreground="{StaticResource TextBrush}" Margin="0,10,0,0" />
                    <TextBlock Text="Nothing in the shop is lost: the list on this page stays as it is. Opening the drawer is the only thing that starts the counter again."
                               Style="{StaticResource FieldHint}" TextWrapping="Wrap" Margin="0,10,0,0" />
                    <Button Content="Open a galla now" Style="{StaticResource PrimaryButton}"
                            HorizontalAlignment="Left" Margin="0,16,0,0"
                            Command="{Binding OpenShiftCommand}" />
                </StackPanel>
            </Border>
        </Border>
    </Grid>
</UserControl>
