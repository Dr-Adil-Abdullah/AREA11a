<UserControl x:Class="Area11.Desktop.Views.PosView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" Margin="0,0,0,14">
            <StackPanel DockPanel.Dock="Left" VerticalAlignment="Center">
                <TextBlock Text="{DynamicResource AppLabel.counter}" Style="{StaticResource PageTitle}" />
                <TextBlock Text="Nearest expiry first · box / strip / loose · cash change · round down with cost guard"
                           Style="{StaticResource PageSubtitle}" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <TextBlock Text="{Binding CashierName, StringFormat=Cashier: {0}}"
                           Style="{StaticResource PageSubtitle}" VerticalAlignment="Center" Margin="0,0,12,0" />
                <Button Content="Refresh" Style="{StaticResource GhostButton}" Command="{Binding RefreshCommand}" />
            </StackPanel>
        </DockPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.2*" />
                <ColumnDefinition Width="14" />
                <ColumnDefinition Width="1*" />
            </Grid.ColumnDefinitions>

            <!-- Catalog -->
            <Border Grid.Column="0" Style="{StaticResource Card}" Padding="12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0">
                        <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                 ToolTip="Name, salt or barcode. A scanner types the code and presses Enter by itself.">
                            <TextBox.InputBindings>
                                <KeyBinding Key="Enter" Command="{Binding ScanCommand}" />
                            </TextBox.InputBindings>
                        </TextBox>

                        <TextBlock Text="Scan a barcode and press Enter - one of the pack it belongs to is added."
                                   Style="{StaticResource FieldHint}" TextWrapping="Wrap" Margin="0,2,0,0" />

                        <!-- F-50: the list below is a guess, and the shop is told so before a box moves. -->
                        <TextBlock Text="{Binding SearchHint}" TextWrapping="Wrap" Margin="0,4,0,0" FontWeight="Bold"
                                   FontSize="11.5" Foreground="{StaticResource BrandDarkBrush}"
                                   Visibility="{Binding IsSearchGuessing, Converter={StaticResource BoolToVis}}" />
                        <Grid Margin="0,8,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="90" />
                                <ColumnDefinition Width="8" />
                                <ColumnDefinition Width="70" />
                                <ColumnDefinition Width="8" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <ComboBox Grid.Column="0" ItemsSource="{Binding Units}"
                                      SelectedItem="{Binding Unit, Mode=TwoWay}" />
                            <TextBox Grid.Column="2" Text="{Binding Quantity, UpdateSourceTrigger=PropertyChanged}" />
                            <Button Grid.Column="4" Content="Add to cart" Style="{StaticResource PrimaryButton}"
                                    Command="{Binding AddCommand}" />
                        </Grid>
                        <TextBlock Text="{Binding PriceHint}" Style="{StaticResource MetricLabel}" Margin="0,0,0,8" />
                    </StackPanel>

                    <DataGrid Grid.Row="1" ItemsSource="{Binding Products}"
                              SelectedItem="{Binding SelectedProduct, Mode=TwoWay}">
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="Photo" Width="62">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Command="{Binding DataContext.OpenProductPhotoCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                CommandParameter="{Binding Id}" Padding="2" BorderThickness="0" Background="Transparent"
                                                ToolTip="Open this medicine's photo gallery">
                                            <Grid Width="44" Height="44">
                                                <Image Source="{Binding PhotoPath}" Stretch="UniformToFill" />
                                                <TextBlock Text="No photo" FontSize="9" TextWrapping="Wrap" TextAlignment="Center"
                                                           VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}"
                                                           Visibility="{Binding HasNoPhoto, Converter={StaticResource BoolToVis}}" />
                                            </Grid>
                                        </Button>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="Medicine" Binding="{Binding Name}" Width="2*" />
                            <DataGridTextColumn Header="Strength" Binding="{Binding StrengthLabel, Mode=OneWay}" Width="80" />
                            <DataGridTextColumn Header="Salt" Binding="{Binding Generic}" Width="1.4*" />
                            <DataGridTextColumn Header="Stock" Binding="{Binding StockLabel, Mode=OneWay}" Width="90" />
                            <DataGridTextColumn Header="Retail" Binding="{Binding RetailText, Mode=OneWay}" Width="90" />
                            <DataGridTextColumn Header="Rack" Binding="{Binding RackNo}" Width="70" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>

            <!-- Cart and payment -->
            <Border Grid.Column="2" Style="{StaticResource Card}" Padding="12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <DockPanel Grid.Row="0" Margin="0,0,0,8">
                        <TextBlock Text="Cart" Style="{StaticResource SectionTitle}" VerticalAlignment="Center" />
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Content="Remove" Style="{StaticResource GhostButton}"
                                    Command="{Binding RemoveCommand}" />
                            <Button Content="Clear" Style="{StaticResource GhostButton}" Margin="6,0,0,0"
                                    Command="{Binding ClearCommand}" />
                        </StackPanel>
                    </DockPanel>

                    <DataGrid Grid.Row="1" ItemsSource="{Binding Cart}"
                              ToolTip="Rate is rupees per this line's unit. Owner/Manager may edit an agreed custom price; an unchanged retail rate still allows the VIP/Doctor Yes/No choice.">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Item" Binding="{Binding Name, Mode=OneWay}" Width="2*" />
                            <DataGridTextColumn Header="Unit" Binding="{Binding UnitLabel, Mode=OneWay}" Width="60" />
                            <DataGridTextColumn Header="Qty" Binding="{Binding QuantityText, Mode=OneWay}" Width="60" />
                            <DataGridTemplateColumn Header="Rate Rs" Width="85">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding RateText, Mode=OneWay}" VerticalAlignment="Center" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                                <DataGridTemplateColumn.CellEditingTemplate>
                                    <DataTemplate>
                                        <TextBox Text="{Binding RateText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                 IsEnabled="{Binding DataContext.CanEditRates, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellEditingTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>

                    <ScrollViewer Grid.Row="2" Margin="0,10,0,0" VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="Customer" Style="{StaticResource FieldLabel}" />
                        <ComboBox ItemsSource="{Binding Customers}" DisplayMemberPath="Name"
                                  SelectedItem="{Binding SelectedCustomer, Mode=TwoWay}" />
                        <TextBlock Text="{Binding CustomerHint}" Style="{StaticResource MetricLabel}" Margin="0,4,0,0" />

                        <!-- a new face at the counter: add the khata without losing the cart (F-11) -->
                        <Button Content="New customer..." Style="{StaticResource GhostButton}"
                                Margin="0,6,0,0" HorizontalAlignment="Left"
                                Command="{Binding BeginAddCustomerCommand}"
                                Visibility="{Binding CanAddCustomer, Converter={StaticResource BoolToVis}}" />
                        <Border Background="{StaticResource BrandSoftBrush}" CornerRadius="6" Padding="9"
                                Margin="0,6,0,0"
                                Visibility="{Binding IsAddingCustomer, Converter={StaticResource BoolToVis}}">
                            <StackPanel>
                                <TextBlock Text="The cart stays as it is. Only the name on the bill changes."
                                           Style="{StaticResource FieldHint}" TextWrapping="Wrap" />
                                <TextBlock Text="Name" Style="{StaticResource FieldLabel}" Margin="0,6,0,0" />
                                <TextBox Text="{Binding NewCustomerName, UpdateSourceTrigger=PropertyChanged}" />
                                <TextBlock Text="Phone (optional)" Style="{StaticResource FieldLabel}" Margin="0,6,0,0" />
                                <TextBox Text="{Binding NewCustomerPhone, UpdateSourceTrigger=PropertyChanged}" />
                                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                    <Button Content="Save customer" Style="{StaticResource PrimaryButton}"
                                            Command="{Binding SaveCustomerCommand}" Margin="0,0,8,0" />
                                    <Button Content="Cancel" Style="{StaticResource GhostButton}"
                                            Command="{Binding CancelAddCustomerCommand}" />
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <TextBlock Text="Doctor (prescription, optional)" Style="{StaticResource FieldLabel}" Margin="0,8,0,0" />
                        <ComboBox ItemsSource="{Binding Doctors}" DisplayMemberPath="Name"
                                  SelectedItem="{Binding SelectedDoctor, Mode=TwoWay}"
                                  ToolTip="Which doctor wrote the prescription. A doctor is a customer with the category Doctor." />
                        <TextBlock Text="{Binding DoctorHint}" Style="{StaticResource FieldHint}"
                                   TextWrapping="Wrap" />

                        <!-- loyalty points, only for a customer who has some (F-40) -->
                        <StackPanel Margin="0,6,0,0"
                                    Visibility="{Binding CanRedeem, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="Points to use (1 point = Rs 1)" Style="{StaticResource FieldLabel}" />
                            <TextBox Text="{Binding RedeemPointsText, UpdateSourceTrigger=PropertyChanged}"
                                     ToolTip="Leave empty to pay the full bill." />
                            <TextBlock Text="{Binding RedeemHint}" Style="{StaticResource FieldHint}"
                                       TextWrapping="Wrap" />
                        </StackPanel>

                        <Grid Margin="0,6,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="8" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Discount %" Style="{StaticResource FieldLabel}" />
                                <TextBox Text="{Binding DiscountPercent, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Payment" Style="{StaticResource FieldLabel}" />
                                <ComboBox ItemsSource="{Binding PaymentMethods}"
                                          SelectedItem="{Binding PaymentMethod, Mode=TwoWay}" />
                            </StackPanel>
                        </Grid>

                        <Border Background="{StaticResource BrandSoftBrush}" CornerRadius="6" Padding="9"
                                Margin="0,6,0,0"
                                Visibility="{Binding IsSplit, Converter={StaticResource BoolToVis}}">
                            <StackPanel>
                                <TextBlock Text="Split payment - the rest of the bill is cash"
                                           Style="{StaticResource FieldHint}" Margin="0,0,0,6" />

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="8" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="Paid by" Style="{StaticResource FieldLabel}" />
                                        <ComboBox ItemsSource="{Binding SplitMethods}"
                                                  SelectedItem="{Binding SecondMethod, Mode=TwoWay}" />
                                    </StackPanel>

                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="Amount (Rs)" Style="{StaticResource FieldLabel}" />
                                        <TextBox Text="{Binding SecondAmountText, UpdateSourceTrigger=PropertyChanged}" />
                                    </StackPanel>
                                </Grid>

                                <Grid Margin="0,8,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="Cash part" Style="{StaticResource MetricLabel}" />
                                        <TextBlock Text="{Binding CashPartText}" FontSize="13" FontWeight="SemiBold" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="On credit (khata)" Style="{StaticResource MetricLabel}" />
                                        <TextBlock Text="{Binding CreditPartText}" FontSize="13" FontWeight="SemiBold" />
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <Grid Margin="0,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Subtotal" Style="{StaticResource MetricLabel}" />
                                <TextBlock Text="{Binding SubtotalText}" FontSize="14" />
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="Discount" Style="{StaticResource MetricLabel}" />
                                <TextBlock Text="{Binding DiscountText}" FontSize="14" />
                            </StackPanel>
                        </Grid>

                        <TextBlock Text="TOTAL" Style="{StaticResource MetricLabel}" Margin="0,8,0,0" />
                        <TextBlock Text="{Binding TotalText}" FontSize="28" FontWeight="Bold"
                                   Foreground="{StaticResource BrandBrush}" />

                        <TextBlock Text="{Binding PointsUsedText}" FontSize="12" FontWeight="SemiBold"
                                   Foreground="{StaticResource SuccessBrush}"
                                   Visibility="{Binding HasPointsUsed, Converter={StaticResource BoolToVis}}" />

                        <Grid Margin="0,6,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Cash received" Style="{StaticResource MetricLabel}" />
                                <TextBox Text="{Binding TenderedText, UpdateSourceTrigger=PropertyChanged}"
                                         IsEnabled="{Binding IsCashOrSplit}" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Margin="8,0,0,0">
                                <TextBlock Text="Change" Style="{StaticResource MetricLabel}" />
                                <TextBlock Text="{Binding ChangeText}" FontSize="17" FontWeight="SemiBold" />
                            </StackPanel>
                        </Grid>

                        <CheckBox Content="Print the receipt automatically"
                                  IsChecked="{Binding AutoPrint, Mode=TwoWay}"
                                  ToolTip="Off = the cashier prints with the button below."
                                  Margin="0,8,0,0" />

                        <Border Background="#F0FDF4" BorderBrush="{StaticResource SuccessBrush}"
                                BorderThickness="1" CornerRadius="7" Padding="10" Margin="0,10,0,0"
                                Visibility="{Binding ShowSaleSuccess, Converter={StaticResource BoolToVis}}">
                            <StackPanel>
                                <TextBlock Text="✓ Done — sale saved" Foreground="{StaticResource SuccessBrush}"
                                           FontSize="17" FontWeight="Bold" />
                                <TextBlock Text="{Binding LastBill}" TextWrapping="Wrap"
                                           FontWeight="SemiBold" Margin="0,5,0,0" />
                                <TextBlock Text="{Binding SuccessChangeText}" TextWrapping="Wrap"
                                           Foreground="{StaticResource DangerBrush}" FontSize="15" FontWeight="Bold"
                                           Margin="0,5,0,0"
                                           Visibility="{Binding HasSuccessChange, Converter={StaticResource BoolToVis}}" />
                                <Button Content="Done — ready for next sale" Style="{StaticResource PrimaryButton}"
                                        Command="{Binding DoneCommand}" IsDefault="True"
                                        HorizontalAlignment="Left" Margin="0,9,0,0"
                                        ToolTip="Dismiss this card only. The invoice is already saved; scanning the next item also continues." />
                            </StackPanel>
                        </Border>

                        <Button Content="Complete sale  (F4)" Style="{StaticResource PrimaryButton}" Height="40"
                                Margin="0,12,0,0" Command="{Binding CompleteCommand}" />

                        <Button Content="Park this cart for later" Style="{StaticResource GhostButton}"
                                Margin="0,6,0,0" Command="{Binding HoldCommand}"
                                ToolTip="Nothing is sold. The cart is kept in the database until you bring it back." />

                        <Button Content="Print last bill again" Style="{StaticResource GhostButton}"
                                Margin="0,6,0,0" Command="{Binding PrintLastCommand}" />

                        <Border Background="#F8FAFC" CornerRadius="6" Padding="9" Margin="0,10,0,0">
                            <StackPanel>
                                <TextBlock Text="{Binding StatusMessage}" FontSize="11" TextWrapping="Wrap">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsStatusError}" Value="True">
                                                    <Setter Property="Foreground" Value="{StaticResource DangerBrush}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <TextBlock Text="{Binding LastBill}" FontSize="12" FontWeight="SemiBold" Margin="0,5,0,0" />
                            </StackPanel>
                        </Border>

                        <Border BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="8"
                                Padding="10" Margin="0,10,0,0">
                            <StackPanel>
                                <DockPanel>
                                    <TextBlock Text="Parked carts" Style="{StaticResource SectionTitle}"
                                               VerticalAlignment="Center" />
                                    <Button DockPanel.Dock="Right" Content="Refresh" HorizontalAlignment="Right"
                                            Style="{StaticResource GhostButton}" FontSize="11" Padding="8,4"
                                            Command="{Binding RefreshHeldCommand}" />
                                </DockPanel>

                                <TextBlock Text="{Binding HeldCartsCaption}" Style="{StaticResource FieldHint}" />

                                <ItemsControl ItemsSource="{Binding HeldCarts}" Margin="0,6,0,0">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="#F8FAFC" CornerRadius="6" Padding="8" Margin="0,0,0,6">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>

                                                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding Code}" FontSize="12" FontWeight="SemiBold" />
                                                        <TextBlock Text="{Binding TotalLabel}" FontSize="12" />
                                                        <TextBlock Text="{Binding CustomerLabel}" Style="{StaticResource FieldHint}" Margin="0,1,0,0" />
                                                        <TextBlock Text="{Binding ItemsLabel}" Style="{StaticResource FieldHint}" Margin="0,1,0,0" />
                                                        <TextBlock Text="{Binding WhenLabel}" Style="{StaticResource FieldHint}" Margin="0,1,0,0" />
                                                    </StackPanel>

                                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                        <Button Content="Bring back" Style="{StaticResource GhostButton}"
                                                                FontSize="11" Padding="8,4" Command="{Binding ResumeCommand}" />
                                                        <Button Content="Throw away" Style="{StaticResource GhostButton}"
                                                                FontSize="11" Padding="8,4" Margin="0,4,0,0"
                                                                Command="{Binding DiscardCommand}" />
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>

        <!-- The drawer gate (v0.35.0, D-92): with no galla open there is no bill, and the way out
             is one button on this very screen - the owner's words: "sign in or open the galla right
             here". The card covers the page rather than hiding it, so the cashier sees the shop's
             work behind the sentence and knows the program did not lose it. -->
        <Border Grid.Row="0" Grid.RowSpan="2" Background="#B3FFFFFF"
                Visibility="{Binding IsBlocked, Converter={StaticResource BoolToVis}}">
            <Border Style="{StaticResource Card}" MaxWidth="620" VerticalAlignment="Center"
                    HorizontalAlignment="Center" Padding="26">
                <StackPanel>
                    <TextBlock Text="The drawer (galla) is closed" Style="{StaticResource PageTitle}"
                               Foreground="{StaticResource BrandBrush}" />
                    <TextBlock Text="{Binding BlockedText}" TextWrapping="Wrap" FontSize="13"
                               Foreground="{StaticResource TextBrush}" Margin="0,10,0,0" />
                    <TextBlock Text="Nothing in the shop is lost: the list on this page stays as it is. Opening the drawer is the only thing that starts the counter again."
                               Style="{StaticResource FieldHint}" TextWrapping="Wrap" Margin="0,10,0,0" />
                    <Button Content="Open a galla now" Style="{StaticResource PrimaryButton}"
                            HorizontalAlignment="Left" Margin="0,16,0,0"
                            Command="{Binding OpenShiftCommand}" />
                </StackPanel>
            </Border>
        </Border>
    </Grid>
</UserControl>
