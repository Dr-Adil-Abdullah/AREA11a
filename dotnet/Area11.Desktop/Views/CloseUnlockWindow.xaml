<Window Icon="{DynamicResource Area11WindowIcon}" x:Class="Area11.Desktop.Views.CloseUnlockWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Closing is protected - Area11" Height="330" Width="420"
        WindowStartupLocation="CenterOwner" Background="{StaticResource CanvasBrush}"
        ResizeMode="NoResize" ShowInTaskbar="False">

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Who is closing Area11?" Style="{StaticResource SectionTitle}" />
        <TextBlock Grid.Row="1" Text="Closing is protected on this computer. Type the owner's password or PIN - or the PIN of a staff member the owner ticked for closing."
                   Style="{StaticResource FieldHint}" TextWrapping="Wrap" Margin="0,4,0,0" />

        <TextBlock Grid.Row="2" Text="Name (empty means the owner)" Style="{StaticResource FieldLabel}" Margin="0,10,0,0" />
        <TextBox Grid.Row="3" x:Name="NameBox" />

        <TextBlock Grid.Row="4" Text="Password or PIN" Style="{StaticResource FieldLabel}" Margin="0,8,0,0" />
        <PasswordBox Grid.Row="5" x:Name="SecretBox" VerticalAlignment="Top" KeyDown="OnSecretKeyDown" />

        <TextBlock Grid.Row="5" x:Name="ErrorText" TextWrapping="Wrap" Margin="0,34,0,0"
                   Foreground="{StaticResource DangerBrush}" FontWeight="SemiBold" Visibility="Collapsed" />

        <StackPanel Grid.Row="6" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="Keep running" Style="{StaticResource GhostButton}" MinWidth="110"
                    Click="OnCancel" IsCancel="True" />
            <Button Content="Close Area11" Style="{StaticResource PrimaryButton}" MinWidth="110" Margin="8,0,0,0"
                    Click="OnUnlock" IsDefault="True" />
        </StackPanel>
    </Grid>
</Window>
