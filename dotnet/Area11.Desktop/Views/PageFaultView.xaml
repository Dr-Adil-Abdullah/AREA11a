<UserControl x:Class="Area11.Desktop.Views.PageFaultView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ============================ a page that could not open ============================ -->
    <!--
        Why this screen exists (D-88): the operator pressed a menu row and something inside that
        page failed. The alternative - which is what used to happen - is a window that closes, or a
        frame with nothing in it. Neither tells him that his counter still works, and both make him
        close the program and lose the day's till. So the card says three things, in this order:
        what failed, that nothing else is affected, and what to send if it happens again.
    -->
    <Grid Background="{StaticResource CanvasBrush}">
        <Border Style="{StaticResource Card}" Padding="22" VerticalAlignment="Top" Margin="18">
            <StackPanel>
                <TextBlock Text="This page could not be opened" Style="{StaticResource PageTitle}" />
                <TextBlock Text="{Binding Sentence, Mode=OneWay}" FontSize="15" FontWeight="SemiBold"
                           Foreground="{StaticResource DangerBrush}" TextWrapping="Wrap" Margin="0,6,0,0" />

                <Border Background="{StaticResource DangerSoftBrush}" CornerRadius="6" Padding="10"
                        Margin="0,12,0,0">
                    <TextBlock Text="{Binding Detail, Mode=OneWay}" TextWrapping="Wrap"
                               FontFamily="Consolas" FontSize="12"
                               Foreground="{StaticResource TextBrush}" />
                </Border>

                <TextBlock Text="{Binding Advice, Mode=OneWay}" TextWrapping="Wrap"
                           Style="{StaticResource FieldHint}" Margin="0,14,0,0" />

                <TextBlock Text="Your shop's figures were not changed by this: opening a page only reads."
                           TextWrapping="Wrap" FontSize="12.5" Margin="0,10,0,0"
                           Foreground="{StaticResource MutedBrush}" />

                <TextBlock Text="{Binding ReportLabel, Mode=OneWay}" TextWrapping="Wrap"
                           Style="{StaticResource FieldHint}" Margin="0,10,0,0" />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
