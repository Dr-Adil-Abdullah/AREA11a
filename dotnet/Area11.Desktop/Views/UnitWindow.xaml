<Window x:Class="Area11.Desktop.Views.UnitWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Manage units - Area11" Height="610" Width="760" MinHeight="480" MinWidth="620"
        WindowStartupLocation="CenterOwner" Background="{StaticResource CanvasBrush}">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <StackPanel Grid.Row="0" Margin="0,0,0,12">
            <TextBlock Text="Managed units" Style="{StaticResource PageTitle}" />
            <TextBlock Style="{StaticResource PageSubtitle}" TextWrapping="Wrap"
                       Text="One canonical spelling for stock and strength. Rename updates current product labels atomically; a unit in use cannot be put away." />
            <Button Content="Refresh" Style="{StaticResource GhostButton}" HorizontalAlignment="Left"
                    Margin="0,8,0,0" Command="{Binding RefreshCommand}" />
        </StackPanel>
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="14" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0" Style="{StaticResource Card}" Padding="12">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                    <DataGrid ItemsSource="{Binding Units}" SelectedItem="{Binding SelectedUnit, Mode=TwoWay}"
                              AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" CanUserDeleteRows="False"
                              RowHeaderWidth="0" SelectionMode="Single">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Unit" Binding="{Binding Name}" Width="*" />
                            <DataGridTextColumn Header="Stock products" Binding="{Binding ProductCount}" Width="Auto" />
                            <DataGridTextColumn Header="Strength uses" Binding="{Binding StrengthCount}" Width="Auto" />
                            <DataGridTextColumn Header="Quantity rule" Binding="{Binding QuantityLabel, Mode=OneWay}" Width="Auto" />
                            <DataGridTextColumn Header="State" Binding="{Binding ActiveLabel, Mode=OneWay}" Width="Auto" />
                        </DataGrid.Columns>
                    </DataGrid>
                    <TextBlock Grid.Row="0" Text="No units yet. Choose New unit." Style="{StaticResource FieldHint}"
                               HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False"
                               Visibility="{Binding HasNoUnits, Converter={StaticResource BoolToVis}}" />
                </Grid>
            </Border>
            <Border Grid.Column="2" Style="{StaticResource Card}" Padding="14">
                <StackPanel>
                    <TextBlock Text="Unit details" Style="{StaticResource SectionTitle}" />
                    <TextBlock Text="Canonical name (for example injection or ml)" Style="{StaticResource FieldLabel}" />
                    <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBlock Text="Order" Style="{StaticResource FieldLabel}" />
                    <TextBox Text="{Binding OrderText, UpdateSourceTrigger=PropertyChanged}" />
                    <CheckBox Content="Whole stock quantities only (for example injections)"
                              IsChecked="{Binding WholeOnly, Mode=TwoWay}"
                              IsEnabled="{Binding CanEdit}" Margin="0,10,0,0" />
                    <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                        <Button Content="New unit" Style="{StaticResource GhostButton}" Command="{Binding NewCommand}"
                                IsEnabled="{Binding CanEdit}" Margin="0,0,6,0" />
                        <Button Content="Save unit" Style="{StaticResource PrimaryButton}" Command="{Binding SaveCommand}"
                                IsEnabled="{Binding CanEdit}" Margin="0,0,6,0" />
                        <Button Content="{Binding ToggleLabel}" Style="{StaticResource GhostButton}" Command="{Binding ToggleCommand}"
                                IsEnabled="{Binding CanToggle}" />
                    </StackPanel>
                    <TextBlock Style="{StaticResource FieldHint}" TextWrapping="Wrap" Margin="0,14,0,0"
                               Text="mL is stored as ml and is a strength label, not a stock-count division. Whole-only is a property of the managed unit, so renaming injection cannot enable fractional stock. A box of 10 injections at 50 ml is 10 injection units; 10, 50 and 100 ml variants remain separate products." />
                </StackPanel>
            </Border>
        </Grid>
        <StackPanel Grid.Row="2" Margin="0,10,0,0">
            <TextBlock Text="Only the owner or a manager can change units; Core checks permission again."
                       Style="{StaticResource FieldHint}" Visibility="{Binding IsReadOnly, Converter={StaticResource BoolToVis}}" />
            <TextBlock Text="{Binding StatusText}" TextWrapping="Wrap" FontSize="11.5">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsStatusError}" Value="True">
                                <Setter Property="Foreground" Value="{StaticResource DangerBrush}" />
                                <Setter Property="FontWeight" Value="Bold" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
        </StackPanel>
    </Grid>
</Window>
