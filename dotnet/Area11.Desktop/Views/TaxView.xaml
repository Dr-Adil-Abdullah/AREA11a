<UserControl x:Class="Area11.Desktop.Views.TaxView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ================================ heading + month ================================ -->
        <DockPanel Grid.Row="0" Margin="0,0,0,10">
            <StackPanel DockPanel.Dock="Left" VerticalAlignment="Center">
                <TextBlock Text="Tax report" Style="{StaticResource PageTitle}" />
                <TextBlock Text="What the counter charged each month, day by day - ready for the accountant."
                           Style="{StaticResource PageSubtitle}" TextWrapping="Wrap" />
            </StackPanel>

            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Content="Previous" Style="{StaticResource GhostButton}" Command="{Binding PreviousCommand}" />
                <TextBlock Text="{Binding MonthLabel}" FontSize="14" FontWeight="SemiBold" MinWidth="130"
                           TextAlignment="Center" VerticalAlignment="Center" Margin="10,0" />
                <Button Content="Next" Style="{StaticResource GhostButton}" Command="{Binding NextCommand}" />
                <Button Content="This month" Style="{StaticResource PrimaryButton}" Command="{Binding ThisMonthCommand}"
                        Margin="10,0,0,0" />
            </StackPanel>
        </DockPanel>

        <!-- ================================ the four numbers ================================ -->
        <UniformGrid Grid.Row="1" Columns="4" Margin="0,0,0,12">
            <Border Style="{StaticResource Card}" Margin="0,0,6,0">
                <StackPanel>
                    <TextBlock Text="BILLS" Style="{StaticResource MetricLabel}" />
                    <TextBlock Text="{Binding BillsText}" Style="{StaticResource MetricValue}" />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource Card}" Margin="3,0,3,0">
                <StackPanel>
                    <TextBlock Text="SALES BEFORE TAX" Style="{StaticResource MetricLabel}" />
                    <TextBlock Text="{Binding NetText}" Style="{StaticResource MetricValue}" />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource Card}" Margin="3,0,3,0">
                <StackPanel>
                    <TextBlock Text="TAX CHARGED" Style="{StaticResource MetricLabel}" />
                    <TextBlock Text="{Binding TaxText}" Style="{StaticResource MetricValue}" />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource Card}" Margin="6,0,0,0">
                <StackPanel>
                    <TextBlock Text="TOTAL ON THE BILLS" Style="{StaticResource MetricLabel}" />
                    <TextBlock Text="{Binding GrossText}" Style="{StaticResource MetricValue}" />
                </StackPanel>
            </Border>
        </UniformGrid>

        <!-- ================================ the table + the fine print ================================ -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource Card}" Padding="12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="DAY BY DAY" Style="{StaticResource SectionTitle}" Margin="0,0,0,6" />

                    <DataGrid Grid.Row="1" ItemsSource="{Binding Rows}" IsReadOnly="True"
                              AutoGenerateColumns="False" HeadersVisibility="Column"
                              GridLinesVisibility="Horizontal">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Date" Binding="{Binding DayLabel}" Width="110" />
                            <DataGridTextColumn Header="Bills" Binding="{Binding BillsLabel}" Width="70" />
                            <DataGridTextColumn Header="Before tax" Binding="{Binding NetLabel}" Width="*" />
                            <DataGridTextColumn Header="Tax" Binding="{Binding TaxLabel}" Width="*" />
                            <DataGridTextColumn Header="Total" Binding="{Binding GrossLabel}" Width="*" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>

            <Border Grid.Column="2" Style="{StaticResource Card}" Padding="14">
                <StackPanel>
                    <TextBlock Text="WHAT THIS NUMBER COVERS" Style="{StaticResource SectionTitle}" />
                    <TextBlock Style="{StaticResource FieldHint}" TextWrapping="Wrap" Margin="0,6,0,0"
                               Text="Only paid, partly paid and credit bills. A held bill and a void bill were never a sale, so neither is counted." />
                    <TextBlock Style="{StaticResource FieldHint}" TextWrapping="Wrap" Margin="0,6,0,0"
                               Text="The tax is what each bill actually took. A rate changed in the middle of the month therefore shows the truth, not today's rate multiplied over old bills." />
                    <TextBlock Style="{StaticResource FieldHint}" TextWrapping="Wrap" Margin="0,6,0,0"
                               Text="A refund is stored as one amount, so its tax part is not separated. Refunds are listed below for the accountant to adjust by hand (D-63)." />

                    <TextBlock Text="{Binding SettingLabel}" Style="{StaticResource FieldHint}" TextWrapping="Wrap"
                               Margin="0,10,0,0" />

                    <Border Background="{StaticResource DangerSoftBrush}" CornerRadius="8" Padding="10" Margin="0,10,0,0"
                            Visibility="{Binding HasRefunds, Converter={StaticResource BoolToVis}}">
                        <StackPanel>
                            <TextBlock Text="REFUNDS THIS MONTH" Style="{StaticResource MetricLabel}" />
                            <TextBlock Text="{Binding RefundText}" FontWeight="Bold" Foreground="{StaticResource DangerBrush}" />
                        </StackPanel>
                    </Border>

                    <Button Content="Copy for the accountant" Style="{StaticResource GhostButton}" Margin="0,12,0,0"
                            Command="{Binding CopyCommand}" />
                </StackPanel>
            </Border>
        </Grid>

        <!-- ================================ the footer ================================ -->
        <TextBlock Grid.Row="3" Text="{Binding StatusText}" TextWrapping="Wrap" FontSize="11.5" Margin="0,10,0,0">
            <TextBlock.Style>
                <Style TargetType="TextBlock">
                    <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsStatusError}" Value="True">
                            <Setter Property="Foreground" Value="{StaticResource DangerBrush}" />
                            <Setter Property="FontWeight" Value="Bold" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </TextBlock.Style>
        </TextBlock>
    </Grid>
</UserControl>
