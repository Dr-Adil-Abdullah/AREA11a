<UserControl x:Class="Area11.Desktop.Views.AlertsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" Margin="0,0,0,10">
            <StackPanel DockPanel.Dock="Left" VerticalAlignment="Center">
                <TextBlock Text="Alerts" Style="{StaticResource PageTitle}" />
                <TextBlock Text="A reminder may be put away by anyone. Anything that is money or stock needs the owner, and the reason stays on record."
                           Style="{StaticResource PageSubtitle}" />
            </StackPanel>

            <Button DockPanel.Dock="Right" HorizontalAlignment="Right" VerticalAlignment="Center"
                    Content="Refresh" Style="{StaticResource GhostButton}" Command="{Binding RefreshCommand}" />
        </DockPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.35*" />
                <ColumnDefinition Width="14" />
                <ColumnDefinition Width="1*" />
            </Grid.ColumnDefinitions>

            <!-- Live alerts -->
            <Border Grid.Column="0" Style="{StaticResource Card}" Padding="12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Margin="0,0,0,8">
                        <TextBlock Text="What needs attention now" Style="{StaticResource SectionTitle}" />
                        <TextBlock Text="{Binding SummaryText}" Style="{StaticResource FieldHint}" />
                    </StackPanel>

                    <DataGrid Grid.Row="1" ItemsSource="{Binding Live}"
                              SelectedItem="{Binding Selected, Mode=TwoWay}">
                        <DataGrid.RowStyle>
                            <Style TargetType="DataGridRow">
                                <Style.Triggers>
                                    <!-- Red: money or stock is wrong now. Amber: waiting for the owner. -->
                                    <DataTrigger Binding="{Binding IsCritical}" Value="True">
                                        <Setter Property="Background" Value="{StaticResource DangerSoftBrush}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsAmber}" Value="True">
                                        <Setter Property="Background" Value="{StaticResource WarningSoftBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </DataGrid.RowStyle>
                        <DataGrid.Columns>
                            <!-- Who may touch it: the two kinds the owner asked for (D-50). -->
                            <DataGridTextColumn Header="Who" Binding="{Binding KindLabel}" Width="86" />
                            <DataGridTextColumn Header="Alert" Binding="{Binding TypeLabel}" Width="130" />
                            <DataGridTextColumn Header="Item" Binding="{Binding Title}" Width="2*" />
                            <DataGridTextColumn Header="Detail" Binding="{Binding Detail}" Width="2.4*" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>

            <!-- Ending an alert: owner only -->
            <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <Border Style="{StaticResource Card}" Padding="14" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="Put a reminder away" Style="{StaticResource SectionTitle}" />
                            <TextBlock Text="Drawer left open, a bill waiting to be confirmed. One click, no reason - and nothing else in the app changes."
                                       Style="{StaticResource FieldHint}" TextWrapping="Wrap" />

                            <Button Content="Put this reminder away" Style="{StaticResource GhostButton}"
                                    Margin="0,8,0,0" HorizontalAlignment="Left"
                                    Command="{Binding DismissLightCommand}"
                                    IsEnabled="{Binding CanPutAway}"
                                    ToolTip="Any signed-in person may do this for a reminder." />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}" Padding="14" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="End an alert (owner)" Style="{StaticResource SectionTitle}" />
                            <TextBlock Text="{Binding SelectedCaption}" Style="{StaticResource FieldHint}" />

                            <StackPanel Visibility="{Binding IsOwner, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="Reason (compulsory)" Style="{StaticResource FieldLabel}" />
                                <TextBox Text="{Binding ReasonText, UpdateSourceTrigger=PropertyChanged}"
                                         ToolTip="For example: counted the shelf, stock is fine" />

                                <Button Content="End this alert" Style="{StaticResource PrimaryButton}"
                                        Margin="0,10,0,0" Command="{Binding DismissCommand}" />

                                <TextBlock Text="The alert re-opens by itself if the medicine moves again - one reason cannot silence a repeat problem."
                                           Style="{StaticResource FieldHint}" />
                            </StackPanel>

                            <Border Background="{StaticResource WarningSoftBrush}" CornerRadius="8" Padding="10"
                                    Margin="0,8,0,0"
                                    Visibility="{Binding IsNotOwner, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="Only the owner can end this alert by writing a reason."
                                           FontSize="11.5" TextWrapping="Wrap"
                                           Foreground="{StaticResource WarningBrush}" />
                            </Border>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}" Padding="14">
                        <StackPanel>
                            <TextBlock Text="Alerts the owner ended" Style="{StaticResource SectionTitle}" />
                            <TextBlock Text="Reason, who and when - kept for good." Style="{StaticResource FieldHint}" />

                            <DataGrid ItemsSource="{Binding Ended}" Height="220" Margin="0,8,0,0"
                                      SelectedItem="{Binding Selected, Mode=TwoWay}">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Item" Binding="{Binding Title}" Width="*" />
                                    <DataGridTextColumn Header="Reason" Binding="{Binding Reason}" Width="1.6*" />
                                    <DataGridTextColumn Header="When" Binding="{Binding EndedAt}" Width="120" />
                                </DataGrid.Columns>
                            </DataGrid>

                            <Button Content="Bring this alert back" Style="{StaticResource GhostButton}"
                                    Margin="0,8,0,0" HorizontalAlignment="Left"
                                    Command="{Binding RestoreCommand}"
                                    ToolTip="Owner only. Use it when the reason turned out to be wrong." />

                            <TextBlock Text="Restoring is recorded in the black box too (active → dismissed → active)."
                                       Style="{StaticResource FieldHint}" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <Border Grid.Row="2" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource LineBrush}"
                BorderThickness="1" CornerRadius="8" Padding="12,8" Margin="0,10,0,0">
            <TextBlock Text="{Binding StatusText}" TextWrapping="Wrap">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="FontSize" Value="12" />
                        <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsStatusError}" Value="True">
                                <Setter Property="Foreground" Value="{StaticResource DangerBrush}" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
        </Border>
    </Grid>
</UserControl>
