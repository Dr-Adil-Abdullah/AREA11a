<UserControl x:Class="Area11.Desktop.Views.DoctorsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ================================ the heading ================================ -->
        <DockPanel Grid.Row="0" Margin="0,0,0,10">
            <StackPanel DockPanel.Dock="Left" VerticalAlignment="Center">
                <TextBlock Text="Doctors &amp; reps" Style="{StaticResource PageTitle}" />
                <TextBlock Text="Which company's rep visits on which day, on whose prescription a bill was sold, and what each customer has earned the shop."
                           Style="{StaticResource PageSubtitle}" TextWrapping="Wrap" />
            </StackPanel>

            <Button DockPanel.Dock="Right" HorizontalAlignment="Right" VerticalAlignment="Center"
                    Content="Refresh" Style="{StaticResource GhostButton}" Command="{Binding RefreshCommand}" />
        </DockPanel>

        <!-- ================================ the reps ================================ -->
        <Border Grid.Row="1" Style="{StaticResource Card}" Padding="14" Margin="0,0,0,10"
                Visibility="{Binding CanSeeReps, Converter={StaticResource BoolToVis}}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="14" />
                    <ColumnDefinition Width="330" />
                </Grid.ColumnDefinitions>

                <Grid Grid.Column="0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <DockPanel Grid.Row="0" Margin="0,0,0,6">
                        <TextBlock DockPanel.Dock="Left" Text="The companies and their medical reps"
                                   Style="{StaticResource SectionTitle}" />
                        <TextBlock DockPanel.Dock="Right" HorizontalAlignment="Right" Text="visit day"
                                   Style="{StaticResource FieldHint}" />
                    </DockPanel>

                    <ListBox Grid.Row="1" ItemsSource="{Binding Rows}"
                             SelectedItem="{Binding SelectedCompany, Mode=TwoWay}"
                             MaxHeight="220" BorderBrush="{StaticResource LineBrush}"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="4,3">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="12.5" />
                                        <TextBlock Text="{Binding RepLabel}" Style="{StaticResource FieldHint}" />
                                    </StackPanel>

                                    <StackPanel Grid.Column="1" HorizontalAlignment="Right">
                                        <TextBlock Text="{Binding VisitLabel}" FontSize="11.5"
                                                   HorizontalAlignment="Right" />
                                        <TextBlock Text="{Binding PhoneLabel}" Style="{StaticResource FieldHint}"
                                                   HorizontalAlignment="Right" />
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>

                <StackPanel Grid.Column="2">
                    <TextBlock Text="The rep of this company" Style="{StaticResource SectionTitle}" />
                    <TextBlock Text="{Binding SelectedCompanyName}" FontSize="13" FontWeight="SemiBold"
                               TextWrapping="Wrap" Margin="0,4,0,0" />

                    <TextBlock Text="Name" Style="{StaticResource FieldLabel}" Margin="0,8,0,0" />
                    <TextBox Text="{Binding RepNameText, UpdateSourceTrigger=PropertyChanged}"
                             IsEnabled="{Binding CanEditReps}" />

                    <TextBlock Text="Phone" Style="{StaticResource FieldLabel}" Margin="0,8,0,0" />
                    <TextBox Text="{Binding RepPhoneText, UpdateSourceTrigger=PropertyChanged}"
                             IsEnabled="{Binding CanEditReps}" />

                    <TextBlock Text="Visits on" Style="{StaticResource FieldLabel}" Margin="0,8,0,0" />
                    <ComboBox ItemsSource="{Binding DayOptions}" DisplayMemberPath="Label"
                              SelectedItem="{Binding SelectedDay, Mode=TwoWay}"
                              IsEnabled="{Binding CanEditReps}" />

                    <Button Content="Save the rep" Style="{StaticResource PrimaryButton}" Height="36"
                            Margin="0,10,0,0" Command="{Binding SaveRepCommand}"
                            IsEnabled="{Binding CanEditReps}" />

                    <TextBlock Text="Only the owner or a manager may change a rep."
                               Style="{StaticResource FieldHint}" TextWrapping="Wrap" Margin="0,6,0,0" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- ================================ the doctors and the profit ================================ -->
        <TabControl Grid.Row="2" Background="Transparent" BorderThickness="0">

            <TabItem Header="Doctors and prescriptions"
                     Visibility="{Binding CanSeeDoctors, Converter={StaticResource BoolToVis}}">
                <Border Style="{StaticResource Card}" Padding="12" Margin="0,8,0,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <DockPanel Grid.Row="0" Margin="0,0,0,6">
                            <TextBlock DockPanel.Dock="Left" Text="A doctor is a customer whose category is Doctor."
                                       Style="{StaticResource FieldHint}" TextWrapping="Wrap" />
                            <TextBlock DockPanel.Dock="Right" HorizontalAlignment="Right"
                                       Text="{Binding DoctorCountText}" Style="{StaticResource FieldHint}" />
                        </DockPanel>

                        <Grid Grid.Row="1">
                        <DataGrid ItemsSource="{Binding Doctors}" IsReadOnly="True"
                                  AutoGenerateColumns="False" HeadersVisibility="Column"
                                  GridLinesVisibility="Horizontal">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Doctor" Binding="{Binding Name}" Width="1.6*" />
                                <DataGridTextColumn Header="Phone" Binding="{Binding PhoneLabel, Mode=OneWay}" Width="130" />
                                <DataGridTextColumn Header="Bills" Binding="{Binding BillsText, Mode=OneWay}" Width="80" />
                                <DataGridTextColumn Header="Sales" Binding="{Binding SalesText, Mode=OneWay}" Width="100" />
                                <DataGridTextColumn Header="Profit" Binding="{Binding ProfitText, Mode=OneWay}" Width="95" />
                                <DataGridTextColumn Header="Last bill" Binding="{Binding LastBillLabel, Mode=OneWay}" Width="95" />
                            </DataGrid.Columns>
                        </DataGrid>

                        <TextBlock Text="No doctor yet. Add a customer whose category is Doctor on the Customers page - the counter will then offer him on every bill."
                                   TextWrapping="Wrap" HorizontalAlignment="Center" VerticalAlignment="Center"
                                   FontSize="12" Foreground="{StaticResource MutedBrush}" MaxWidth="420"
                                   IsHitTestVisible="False"
                                   Visibility="{Binding HasNoDoctors, Converter={StaticResource BoolToVis}}" />
                        </Grid>
                    </Grid>
                </Border>
            </TabItem>

            <TabItem Header="Customer lifetime profit"
                     Visibility="{Binding CanSeeProfit, Converter={StaticResource BoolToVis}}">
                <Border Style="{StaticResource Card}" Padding="12" Margin="0,8,0,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <DockPanel Grid.Row="0" Margin="0,0,0,6">
                            <TextBlock DockPanel.Dock="Left"
                                       Text="Sales minus the cost of the goods sold, minus what came back to the shelf. Every bill ever made for this customer counts."
                                       Style="{StaticResource FieldHint}" TextWrapping="Wrap" />
                            <TextBlock DockPanel.Dock="Right" HorizontalAlignment="Right"
                                       Text="{Binding CustomerCountText}" Style="{StaticResource FieldHint}" />
                        </DockPanel>

                        <DataGrid Grid.Row="1" ItemsSource="{Binding Customers}" IsReadOnly="True"
                                  AutoGenerateColumns="False" HeadersVisibility="Column"
                                  GridLinesVisibility="Horizontal">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Customer" Binding="{Binding Name}" Width="1.6*" />
                                <DataGridTextColumn Header="Phone" Binding="{Binding PhoneLabel, Mode=OneWay}" Width="130" />
                                <DataGridTextColumn Header="Kind" Binding="{Binding CategoryLabel, Mode=OneWay}" Width="85" />
                                <DataGridTextColumn Header="Bills" Binding="{Binding BillsText, Mode=OneWay}" Width="80" />
                                <DataGridTextColumn Header="Sales" Binding="{Binding SalesText, Mode=OneWay}" Width="110" />
                                <DataGridTextColumn Header="Lifetime profit" Binding="{Binding ProfitText, Mode=OneWay}" Width="120" />
                                <DataGridTextColumn Header="Last bill" Binding="{Binding LastBillLabel, Mode=OneWay}" Width="95" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </Border>
            </TabItem>
        </TabControl>

        <!-- ================================ the footer ================================ -->
        <TextBlock Grid.Row="3" Text="{Binding StatusText}" TextWrapping="Wrap" FontSize="11.5"
                   Margin="0,10,0,0">
            <TextBlock.Style>
                <Style TargetType="TextBlock">
                    <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsStatusError}" Value="True">
                            <Setter Property="Foreground" Value="{StaticResource DangerBrush}" />
                            <Setter Property="FontWeight" Value="Bold" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </TextBlock.Style>
        </TextBlock>
    </Grid>
</UserControl>
