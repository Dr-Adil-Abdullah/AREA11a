<UserControl x:Class="Area11.Desktop.Views.PartnersView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:Area11.Desktop.Views">

    <!--
        The merged page (D-50). Three tabs, one menu entry: the people the shop sells to and the
        people it buys from are the same book read from two sides, and udhaar recovery is the page
        that chases the first side. Each tab holds the SAME view the old menu line opened, so no rule
        was copied - only the address changed.
    -->
    <TabControl SelectedIndex="{Binding SelectedTab, Mode=TwoWay}" Background="Transparent" BorderThickness="0">

        <TabItem Header="Customers"
                 Visibility="{Binding HasCustomers, Converter={StaticResource BoolToVis}}">
            <views:CustomersView DataContext="{Binding Customers}" Margin="0,10,0,0" />
        </TabItem>

        <TabItem Header="Udhaar recovery"
                 Visibility="{Binding HasRecovery, Converter={StaticResource BoolToVis}}">
            <views:RecoveryView DataContext="{Binding Recovery}" Margin="0,10,0,0" />
        </TabItem>

        <TabItem Header="Suppliers"
                 Visibility="{Binding HasSuppliers, Converter={StaticResource BoolToVis}}">
            <views:SuppliersView DataContext="{Binding Suppliers}" Margin="0,10,0,0" />
        </TabItem>
    </TabControl>
</UserControl>
