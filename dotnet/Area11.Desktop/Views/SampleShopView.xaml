<UserControl x:Class="Area11.Desktop.Views.SampleShopView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ================================ the heading ================================ -->
        <DockPanel Grid.Row="0" Margin="0,0,0,10">
            <StackPanel DockPanel.Dock="Left" VerticalAlignment="Center">
                <TextBlock Text="Sample shop" Style="{StaticResource PageTitle}" />
                <TextBlock Text="Fill a new Area11 with a believable day's work, so every page has something to show (F-53)."
                           Style="{StaticResource PageSubtitle}" TextWrapping="Wrap" />
            </StackPanel>

            <Button DockPanel.Dock="Right" HorizontalAlignment="Right" VerticalAlignment="Center"
                    Content="Refresh" Style="{StaticResource GhostButton}" Command="{Binding RefreshCommand}" />
        </DockPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <!-- ================================ what will be added ================================ -->
                <Border Style="{StaticResource Card}" Padding="14">
                    <StackPanel>
                        <TextBlock Text="{Binding TitleText}" FontSize="16" FontWeight="Bold" TextWrapping="Wrap" />
                        <TextBlock Text="{Binding SubtitleText}" Style="{StaticResource FieldHint}"
                                   TextWrapping="Wrap" Margin="0,4,0,0" />

                        <TextBlock Text="WHAT WILL BE ADDED" Style="{StaticResource SectionTitle}" Margin="0,12,0,0" />
                        <TextBlock Text="{Binding StepsText}" TextWrapping="Wrap" Margin="0,6,0,0" LineHeight="20" />

                        <DockPanel Margin="0,10,0,0">
                            <TextBlock DockPanel.Dock="Left" Text="IN ALL" Style="{StaticResource MetricLabel}"
                                       VerticalAlignment="Center" Margin="0,0,8,0" />
                            <TextBlock Text="{Binding SummaryText}" FontWeight="SemiBold" VerticalAlignment="Center" />
                        </DockPanel>
                    </StackPanel>
                </Border>

                <!-- ================================ why it may refuse ================================ -->
                <Border Style="{StaticResource Card}" Padding="14" Margin="0,10,0,0"
                        Visibility="{Binding HasProblem, Converter={StaticResource BoolToVis}}">
                    <StackPanel>
                        <TextBlock Text="WHY NOT" Style="{StaticResource SectionTitle}"
                                   Foreground="{StaticResource DangerBrush}" />
                        <TextBlock Text="{Binding ProblemText}" TextWrapping="Wrap" Margin="0,6,0,0"
                                   Foreground="{StaticResource DangerBrush}" />
                    </StackPanel>
                </Border>

                <!-- ================================ the honest warning ================================ -->
                <Border Style="{StaticResource Card}" Padding="14" Margin="0,10,0,0">
                    <StackPanel>
                        <TextBlock Text="BEFORE YOU PRESS" Style="{StaticResource SectionTitle}" />

                        <TextBlock TextWrapping="Wrap" Margin="0,6,0,0" LineHeight="20"
                                   Text="This writes demo money into every page: 44 medicines over 17 categories, six suppliers, twenty customers, and two and a half months of one small shop - about seven hundred bills, khata collections, returns, expenses, a stock-take and seventy-three counted drawers. The names are real Pakistani brands but the numbers are inventions." />

                        <TextBlock TextWrapping="Wrap" Margin="0,6,0,0" LineHeight="20"
                                   Text="It runs only once, and only in a shop that has no bills or purchases. A real shop keeps its own money untouched." />

                        <TextBlock TextWrapping="Wrap" Margin="0,6,0,0" LineHeight="20" FontWeight="SemiBold"
                                   Text="The program never deletes these rows afterwards. To keep a real shop clean, start it as a new shop - or take a backup before pressing, and restore it if you change your mind." />

                        <CheckBox Content="I understand this is demo data for a new shop, and I want it written into this database."
                                  IsChecked="{Binding Confirm, Mode=TwoWay}" Margin="0,12,0,0" />

                        <Button Content="Fill this shop with the sample shop" Style="{StaticResource PrimaryButton}"
                                Command="{Binding SeedCommand}" IsEnabled="{Binding CanPress}"
                                Margin="0,10,0,0" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- ================================ the footer ================================ -->
        <TextBlock Grid.Row="2" Text="{Binding StatusText}" TextWrapping="Wrap" FontSize="11.5" Margin="0,10,0,0">
            <TextBlock.Style>
                <Style TargetType="TextBlock">
                    <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsStatusError}" Value="True">
                            <Setter Property="Foreground" Value="{StaticResource DangerBrush}" />
                            <Setter Property="FontWeight" Value="Bold" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </TextBlock.Style>
        </TextBlock>
    </Grid>
</UserControl>
