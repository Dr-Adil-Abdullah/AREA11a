<UserControl x:Class="Area11.Desktop.Views.RecoveryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" Margin="0,0,0,10">
            <StackPanel DockPanel.Dock="Left" VerticalAlignment="Center">
                <TextBlock Text="Udhaar recovery" Style="{StaticResource PageTitle}" />
                <TextBlock Text="Whose money is oldest. Payments knock the oldest bill off first."
                           Style="{StaticResource PageSubtitle}" />
            </StackPanel>

            <Button DockPanel.Dock="Right" HorizontalAlignment="Right" VerticalAlignment="Center"
                    Content="Refresh" Style="{StaticResource GhostButton}" Command="{Binding RefreshCommand}" />
        </DockPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="14" />
                <ColumnDefinition Width="360" />
            </Grid.ColumnDefinitions>

            <!-- ================================ the list ================================ -->
            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Style="{StaticResource Card}" Padding="14" Margin="0,0,0,10"
                        Visibility="{Binding IsNotAllowed, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="This page needs the Customers permission. Ask the owner to switch it on for this login in Settings - Staff."
                               TextWrapping="Wrap" Foreground="{StaticResource WarningBrush}" />
                </Border>

                <!-- four age columns, the whole shop in one line -->
                <Border Grid.Row="1" Style="{StaticResource Card}" Padding="14" Margin="0,0,0,10"
                        Visibility="{Binding CanRead, Converter={StaticResource BoolToVis}}">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="TOTAL UDHAAR" Style="{StaticResource FieldHint}" />
                                <TextBlock Text="{Binding TotalText}" FontSize="20" FontWeight="Bold"
                                           Foreground="{StaticResource BrandBrush}" />
                                <TextBlock Text="{Binding CountText}" Style="{StaticResource FieldHint}" />
                                <TextBlock Text="{Binding OpeningText}" Style="{StaticResource FieldHint}"
                                           Foreground="{StaticResource BrandDarkBrush}"
                                           Visibility="{Binding HasOpeningTotal, Converter={StaticResource BoolToVis}}" />
                            </StackPanel>

                            <StackPanel Grid.Column="1">
                                <TextBlock Text="0-30 DAYS" Style="{StaticResource FieldHint}" />
                                <TextBlock Text="{Binding Bucket0Text}" FontSize="15" />
                            </StackPanel>

                            <StackPanel Grid.Column="2">
                                <TextBlock Text="31-60 DAYS" Style="{StaticResource FieldHint}" />
                                <TextBlock Text="{Binding Bucket1Text}" FontSize="15" />
                            </StackPanel>

                            <StackPanel Grid.Column="3">
                                <TextBlock Text="61-90 DAYS" Style="{StaticResource FieldHint}" />
                                <TextBlock Text="{Binding Bucket2Text}" FontSize="15"
                                           Foreground="{StaticResource WarningBrush}" />
                            </StackPanel>

                            <StackPanel Grid.Column="4">
                                <TextBlock Text="90+ DAYS" Style="{StaticResource FieldHint}" />
                                <TextBlock Text="{Binding Bucket3Text}" FontSize="15" FontWeight="Bold"
                                           Foreground="{StaticResource DangerBrush}" />
                            </StackPanel>
                        </Grid>

                        <Border Background="{StaticResource SurfaceBrush}" CornerRadius="6" Padding="10,6" Margin="0,10,0,0">
                            <TextBlock TextWrapping="Wrap" FontSize="11.5">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding BooksMatch}" Value="False">
                                                <Setter Property="Foreground" Value="{StaticResource DangerBrush}" />
                                                <Setter Property="FontWeight" Value="Bold" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                                <Run Text="{Binding BooksLabel, Mode=OneWay}" />
                            </TextBlock>
                        </Border>
                    </StackPanel>
                </Border>

                <Border Grid.Row="2" Style="{StaticResource Card}" Padding="12">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <DockPanel Grid.Row="0" Margin="0,0,0,8">
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                <CheckBox Content="Only over two months" IsChecked="{Binding OnlyOverdue, Mode=TwoWay}"
                                          VerticalAlignment="Center" />
                            </StackPanel>

                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Find" VerticalAlignment="Center" Margin="0,0,8,0"
                                           Foreground="{StaticResource MutedBrush}" />
                                <TextBox Width="220" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                         ToolTip="Name or phone" />
                            </StackPanel>
                        </DockPanel>

                        <DataGrid Grid.Row="1" ItemsSource="{Binding Rows}" SelectedItem="{Binding Selected, Mode=TwoWay}"
                                  IsReadOnly="True" AutoGenerateColumns="False" HeadersVisibility="Column"
                                  GridLinesVisibility="Horizontal">
                            <DataGrid.RowStyle>
                                <Style TargetType="DataGridRow">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding AgeTone}" Value="late">
                                            <Setter Property="Background" Value="{StaticResource WarningSoftBrush}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding AgeTone}" Value="old">
                                            <Setter Property="Background" Value="{StaticResource DangerSoftBrush}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding BooksMatch}" Value="False">
                                            <Setter Property="Foreground" Value="{StaticResource DangerBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </DataGrid.RowStyle>
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Customer" Binding="{Binding Name}" Width="1.6*" />
                                <DataGridTextColumn Header="Phone" Binding="{Binding PhoneLabel, Mode=OneWay}" Width="120" />
                                <DataGridTextColumn Header="Udhaar" Binding="{Binding BalanceText, Mode=OneWay}" Width="100" />
                                <DataGridTextColumn Header="Oldest" Binding="{Binding OldestLabel, Mode=OneWay}" Width="150" />
                                <DataGridTextColumn Header="0-30" Binding="{Binding Bucket0Text, Mode=OneWay}" Width="85" />
                                <DataGridTextColumn Header="31-60" Binding="{Binding Bucket1Text, Mode=OneWay}" Width="85" />
                                <DataGridTextColumn Header="61-90" Binding="{Binding Bucket2Text, Mode=OneWay}" Width="85" />
                                <DataGridTextColumn Header="90+" Binding="{Binding Bucket3Text, Mode=OneWay}" Width="85" />
                                <DataGridTextColumn Header="Carried in" Binding="{Binding OpeningLabel, Mode=OneWay}" Width="95" />
                                <DataGridTextColumn Header="Last paid" Binding="{Binding LastPaymentLabel, Mode=OneWay}" Width="100" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </Border>
            </Grid>

            <!-- ============================== take the money ============================== -->
            <Border Grid.Column="2" Style="{StaticResource Card}" Padding="16"
                    Visibility="{Binding CanRead, Converter={StaticResource BoolToVis}}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="Money received" Style="{StaticResource SectionTitle}" />
                        <TextBlock Text="{Binding CustomerText}" FontSize="14" FontWeight="SemiBold" TextWrapping="Wrap"
                                   Margin="0,6,0,0" />
                        <TextBlock Text="{Binding PhoneText}" Style="{StaticResource FieldHint}" />
                        <TextBlock Text="{Binding BalanceText}" FontSize="18" FontWeight="Bold" Margin="0,6,0,0" />
                        <TextBlock Text="{Binding AgeText}" Style="{StaticResource FieldHint}" TextWrapping="Wrap" />

                        <TextBlock Text="Amount received (Rs)" Style="{StaticResource FieldLabel}" Margin="0,14,0,0" />
                        <TextBox Text="{Binding AmountText, UpdateSourceTrigger=PropertyChanged}" Width="200"
                                 HorizontalAlignment="Left" />

                        <TextBlock Text="Method" Style="{StaticResource FieldLabel}" Margin="0,10,0,0" />
                        <ComboBox ItemsSource="{Binding Methods}" SelectedItem="{Binding Method, Mode=TwoWay}"
                                  Width="200" HorizontalAlignment="Left" />

                        <TextBlock Text="Note (optional)" Style="{StaticResource FieldLabel}" Margin="0,10,0,0" />
                        <TextBox Text="{Binding Note, UpdateSourceTrigger=PropertyChanged}" />

                        <Button Content="Receive and print" Style="{StaticResource PrimaryButton}" Margin="0,14,0,0"
                                Command="{Binding ReceiveCommand}" />

                        <Button Content="Print slip again" Style="{StaticResource GhostButton}" Margin="0,8,0,0"
                                Command="{Binding SlipCommand}" IsEnabled="{Binding HasLastSlip}" />

                        <TextBlock Text="{Binding AutoPrintHint}" Style="{StaticResource FieldHint}" Margin="0,10,0,0"
                                   TextWrapping="Wrap" />

                        <Border Background="{StaticResource WarningSoftBrush}" CornerRadius="8" Padding="12" Margin="0,14,0,0">
                            <TextBlock TextWrapping="Wrap" FontSize="11.5" Foreground="{StaticResource WarningBrush}"
                                       Text="The payment carries a permanent PAY number and is written into the black box. A wrong amount is corrected by a second entry, never by editing this one." />
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <Border Grid.Row="2" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource LineBrush}"
                BorderThickness="1" CornerRadius="8" Padding="12,8" Margin="0,10,0,0">
            <TextBlock Text="{Binding StatusText}" TextWrapping="Wrap">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="FontSize" Value="12" />
                        <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsStatusError}" Value="True">
                                <Setter Property="Foreground" Value="{StaticResource DangerBrush}" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
        </Border>
    </Grid>
</UserControl>
