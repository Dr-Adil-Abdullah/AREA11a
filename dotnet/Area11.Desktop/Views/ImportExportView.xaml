<UserControl x:Class="Area11.Desktop.Views.ImportExportView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,10">
            <TextBlock Text="{DynamicResource AppLabel.importExport}" Style="{StaticResource PageTitle}" />
            <TextBlock Text="Bring the old stock list and khata in, download real Excel workbooks, update rows with a before → after preview, or change prices — nothing is written until you press the button."
                       Style="{StaticResource PageSubtitle}" />
        </StackPanel>

        <TabControl Grid.Row="1" SelectedIndex="{Binding SelectedTabIndex, Mode=TwoWay}">

            <!-- ============================== 1. IMPORT ============================== -->
            <TabItem Header="Import">
                <Grid Margin="0,10,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Style="{StaticResource Card}" Padding="16">
                        <StackPanel>
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Left" Text="What are you bringing in?"
                                           Style="{StaticResource SectionTitle}" VerticalAlignment="Center" />

                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
                                    <Button Content="Save a blank template" Style="{StaticResource GhostButton}"
                                            Margin="0,0,8,0" Command="{Binding SaveTemplateCommand}" />
                                    <Button Content="Choose the file…" Style="{StaticResource PrimaryButton}"
                                            Command="{Binding ChooseFileCommand}" />
                                </StackPanel>
                            </DockPanel>

                            <ComboBox ItemsSource="{Binding Kinds}" SelectedItem="{Binding Kind, Mode=TwoWay}"
                                      Width="200" HorizontalAlignment="Left" Margin="0,10,0,0" />

                            <TextBlock Text="{Binding KindHint}" Style="{StaticResource FieldHint}"
                                       TextWrapping="Wrap" Margin="0,8,0,0" />

                            <TextBlock Text="{Binding FileNameText}" Margin="0,10,0,0"
                                       Foreground="{StaticResource TextBrush}" FontWeight="SemiBold" />
                        </StackPanel>
                    </Border>

                    <Border Grid.Row="1" Style="{StaticResource Card}" Padding="0" Margin="0,10,0,0">
                        <Grid>
                            <ListBox ItemsSource="{Binding Rows}" BorderThickness="0" Background="Transparent"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <DockPanel Margin="4,5">
                                            <!-- The badge is the whole point of the preview: the owner
                                                 scans the column of colours, not 200 lines of text. -->
                                            <Border DockPanel.Dock="Left" Width="64" CornerRadius="4"
                                                    Padding="0,3" Margin="0,0,10,0">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Background" Value="{StaticResource BrandSoftBrush}" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsSkipped}" Value="True">
                                                                <Setter Property="Background" Value="{StaticResource WarningSoftBrush}" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding IsError}" Value="True">
                                                                <Setter Property="Background" Value="{StaticResource DangerSoftBrush}" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <TextBlock Text="{Binding StateLabel}" FontSize="10" FontWeight="SemiBold"
                                                           HorizontalAlignment="Center">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Foreground" Value="{StaticResource BrandDarkBrush}" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsSkipped}" Value="True">
                                                                    <Setter Property="Foreground" Value="{StaticResource WarningBrush}" />
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding IsError}" Value="True">
                                                                    <Setter Property="Foreground" Value="{StaticResource DangerBrush}" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </Border>

                                            <TextBlock Text="{Binding Caption}" FontSize="11.5"
                                                       Foreground="{StaticResource TextBrush}"
                                                       TextTrimming="CharacterEllipsis" />
                                        </DockPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>

                            <TextBlock Text="{Binding PreviewText}" Style="{StaticResource FieldHint}"
                                       TextWrapping="Wrap" MaxWidth="460" Margin="24"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Visibility="{Binding HasNoPreview, Converter={StaticResource BoolToVis}}" />
                        </Grid>
                    </Border>

                    <DockPanel Grid.Row="2" Margin="0,10,0,0">
                        <Button DockPanel.Dock="Right" Content="Import" Style="{StaticResource PrimaryButton}"
                                Command="{Binding ImportCommand}" />
                        <Button DockPanel.Dock="Right" Content="Clear" Style="{StaticResource GhostButton}"
                                Margin="0,0,8,0" Command="{Binding ClearCommand}" />
                        <TextBlock Text="{Binding PreviewText}" Style="{StaticResource FieldHint}"
                                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                    </DockPanel>
                </Grid>
            </TabItem>

            <!-- ============================== 2. EXPORT ============================== -->
            <TabItem Header="Export">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="0,10,0,0">

                        <Border Style="{StaticResource Card}" Padding="16">
                            <StackPanel>
                                <TextBlock Text="Take the lists out" Style="{StaticResource SectionTitle}" />
                                <TextBlock Text="Each button writes a real .xlsx workbook with the names and rupee amounts as they are on the screen. No package or Excel installation is needed. Photos are not included — they travel in the backup zip."
                                           Style="{StaticResource FieldHint}" TextWrapping="Wrap" />

                                <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                                    <Button Content="Medicines and stock" Style="{StaticResource PrimaryButton}"
                                            Margin="0,0,8,0" Command="{Binding ExportProductsCommand}" />
                                    <Button Content="Customers and udhaar" Style="{StaticResource GhostButton}"
                                            Margin="0,0,8,0" Command="{Binding ExportCustomersCommand}" />
                                    <Button Content="Suppliers and payable" Style="{StaticResource GhostButton}"
                                            Command="{Binding ExportSuppliersCommand}" />
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}" Padding="16">
                            <StackPanel>
                                <TextBlock Text="Workbook or CSV — both are accepted for new records" Style="{StaticResource SectionTitle}" />
                                <TextBlock Text="Save a blank template to get Products, Customers, Suppliers and Instructions in one .xlsx file. Fill the matching sheet and choose it on the Import tab. An existing CSV UTF-8 still works too: open the old list in Excel, File → Save As → CSV UTF-8, then choose that file. Duplicate and opening-stock rules are identical for both formats."
                                           Style="{StaticResource FieldHint}" TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ============================== 3. BULK UPDATE ============================== -->
            <TabItem Header="Bulk update">
                <Grid Margin="0,10,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Style="{StaticResource Card}" Padding="16">
                        <StackPanel>
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Left" Text="Download, edit, check, then apply"
                                           Style="{StaticResource SectionTitle}" VerticalAlignment="Center" />
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
                                    <Button Content="Download your data" Style="{StaticResource GhostButton}"
                                            Margin="0,0,8,0" Command="{Binding DownloadAllCommand}" />
                                    <Button Content="Choose edited workbook…" Style="{StaticResource PrimaryButton}"
                                            Command="{Binding ChooseBulkFileCommand}" />
                                </StackPanel>
                            </DockPanel>

                            <TextBlock Margin="0,10,0,0" Style="{StaticResource FieldHint}" TextWrapping="Wrap"
                                       Text="The workbook contains Products, Customers, Suppliers, Categories, Companies, Batches, Settings and Instructions — without photos. Empty cell = no change; type __CLEAR__ to clear an allowed value. Stock, balances, secrets and numbering counters stay protected." />
                            <CheckBox Margin="0,10,0,0" IsChecked="{Binding IncludeSettings, Mode=TwoWay}"
                                      Content="Include Settings changes (separate confirmation; JSON types are preserved)" />
                            <TextBlock Text="{Binding BulkFileNameText}" Margin="0,10,0,0"
                                       Foreground="{StaticResource TextBrush}" FontWeight="SemiBold" />
                        </StackPanel>
                    </Border>

                    <Border Grid.Row="1" Style="{StaticResource Card}" Padding="0" Margin="0,10,0,0">
                        <Grid>
                            <ListBox ItemsSource="{Binding BulkRows}" BorderThickness="0" Background="Transparent"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <DockPanel Margin="4,5">
                                            <Border DockPanel.Dock="Left" Width="64" CornerRadius="4"
                                                    Padding="0,3" Margin="0,0,10,0" VerticalAlignment="Top">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Background" Value="{StaticResource BrandSoftBrush}" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsSkipped}" Value="True">
                                                                <Setter Property="Background" Value="{StaticResource WarningSoftBrush}" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding IsError}" Value="True">
                                                                <Setter Property="Background" Value="{StaticResource DangerSoftBrush}" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <TextBlock Text="{Binding StateLabel}" FontSize="10" FontWeight="SemiBold"
                                                           HorizontalAlignment="Center">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Foreground" Value="{StaticResource BrandDarkBrush}" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsSkipped}" Value="True">
                                                                    <Setter Property="Foreground" Value="{StaticResource WarningBrush}" />
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding IsError}" Value="True">
                                                                    <Setter Property="Foreground" Value="{StaticResource DangerBrush}" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </Border>
                                            <TextBlock Text="{Binding Caption}" FontSize="11.5" TextWrapping="Wrap"
                                                       Foreground="{StaticResource TextBrush}" />
                                        </DockPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>

                            <TextBlock Text="{Binding BulkSummary}" Style="{StaticResource FieldHint}"
                                       TextWrapping="Wrap" MaxWidth="520" Margin="24"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Visibility="{Binding HasNoBulkPreview, Converter={StaticResource BoolToVis}}" />
                        </Grid>
                    </Border>

                    <DockPanel Grid.Row="2" Margin="0,10,0,0">
                        <Button DockPanel.Dock="Right" Content="Apply these changes" Style="{StaticResource PrimaryButton}"
                                Command="{Binding ApplyBulkCommand}" IsEnabled="{Binding CanApplyBulk}" />
                        <Button DockPanel.Dock="Right" Content="Clear" Style="{StaticResource GhostButton}"
                                Margin="0,0,8,0" Command="{Binding ClearBulkCommand}" />
                        <TextBlock Text="{Binding BulkSummary}" Style="{StaticResource FieldHint}"
                                   VerticalAlignment="Center" TextWrapping="Wrap" />
                    </DockPanel>
                </Grid>
            </TabItem>

            <!-- ============================== 4. PRICES ============================== -->
            <TabItem Header="Prices">
                <Grid Margin="0,10,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Style="{StaticResource Card}" Padding="16">
                        <StackPanel>
                            <TextBlock Text="Change many prices at once" Style="{StaticResource SectionTitle}" />

                            <Grid Margin="0,10,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="120" />
                                    <ColumnDefinition Width="12" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <RadioButton Grid.Row="0" Grid.Column="0" Content="Percent" GroupName="kind"
                                             IsChecked="{Binding IsPercent, Mode=TwoWay}" Margin="0,0,10,0"
                                             VerticalAlignment="Center" />
                                <RadioButton Grid.Row="1" Grid.Column="0" Content="Rupees" GroupName="kind"
                                             IsChecked="{Binding IsRupees, Mode=TwoWay}" Margin="0,8,10,0"
                                             VerticalAlignment="Center" />

                                <TextBox Grid.Row="0" Grid.Column="1" Width="110"
                                         Text="{Binding PriceAmountText, UpdateSourceTrigger=PropertyChanged}"
                                         HorizontalAlignment="Left" />
                                <ComboBox Grid.Row="1" Grid.Column="1" Width="110" Margin="0,8,0,0"
                                          ItemsSource="{Binding Categories}"
                                          SelectedItem="{Binding PriceCategory, Mode=TwoWay}"
                                          DisplayMemberPath="Name" />

                                <TextBlock Grid.Row="0" Grid.Column="3" Text="{Binding AmountHint}"
                                           Style="{StaticResource FieldHint}" TextWrapping="Wrap"
                                           VerticalAlignment="Center" />
                                <CheckBox Grid.Row="1" Grid.Column="3" Margin="0,8,0,0"
                                          Content="Change the purchase cost too (the supplier raised his rates)"
                                          IsChecked="{Binding IncludeCost, Mode=TwoWay}" />
                            </Grid>

                            <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                                <Button Content="Preview" Style="{StaticResource PrimaryButton}"
                                        Command="{Binding PreviewPricesCommand}" />
                                <Button Content="Apply these prices" Style="{StaticResource GhostButton}"
                                        Margin="10,0,0,0" Command="{Binding ApplyPricesCommand}" />
                            </StackPanel>

                            <TextBlock Text="{Binding PriceSummary}" Style="{StaticResource FieldHint}"
                                       TextWrapping="Wrap" Margin="0,8,0,0" />
                        </StackPanel>
                    </Border>

                    <Border Grid.Row="1" Style="{StaticResource Card}" Padding="0" Margin="0,10,0,0">
                        <Grid>
                            <ListBox ItemsSource="{Binding PriceRows}" BorderThickness="0" Background="Transparent"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="4,6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>

                                            <TextBlock Grid.Row="0" Grid.Column="0" Text="{Binding Name}"
                                                       FontSize="12" FontWeight="SemiBold"
                                                       Foreground="{StaticResource TextBrush}"
                                                       TextTrimming="CharacterEllipsis" />

                                            <TextBlock Grid.Row="1" Grid.Column="0" Text="{Binding RetailLabel}"
                                                       FontSize="11" Foreground="{StaticResource MutedBrush}" />

                                            <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding ChangeLabel}"
                                                       FontSize="11" FontWeight="SemiBold" HorizontalAlignment="Right"
                                                       Foreground="{StaticResource BrandDarkBrush}" />

                                            <TextBlock Grid.Row="1" Grid.Column="1" Text="below cost - refused"
                                                       FontSize="10" HorizontalAlignment="Right"
                                                       Foreground="{StaticResource DangerBrush}"
                                                       Visibility="{Binding BelowCost, Converter={StaticResource BoolToVis}}" />
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>

                            <TextBlock Text="Nothing to preview yet." Style="{StaticResource FieldHint}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Visibility="{Binding HasNoPriceRows, Converter={StaticResource BoolToVis}}" />
                        </Grid>
                    </Border>
                </Grid>
            </TabItem>
        </TabControl>

        <!-- One status line for all three tabs. -->
        <Border Grid.Row="2" Margin="0,10,0,0" CornerRadius="6" Padding="10,8">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Background" Value="{StaticResource BrandSoftBrush}" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsStatusError}" Value="True">
                            <Setter Property="Background" Value="{StaticResource DangerSoftBrush}" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <TextBlock Text="{Binding StatusText}" TextWrapping="Wrap" FontSize="11.5">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Foreground" Value="{StaticResource BrandDarkBrush}" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsStatusError}" Value="True">
                                <Setter Property="Foreground" Value="{StaticResource DangerBrush}" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
        </Border>
    </Grid>
</UserControl>
