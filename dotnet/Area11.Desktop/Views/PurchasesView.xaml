<UserControl x:Class="Area11.Desktop.Views.PurchasesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:Area11.Desktop.Views">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" Margin="0,0,0,12">
            <StackPanel DockPanel.Dock="Left" VerticalAlignment="Center">
                <TextBlock Text="{DynamicResource AppLabel.purchases}" Style="{StaticResource PageTitle}" />
                <TextBlock Text="PINV bill · batch and expiry · sample at zero cost · supplier payable"
                           Style="{StaticResource PageSubtitle}" />
            </StackPanel>
            <Button Content="Refresh" Style="{StaticResource GhostButton}" HorizontalAlignment="Right"
                    VerticalAlignment="Center" Command="{Binding RefreshCommand}" />
        </DockPanel>

        <Border Grid.Row="1" Style="{StaticResource Card}" Padding="12" Margin="0,0,0,12">
            <StackPanel>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.6*" />
                    <ColumnDefinition Width="10" />
                    <ColumnDefinition Width="1*" />
                    <ColumnDefinition Width="10" />
                    <ColumnDefinition Width="1*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="Supplier" Style="{StaticResource FieldLabel}" Margin="0,0,0,3" />
                    <ComboBox ItemsSource="{Binding Suppliers}" DisplayMemberPath="Name"
                              SelectedItem="{Binding SelectedSupplier, Mode=TwoWay}" />
                </StackPanel>

                <StackPanel Grid.Column="2">
                    <TextBlock Text="New supplier" Style="{StaticResource FieldLabel}" Margin="0,0,0,3" />
                    <TextBox Text="{Binding NewSupplierName, UpdateSourceTrigger=PropertyChanged}" />
                </StackPanel>

                <StackPanel Grid.Column="4">
                    <TextBlock Text="Phone" Style="{StaticResource FieldLabel}" Margin="0,0,0,3" />
                    <TextBox Text="{Binding NewSupplierPhone, UpdateSourceTrigger=PropertyChanged}" />
                </StackPanel>

                <Button Grid.Column="5" Content="Add supplier" Style="{StaticResource GhostButton}"
                        VerticalAlignment="Bottom" Margin="8,0,0,0" Command="{Binding AddSupplierCommand}" />
            </Grid>
            <Expander Header="New supplier agency and extra fields" Margin="0,8,0,0">
                <StackPanel>
                    <TextBlock Text="Agency" Style="{StaticResource FieldLabel}" />
                    <TextBox Text="{Binding NewSupplierAgency, UpdateSourceTrigger=PropertyChanged}" />
                    <views:CustomFieldsEditorView DataContext="{Binding NewSupplierEditor}" />
                </StackPanel>
            </Expander>
            </StackPanel>
        </Border>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.1*" />
                <ColumnDefinition Width="14" />
                <ColumnDefinition Width="1.3*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource Card}" Padding="12">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="Add a delivery line" Style="{StaticResource SectionTitle}" />

                        <TextBlock Text="Search product" Style="{StaticResource FieldLabel}" />
                        <TextBox Text="{Binding ProductSearch, UpdateSourceTrigger=PropertyChanged}"
                                 ToolTip="Name, pack / variant, strength, salt, barcode, brand, rack, category or company" />
                        <ComboBox Margin="0,5,0,0" ItemsSource="{Binding FilteredProducts}"
                                  DisplayMemberPath="ProductChoiceLabel" SelectedItem="{Binding SelectedProduct, Mode=TwoWay}"
                                  ToolTip="Strength and pack text distinguish variants; each selection remains its original product." />

                        <Grid Margin="0,4,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="8" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Unit" Style="{StaticResource FieldLabel}" />
                                <ComboBox ItemsSource="{Binding Units}" SelectedItem="{Binding Unit, Mode=TwoWay}" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Quantity" Style="{StaticResource FieldLabel}" />
                                <TextBox Text="{Binding Quantity, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                        </Grid>

                        <Grid Margin="0,4,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="8" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Batch number" Style="{StaticResource FieldLabel}" />
                                <TextBox Text="{Binding BatchNo, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Expiry" Style="{StaticResource FieldLabel}" />
                                <TextBox Text="{Binding Expiry, UpdateSourceTrigger=PropertyChanged}"
                                         ToolTip="Type it as printed: 2027-06, 06/27 or 2027-06-30. Blank means no expiry." />
                                <Grid Margin="0,4,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="4" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <ComboBox Grid.Column="0" ItemsSource="{Binding ExpiryMonths}"
                                              SelectedItem="{Binding SelectedExpiryMonth, Mode=TwoWay}"
                                              DisplayMemberPath="Label"
                                              ToolTip="Pick the month printed on the strip." />
                                    <ComboBox Grid.Column="2" ItemsSource="{Binding ExpiryYears}" Width="76"
                                              SelectedItem="{Binding SelectedExpiryYear, Mode=TwoWay}"
                                              ToolTip="Pick the year printed on the strip." />
                                </Grid>
                                <DatePicker SelectedDate="{Binding PickedExpiryDate, Mode=TwoWay}"
                                            Margin="0,4,0,0" HorizontalAlignment="Left"
                                            ToolTip="Calendar for an exact printed day. The month boxes above cover the usual strip form." />
                                <TextBlock Text="{Binding ExpiryHint}" TextWrapping="Wrap" FontSize="11" Margin="0,4,0,0">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsExpiryHintError}" Value="True">
                                                    <Setter Property="Foreground" Value="{StaticResource DangerBrush}" />
                                                    <Setter Property="FontWeight" Value="Bold" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>
                        </Grid>

                        <Grid Margin="0,4,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="8" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Cost (Rs)" Style="{StaticResource FieldLabel}" />
                                <TextBox Text="{Binding CostText, Mode=OneWay}" IsReadOnly="True" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Retail (Rs)" Style="{StaticResource FieldLabel}" />
                                <TextBox Text="{Binding RetailText, Mode=OneWay}" IsReadOnly="True" />
                            </StackPanel>
                        </Grid>

                        <CheckBox Content="Sample / bonus line (stock in, cost 0)"
                                  IsChecked="{Binding IsSample}" Margin="0,10,0,0" />

                        <Button Content="Add line" Style="{StaticResource PrimaryButton}" Margin="0,10,0,0"
                                Command="{Binding AddLineCommand}" />
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <Border Grid.Column="2" Style="{StaticResource Card}" Padding="12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <DockPanel Grid.Row="0" Margin="0,0,0,8">
                        <TextBlock Text="Delivery lines" Style="{StaticResource SectionTitle}" VerticalAlignment="Center" />
                        <Button Content="Remove last" Style="{StaticResource GhostButton}" HorizontalAlignment="Right"
                                Command="{Binding RemoveLineCommand}" />
                    </DockPanel>

                    <DataGrid Grid.Row="1" ItemsSource="{Binding Lines}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Item" Binding="{Binding ProductName, Mode=OneWay}" Width="2*" />
                            <DataGridTextColumn Header="Qty" Binding="{Binding QuantityText, Mode=OneWay}" Width="90" />
                            <DataGridTextColumn Header="Batch" Binding="{Binding BatchNo, Mode=OneWay}" Width="*" />
                            <DataGridTextColumn Header="Expiry" Binding="{Binding Expiry, Mode=OneWay}" Width="90" />
                            <DataGridTextColumn Header="Cost" Binding="{Binding CostText, Mode=OneWay}" Width="90" />
                        </DataGrid.Columns>
                    </DataGrid>

                    <StackPanel Grid.Row="2" Margin="0,10,0,0">
                        <TextBlock Text="PURCHASE TOTAL" Style="{StaticResource MetricLabel}" />
                        <TextBlock Text="{Binding TotalText}" FontSize="24" FontWeight="Bold"
                                   Foreground="{StaticResource BrandBrush}" />

                        <TextBlock Text="Paid now (Rs)" Style="{StaticResource FieldLabel}" />
                        <TextBox Text="{Binding PaidText, UpdateSourceTrigger=PropertyChanged}" />

                        <Button Content="Save purchase (PINV)" Style="{StaticResource PrimaryButton}" Height="38"
                                Margin="0,10,0,0" Command="{Binding SaveCommand}" />

                        <TextBlock Text="Showing an open draft. Save the purchase to post it."
                                   Style="{StaticResource FieldHint}" Margin="0,8,0,0" TextWrapping="Wrap"
                                   Visibility="{Binding HasOpenDraft, Converter={StaticResource BoolToVis}}" />
                        <Button Content="Save as draft" Style="{StaticResource GhostButton}"
                                Margin="0,6,0,0" Command="{Binding SaveDraftCommand}"
                                ToolTip="Park this delivery as a shared draft. Nothing is bought; anyone with the purchase permission can open and post it." />
                        <Button Content="Open drafts" Style="{StaticResource GhostButton}"
                                Margin="0,6,0,0" Command="{Binding DraftsCommand}"
                                ToolTip="Open, post or discard shared purchase drafts." />

                        <TextBlock Text="{Binding StatusMessage}" FontSize="11" TextWrapping="Wrap" Margin="0,10,0,0">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsStatusError}" Value="True">
                                            <Setter Property="Foreground" Value="{StaticResource DangerBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
