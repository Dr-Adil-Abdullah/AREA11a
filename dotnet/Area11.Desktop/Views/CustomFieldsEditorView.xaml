<UserControl x:Class="Area11.Desktop.Views.CustomFieldsEditorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- The panel draws nothing until the form really has fields (Spec 8.4.3): a shop that has never
         made one sees exactly the screen it saw before. -->
    <Border Style="{StaticResource Card}" Padding="14" Margin="0,10,0,0"
            Visibility="{Binding HasFields, Converter={StaticResource BoolToVis}}">
        <StackPanel>
            <DockPanel>
                <StackPanel DockPanel.Dock="Left">
                    <TextBlock Text="{DynamicResource AppLabel.customFields}" Style="{StaticResource SectionTitle}" />
                    <TextBlock Text="{Binding Subtitle}" Style="{StaticResource FieldHint}" TextWrapping="Wrap" />
                </StackPanel>

                <Button DockPanel.Dock="Right" HorizontalAlignment="Right" VerticalAlignment="Center"
                        Content="Save extra fields" Style="{StaticResource PrimaryButton}"
                        Command="{Binding SaveCommand}" IsEnabled="{Binding CanEdit}"
                        Visibility="{Binding ShowSeparateSave, Converter={StaticResource BoolToVis}}" />
            </DockPanel>

            <ItemsControl ItemsSource="{Binding Rows}" Margin="0,4,0,0">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Margin="0,8,0,0">
                            <TextBlock Text="{Binding Label}" Style="{StaticResource FieldLabel}" />

                            <!-- text, number, amount and date share one box; the service decides what
                                 each one may contain -->
                            <TextBox Text="{Binding Text, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     Visibility="{Binding IsPlain, Converter={StaticResource BoolToVis}}" />

                            <DatePicker SelectedDate="{Binding PickedDate, Mode=TwoWay}"
                                        Visibility="{Binding IsDate, Converter={StaticResource BoolToVis}}"
                                        ToolTip="Pick a date from the calendar, or type it in the box above. Clear the box to remove it."
                                        HorizontalAlignment="Left" Margin="0,4,0,0" />

                            <ComboBox ItemsSource="{Binding Options}"
                                      SelectedItem="{Binding Text, Mode=TwoWay}"
                                      Visibility="{Binding IsSelect, Converter={StaticResource BoolToVis}}" />

                            <CheckBox Content="Yes" IsChecked="{Binding BoolValue, Mode=TwoWay}"
                                      Visibility="{Binding IsCheck, Converter={StaticResource BoolToVis}}" />

                            <TextBlock Text="{Binding Hint}" Style="{StaticResource FieldHint}" TextWrapping="Wrap" />
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- New record with a photo field: the picture is chosen here and saved together
                 with the record. Existing records use their photo gallery instead. -->
            <StackPanel Visibility="{Binding ShowStagedPhoto, Converter={StaticResource BoolToVis}}"
                        Margin="0,8,0,0">
                <TextBlock Text="Photo for this new record" Style="{StaticResource FieldLabel}" />
                <StackPanel Orientation="Horizontal">
                    <Button Content="Choose…" Command="{Binding ChooseStagedPhotoCommand}"
                            IsEnabled="{Binding CanEdit}" Style="{StaticResource GhostButton}"
                            Padding="12,4" />
                    <Button Content="Clear" Command="{Binding ClearStagedPhotoCommand}"
                            IsEnabled="{Binding CanEdit}" Style="{StaticResource GhostButton}"
                            Padding="12,4" Margin="6,0,0,0"
                            Visibility="{Binding HasStagedPhoto, Converter={StaticResource BoolToVis}}" />
                    <TextBlock Text="{Binding StagedPhotoName}" Style="{StaticResource FieldHint}"
                               VerticalAlignment="Center" Margin="8,0,0,0" TextTrimming="CharacterEllipsis" />
                </StackPanel>
            </StackPanel>

            <TextBlock Text="Only the owner or a manager may fill these fields." Style="{StaticResource FieldHint}"
                       Visibility="{Binding IsReadOnly, Converter={StaticResource BoolToVis}}"
                       Margin="0,8,0,0" />

            <TextBlock Text="{Binding StatusText}" TextWrapping="Wrap" FontSize="11.5" Margin="0,8,0,0"
                       Visibility="{Binding HasStatus, Converter={StaticResource BoolToVis}}">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsStatusError}" Value="True">
                                <Setter Property="Foreground" Value="{StaticResource DangerBrush}" />
                                <Setter Property="FontWeight" Value="Bold" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
        </StackPanel>
    </Border>
</UserControl>
