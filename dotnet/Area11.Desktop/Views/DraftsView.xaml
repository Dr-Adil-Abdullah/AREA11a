<Window Icon="{DynamicResource Area11WindowIcon}" x:Class="Area11.Desktop.Views.DraftsView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{Binding WindowTitle}" Height="560" Width="760"
        MinHeight="440" MinWidth="620" WindowStartupLocation="CenterOwner"
        Background="{StaticResource CanvasBrush}">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,12">
            <TextBlock Text="{Binding Title}" Style="{StaticResource PageTitle}" />
            <TextBlock Text="{Binding Subtitle}" Style="{StaticResource PageSubtitle}" TextWrapping="Wrap" />
        </StackPanel>

        <Border Grid.Row="1" Style="{StaticResource Card}" Padding="12">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <ListBox Grid.Row="0" ItemsSource="{Binding Drafts}" SelectedItem="{Binding Selected, Mode=TwoWay}">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Margin="0,6">
                                <TextBlock Text="{Binding Headline}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                <TextBlock Style="{StaticResource FieldHint}" TextWrapping="Wrap">
                                    <Run Text="Saved by " /><Run Text="{Binding CreatedByName}" /><Run Text=" · " /><Run Text="{Binding UpdatedAt}" />
                                </TextBlock>
                                <TextBlock Text="Post was interrupted - verify its document, then discard this row."
                                           Foreground="{StaticResource DangerBrush}" FontWeight="SemiBold"
                                           Visibility="{Binding NeedsPostCheck, Converter={StaticResource BoolToVis}}" />
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <TextBlock Grid.Row="0" Text="No open draft." Style="{StaticResource FieldHint}"
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           Visibility="{Binding HasNoDraft, Converter={StaticResource BoolToVis}}" />

                <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,10,0,0">
                    <Button Content="Open on the page" Style="{StaticResource PrimaryButton}"
                            Command="{Binding OpenCommand}" IsEnabled="{Binding HasSelection}" Padding="14,6" />
                    <Button Content="Post now" Style="{StaticResource GhostButton}" Margin="8,0,0,0"
                            Command="{Binding PostCommand}" IsEnabled="{Binding HasSelection}" Padding="14,6" />
                    <Button Content="Discard" Style="{StaticResource GhostButton}" Margin="8,0,0,0"
                            Command="{Binding DiscardCommand}" IsEnabled="{Binding HasSelection}" Padding="14,6" />
                    <Button Content="Refresh" Style="{StaticResource GhostButton}" Margin="8,0,0,0"
                            Command="{Binding RefreshCommand}" Padding="14,6" />
                </StackPanel>
            </Grid>
        </Border>

        <TextBlock Grid.Row="2" Text="{Binding StatusText}" TextWrapping="Wrap" FontSize="12" Margin="0,10,0,0"
                   Visibility="{Binding HasStatus, Converter={StaticResource BoolToVis}}">
            <TextBlock.Style>
                <Style TargetType="TextBlock">
                    <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsStatusError}" Value="True">
                            <Setter Property="Foreground" Value="{StaticResource DangerBrush}" />
                            <Setter Property="FontWeight" Value="Bold" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </TextBlock.Style>
        </TextBlock>
    </Grid>
</Window>
