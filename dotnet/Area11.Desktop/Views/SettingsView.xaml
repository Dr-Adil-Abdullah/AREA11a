<UserControl x:Class="Area11.Desktop.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header: title on the left, one Save button on the right -->
        <DockPanel Grid.Row="0" Margin="0,0,0,6">
            <StackPanel DockPanel.Dock="Left" VerticalAlignment="Center">
                <TextBlock Text="Settings" Style="{StaticResource PageTitle}" />
                <TextBlock Text="Shop details, printing, sales rules and staff — no code change needed"
                           Style="{StaticResource PageSubtitle}" />
            </StackPanel>

            <Button DockPanel.Dock="Right" HorizontalAlignment="Right" VerticalAlignment="Center"
                    Content="Save settings" Style="{StaticResource PrimaryButton}"
                    Command="{Binding SaveCommand}" />
        </DockPanel>

        <TabControl Grid.Row="1">

            <!-- ============================ 1. SHOP ============================ -->
            <TabItem Header="Shop">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>

                        <Border Style="{StaticResource SettingsGroup}">
                            <StackPanel>
                                <TextBlock Text="Shop details" Style="{StaticResource SectionTitle}" />
                                <TextBlock Text="This is printed at the top of every receipt and shown in the sidebar."
                                           Style="{StaticResource FieldHint}" />

                                <Grid Margin="0,6,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="12" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="Shop name *" Style="{StaticResource FieldLabel}" />
                                        <TextBox Text="{Binding StoreName, UpdateSourceTrigger=PropertyChanged}" />
                                    </StackPanel>

                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="Phone" Style="{StaticResource FieldLabel}" />
                                        <TextBox Text="{Binding StorePhone, UpdateSourceTrigger=PropertyChanged}" />
                                    </StackPanel>
                                </Grid>

                                <TextBlock Text="Address" Style="{StaticResource FieldLabel}" />
                                <TextBox Text="{Binding StoreAddress, UpdateSourceTrigger=PropertyChanged}" />

                                <TextBlock Text="Note at the bottom of the receipt" Style="{StaticResource FieldLabel}" />
                                <TextBox Text="{Binding FooterNote, UpdateSourceTrigger=PropertyChanged}" />
                                <TextBlock Text="For example the return policy or your timing."
                                           Style="{StaticResource FieldHint}" />

                                <TextBlock Text="Application name (top of the window)" Style="{StaticResource FieldLabel}" />
                                <TextBox Text="{Binding AppName, UpdateSourceTrigger=PropertyChanged}" Width="260"
                                         HorizontalAlignment="Left" />
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource SettingsGroup}">
                            <StackPanel>
                                <TextBlock Text="Receipt content" Style="{StaticResource SectionTitle}" />

                                <CheckBox Content="Show the discount line on the receipt"
                                          IsChecked="{Binding ShowDiscount, Mode=TwoWay}"
                                          Margin="0,10,0,0" />
                                <TextBlock Text="Leave it off if you never give a discount — the paper stays shorter."
                                           Style="{StaticResource FieldHint}" />
                            </StackPanel>
                        </Border>

                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ========================== 2. PRINTING ========================== -->
            <TabItem Header="Printing">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>

                        <Border Style="{StaticResource SettingsGroup}">
                            <StackPanel>
                                <TextBlock Text="Paper" Style="{StaticResource SectionTitle}" />

                                <TextBlock Text="Printer width" Style="{StaticResource FieldLabel}" />
                                <ComboBox ItemsSource="{Binding PaperOptions}"
                                          SelectedItem="{Binding SelectedPaper, Mode=TwoWay}"
                                          Width="430" HorizontalAlignment="Left" />
                                <TextBlock Text="Both widths are supported. 58 mm fits 32 characters on a line, 80 mm fits 48."
                                           Style="{StaticResource FieldHint}" />

                                <TextBlock Text="Printer name" Style="{StaticResource FieldLabel}" />
                                <TextBox Text="{Binding PrinterName, UpdateSourceTrigger=PropertyChanged}" Width="430"
                                         HorizontalAlignment="Left" />
                                <TextBlock Text="Leave it empty to use the Windows default printer."
                                           Style="{StaticResource FieldHint}" />
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource SettingsGroup}">
                            <StackPanel>
                                <TextBlock Text="When the receipt prints (D-26)" Style="{StaticResource SectionTitle}" />
                                <TextBlock Text="The owner asked for this to be a choice, so it is: automatic or manual."
                                           Style="{StaticResource FieldHint}" />

                                <CheckBox Content="Print the receipt automatically after each sale"
                                          IsChecked="{Binding AutoPrint, Mode=TwoWay}"
                                          Margin="0,12,0,0" />
                                <TextBlock Text="Off = the cashier presses 'Print last bill again' on the counter screen. The bill is saved either way."
                                           Style="{StaticResource FieldHint}" />

                                <CheckBox Content="Cut the paper after the receipt"
                                          IsChecked="{Binding AutoCut, Mode=TwoWay}"
                                          Margin="0,12,0,0" />
                                <TextBlock Text="Only for printers with a cutter; a printer without one ignores the command."
                                           Style="{StaticResource FieldHint}" />
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource SettingsGroup}">
                            <StackPanel>
                                <TextBlock Text="Copies" Style="{StaticResource SectionTitle}" />

                                <TextBlock Text="How many copies of one receipt" Style="{StaticResource FieldLabel}" />
                                <TextBox Text="{Binding CopiesText, UpdateSourceTrigger=PropertyChanged}" Width="90"
                                         HorizontalAlignment="Left" />
                                <TextBlock Text="1, 2 or 3. The shop copy is a separate print, so a jam on the first copy does not hide the second."
                                           Style="{StaticResource FieldHint}" />
                            </StackPanel>
                        </Border>

                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- =========================== 3. SALES ============================ -->
            <TabItem Header="Sales rules">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>

                        <Border Style="{StaticResource SettingsGroup}">
                            <StackPanel>
                                <TextBlock Text="Discount limits" Style="{StaticResource SectionTitle}" />
                                <TextBlock Text="A bigger discount than the limit needs a manager, so a cashier cannot quietly empty the till."
                                           Style="{StaticResource FieldHint}" />

                                <Grid Margin="0,6,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="12" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="Cashier may give (percent)" Style="{StaticResource FieldLabel}" />
                                        <TextBox Text="{Binding CashierLimitText, UpdateSourceTrigger=PropertyChanged}" Width="110"
                                                 HorizontalAlignment="Left" />
                                    </StackPanel>

                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="Manager may give (percent)" Style="{StaticResource FieldLabel}" />
                                        <TextBox Text="{Binding ManagerLimitText, UpdateSourceTrigger=PropertyChanged}" Width="110"
                                                 HorizontalAlignment="Left" />
                                    </StackPanel>
                                </Grid>

                                <CheckBox Content="Never sell below cost, even with a discount"
                                          IsChecked="{Binding BlockBelowCost, Mode=TwoWay}"
                                          Margin="0,14,0,0" />
                                <TextBlock Text="Recommended. A sale below cost is a real loss, not a discount."
                                           Style="{StaticResource FieldHint}" />
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource SettingsGroup}">
                            <StackPanel>
                                <TextBlock Text="Tax" Style="{StaticResource SectionTitle}" />

                                <CheckBox Content="Charge sales tax on bills"
                                          IsChecked="{Binding TaxEnabled, Mode=TwoWay}"
                                          Margin="0,10,0,0" />

                                <TextBlock Text="Tax rate (percent)" Style="{StaticResource FieldLabel}" />
                                <TextBox Text="{Binding TaxPercentText, UpdateSourceTrigger=PropertyChanged}" Width="110"
                                         HorizontalAlignment="Left" />
                                <TextBlock Text="Shown as a separate line on the receipt. Leave 0 if you do not charge tax."
                                           Style="{StaticResource FieldHint}" />
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource SettingsGroup}">
                            <StackPanel>
                                <TextBlock Text="Stock" Style="{StaticResource SectionTitle}" />

                                <CheckBox Content="Allow a bill when the stock count is short (negative stock)"
                                          IsChecked="{Binding AllowNegativeStock, Mode=TwoWay}"
                                          Margin="0,10,0,0" />
                                <TextBlock Text="Recommended: a counter must never refuse a sale because the computer's count is wrong. The shortage shows on the stock report."
                                           Style="{StaticResource FieldHint}" />

                                <Separator Margin="0,14,0,10" />

                                <TextBlock Text="Expiry alert levels (days)" Style="{StaticResource FieldLabel}" />
                                <TextBlock Text="Level 1 is the farthest warning, Level 3 the nearest. Level 3 also sets the &quot;expiring soon&quot; card on the dashboard."
                                           Style="{StaticResource FieldHint}" />

                                <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                    <StackPanel Width="120">
                                        <TextBlock Text="Level 1" Style="{StaticResource FieldLabel}" />
                                        <TextBox Text="{Binding Expiry1Text, UpdateSourceTrigger=PropertyChanged}"
                                                 Width="100" HorizontalAlignment="Left" />
                                    </StackPanel>
                                    <StackPanel Width="120" Margin="8,0,0,0">
                                        <TextBlock Text="Level 2" Style="{StaticResource FieldLabel}" />
                                        <TextBox Text="{Binding Expiry2Text, UpdateSourceTrigger=PropertyChanged}"
                                                 Width="100" HorizontalAlignment="Left" />
                                    </StackPanel>
                                    <StackPanel Width="120" Margin="8,0,0,0">
                                        <TextBlock Text="Level 3" Style="{StaticResource FieldLabel}" />
                                        <TextBox Text="{Binding Expiry3Text, UpdateSourceTrigger=PropertyChanged}"
                                                 Width="100" HorizontalAlignment="Left" />
                                    </StackPanel>
                                </StackPanel>

                                <TextBlock Text="{Binding ExpirySummary}" Style="{StaticResource FieldHint}" Margin="0,6,0,0" />
                                <TextBlock Text="The bands only colour the warning - a bill is never refused. A batch that is already past its date is always EXPIRED, whatever these numbers say."
                                           Style="{StaticResource FieldHint}" />

                                <Separator Margin="0,14,0,10" />

                                <TextBlock Text="Supplier returns (days before expiry)" Style="{StaticResource FieldLabel}" />
                                <TextBlock Text="A supplier takes goods back only until a cutoff. The alert board reminds you from the day you enter here until that cutoff, so the goods can still go back."
                                           Style="{StaticResource FieldHint}" />

                                <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                    <StackPanel Width="200">
                                        <TextBlock Text="Start reminding" Style="{StaticResource FieldLabel}" />
                                        <TextBox Text="{Binding SupplierAlertText, UpdateSourceTrigger=PropertyChanged}"
                                                 Width="100" HorizontalAlignment="Left" />
                                    </StackPanel>
                                    <StackPanel Width="200" Margin="8,0,0,0">
                                        <TextBlock Text="Last return day (cutoff)" Style="{StaticResource FieldLabel}" />
                                        <TextBox Text="{Binding SupplierCutoffText, UpdateSourceTrigger=PropertyChanged}"
                                                 Width="100" HorizontalAlignment="Left" />
                                    </StackPanel>
                                </StackPanel>
                                <TextBlock Text="Example: 180 and 90 means a batch 120 days from expiry is on the alert board, and the supplier must receive it before it is 90 days from expiry."
                                           Style="{StaticResource FieldHint}" />
                            </StackPanel>
                        </Border>

                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- =========================== 4. STAFF ============================ -->
            <TabItem Header="Staff &amp; permissions">
                <Grid>

                    <!-- Owner's view -->
                    <Grid Visibility="{Binding CanManageStaff, Converter={StaticResource BoolToVis}}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.05*" />
                            <ColumnDefinition Width="14" />
                            <ColumnDefinition Width="1.45*" />
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Style="{StaticResource Card}" Padding="12">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" Text="People" Style="{StaticResource SectionTitle}"
                                           Margin="0,0,0,8" />

                                <DataGrid Grid.Row="1" ItemsSource="{Binding Users}"
                                          SelectedItem="{Binding SelectedUser, Mode=TwoWay}">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="*" />
                                        <DataGridTextColumn Header="Role" Binding="{Binding RoleLabel}" Width="90" />
                                        <DataGridTextColumn Header="Account" Binding="{Binding ActiveLabel}" Width="75" />
                                    </DataGrid.Columns>
                                </DataGrid>

                                <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,10,0,0">
                                    <Button Content="Switch on / off" Style="{StaticResource GhostButton}"
                                            Command="{Binding ToggleActiveCommand}" />
                                    <Button Content="Refresh" Style="{StaticResource GhostButton}" Margin="8,0,0,0"
                                            Command="{Binding RefreshStaffCommand}" />
                                </StackPanel>
                            </Grid>
                        </Border>

                        <Border Grid.Column="2" Style="{StaticResource Card}" Padding="14">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <StackPanel>
                                    <TextBlock Text="{Binding SelectedUserCaption}" Style="{StaticResource SectionTitle}" />
                                    <TextBlock Text="Tick what this person may open. The owner sees everything and cannot be limited."
                                               Style="{StaticResource FieldHint}" />

                                    <ItemsControl ItemsSource="{Binding Permissions}" Margin="0,10,0,0">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <UniformGrid Columns="2" />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <CheckBox Content="{Binding Label}"
                                                          IsChecked="{Binding Allowed, Mode=TwoWay}"
                                                          IsEnabled="{Binding CanEdit}"
                                                          Margin="0,3,10,3" />
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <Button Content="Back to the normal rights for this role"
                                            Style="{StaticResource GhostButton}"
                                            HorizontalAlignment="Left" Margin="0,10,0,0"
                                            Command="{Binding ResetPermissionsCommand}" />

                                    <Border Background="{StaticResource BrandSoftBrush}" CornerRadius="8"
                                            Padding="12" Margin="0,16,0,0">
                                        <StackPanel>
                                            <TextBlock Text="Add a person" Style="{StaticResource SectionTitle}" />
                                            <TextBlock Text="They sign in with their name and this PIN."
                                                       Style="{StaticResource FieldHint}" />

                                            <TextBlock Text="Name" Style="{StaticResource FieldLabel}" />
                                            <TextBox Text="{Binding NewStaffName, UpdateSourceTrigger=PropertyChanged}" />

                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="10" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>

                                                <StackPanel Grid.Column="0">
                                                    <TextBlock Text="Role" Style="{StaticResource FieldLabel}" />
                                                    <ComboBox ItemsSource="{Binding StaffRoles}"
                                                              SelectedItem="{Binding SelectedRole, Mode=TwoWay}" />
                                                </StackPanel>

                                                <StackPanel Grid.Column="2">
                                                    <TextBlock Text="PIN (4 digits)" Style="{StaticResource FieldLabel}" />
                                                    <TextBox Text="{Binding NewStaffPin, UpdateSourceTrigger=PropertyChanged}" />
                                                </StackPanel>
                                            </Grid>

                                            <Button Content="Add this person" Style="{StaticResource PrimaryButton}"
                                                    HorizontalAlignment="Left" Margin="0,10,0,0"
                                                    Command="{Binding AddStaffCommand}" />
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </ScrollViewer>
                        </Border>
                    </Grid>

                    <!-- Manager / other user's view -->
                    <Border Style="{StaticResource SettingsGroup}" VerticalAlignment="Top"
                            Visibility="{Binding CannotManageStaff, Converter={StaticResource BoolToVis}}">
                        <StackPanel>
                            <TextBlock Text="Staff &amp; permissions" Style="{StaticResource SectionTitle}" />
                            <TextBlock Text="Only the owner can see people's permissions and add new staff. Ask the owner to change this."
                                       Style="{StaticResource FieldHint}" />
                        </StackPanel>
                    </Border>

                </Grid>
            </TabItem>

        </TabControl>

        <!-- Status line: green/grey = saved, red = problem -->
        <Border Grid.Row="2" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource LineBrush}"
                BorderThickness="1" CornerRadius="8" Padding="12,8" Margin="0,10,0,0">
            <TextBlock Text="{Binding StatusText}" TextWrapping="Wrap">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="FontSize" Value="12" />
                        <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsStatusError}" Value="True">
                                <Setter Property="Foreground" Value="{StaticResource DangerBrush}" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
        </Border>
    </Grid>
</UserControl>
