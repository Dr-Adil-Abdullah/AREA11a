<UserControl x:Class="Area11.Desktop.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:Area11.Desktop.Views">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header: title on the left, one Save button on the right -->
        <DockPanel Grid.Row="0" Margin="0,0,0,6">
            <StackPanel DockPanel.Dock="Left" VerticalAlignment="Center">
                <TextBlock Text="{DynamicResource AppLabel.settings}" Style="{StaticResource PageTitle}" />
                <TextBlock Text="Shop details, printing, sales rules, cloud sync, staff and application words — no code change needed"
                           Style="{StaticResource PageSubtitle}" />
            </StackPanel>

            <Button DockPanel.Dock="Right" HorizontalAlignment="Right" VerticalAlignment="Center"
                    Content="Save settings" Style="{StaticResource PrimaryButton}"
                    Command="{Binding SaveCommand}" />
        </DockPanel>

        <!-- The shell owns the clickable section row. This headerless template keeps the existing
             six tab contents and SelectedTabIndex semantics without drawing a second tab strip. -->
        <TabControl Grid.Row="1" SelectedIndex="{Binding SelectedTabIndex, Mode=TwoWay}">
            <TabControl.Template>
                <ControlTemplate TargetType="TabControl">
                    <ContentPresenter x:Name="PART_SelectedContentHost" ContentSource="SelectedContent" />
                </ControlTemplate>
            </TabControl.Template>

            <!-- ============================ 1. SHOP ============================ -->
            <TabItem Header="App name &amp; icon">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <Border Style="{StaticResource SettingsGroup}">
                            <StackPanel>
                                <TextBlock Text="App name &amp; icon" Style="{StaticResource SectionTitle}" />
                                <TextBlock Text="Owner: this name shows on every window, the sign-in screen and the taskbar. The icon shows on every window and the taskbar. Slips and WhatsApp keep printing the shop name from Shop details."
                                           Style="{StaticResource FieldHint}" TextWrapping="Wrap" />
                                <TextBlock Text="App name (1-40 letters)" Style="{StaticResource FieldLabel}" />
                                <TextBox Text="{Binding AppDisplayName, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding CanChangeAppName}" MaxLength="40" />
                                <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                    <Button Content="Choose app icon…" Command="{Binding ChooseAppIconCommand}" IsEnabled="{Binding CanChangeAppIcon}" />
                                    <Button Content="Use default icon" Command="{Binding ResetAppIconCommand}" IsEnabled="{Binding CanChangeAppIcon}" Margin="8,0,0,0" />
                                </StackPanel>
                                <TextBlock Text="Choose a Windows .ico file, no larger than 2 MB. The installed program and existing shortcuts keep their own icon; a photo-inclusive backup includes the chosen file."
                                           Style="{StaticResource FieldHint}" TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
            <TabItem Header="Shop">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>

                        <Border Style="{StaticResource SettingsGroup}">
                            <StackPanel>
                                <TextBlock Text="Product photos" Style="{StaticResource SectionTitle}" />
                                <TextBlock Text="Choose the thumbnail size in Counter and the Products list. Open a photo to see its gallery."
                                           Style="{StaticResource FieldHint}" TextWrapping="Wrap" />
                                <ComboBox ItemsSource="{Binding ProductPhotoSizes}" SelectedItem="{Binding ProductPhotoSize, Mode=TwoWay}"
                                          HorizontalAlignment="Left" MinWidth="160" Margin="0,6,0,0" />
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource SettingsGroup}">
                            <StackPanel>
                                <TextBlock Text="Shop details" Style="{StaticResource SectionTitle}" />
                                <TextBlock Text="This is printed at the top of every receipt. Window titles show the app name from the 'App name &amp; icon' tab."
                                           Style="{StaticResource FieldHint}" />

                                <Grid Margin="0,6,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="12" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="Shop name *" Style="{StaticResource FieldLabel}" />
                                        <TextBox Text="{Binding StoreName, UpdateSourceTrigger=PropertyChanged}" />
                                    </StackPanel>

                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="Phone" Style="{StaticResource FieldLabel}" />
                                        <TextBox Text="{Binding StorePhone, UpdateSourceTrigger=PropertyChanged}" />
                                    </StackPanel>
                                </Grid>

                                <TextBlock Text="Address" Style="{StaticResource FieldLabel}" />
                                <TextBox Text="{Binding StoreAddress, UpdateSourceTrigger=PropertyChanged}" />

                                <TextBlock Text="Note at the bottom of the receipt" Style="{StaticResource FieldLabel}" />
                                <TextBox Text="{Binding FooterNote, UpdateSourceTrigger=PropertyChanged}" />
                                <TextBlock Text="For example the return policy or your timing."
                                           Style="{StaticResource FieldHint}" />

                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource SettingsGroup}">
                            <StackPanel>
                                <TextBlock Text="Receipt content" Style="{StaticResource SectionTitle}" />

                                <CheckBox Content="Show the discount line on the receipt"
                                          IsChecked="{Binding ShowDiscount, Mode=TwoWay}"
                                          Margin="0,10,0,0" />
                                <TextBlock Text="Leave it off if you never give a discount — the paper stays shorter."
                                           Style="{StaticResource FieldHint}" />
                            </StackPanel>
                        </Border>

                        <!-- The session and the shop's clock (v0.35.0, D-92). The owner asked for the
                             sign-out time to be his choice and for the time to come from the internet;
                             both answers belong on one card, because both are about "whose day is it". -->
                        <Border Style="{StaticResource SettingsGroup}">
                            <StackPanel>
                                <TextBlock Text="Sign out and the shop's clock" Style="{StaticResource SectionTitle}" />
                                <TextBlock Text="Area11 signs the person out after the time you choose here, so a counter left alone cannot be used by the next person under the last person's name. Whatever you choose, 12 hours after a sign-in everything closes."
                                           Style="{StaticResource FieldHint}" TextWrapping="Wrap" />

                                <TextBlock Text="Sign out a person who has not touched the counter for" Style="{StaticResource FieldLabel}" />
                                <ComboBox ItemsSource="{Binding IdleHourOptions}"
                                          SelectedItem="{Binding SelectedIdleHour, Mode=TwoWay}"
                                          DisplayMemberPath="Label" Width="320" HorizontalAlignment="Left" />

                                <TextBlock Text="The 12-hour limit is not a setting: after 12 hours from the sign-in the session ends even while the counter is busy. An open drawer is never closed by Area11 - it is counted by a person on the Shift (galla) page."
                                           Style="{StaticResource FieldHint}" TextWrapping="Wrap" Margin="0,6,0,0" />

                                <TextBlock Text="Where the time comes from" Style="{StaticResource FieldLabel}" Margin="0,14,0,4" />
                                <TextBlock Text="{Binding ClockText}" TextWrapping="Wrap" FontSize="12"
                                           Foreground="{StaticResource TextBrush}" />
                                <TextBlock Text="Bills are stamped with the time server's time when the internet answers, and with this computer's clock when it does not. Area11 asks again every 20 minutes."
                                           Style="{StaticResource FieldHint}" TextWrapping="Wrap" Margin="0,4,0,0" />
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource SettingsGroup}">
                            <StackPanel IsEnabled="{Binding CanChangeStartup}">
                                <TextBlock Text="Windows start and protected close" Style="{StaticResource SectionTitle}" />
                                <TextBlock Text="Owner only. Auto-start opens Area11 at every Windows sign-in on this PC (all accounts) and needs a Windows administrator to save. Protected also asks for the password on every × - on the shop screen and on the sign-in window."
                                           Style="{StaticResource FieldHint}" TextWrapping="Wrap" />

                                <TextBlock Text="How Area11 starts and closes" Style="{StaticResource FieldLabel}" />
                                <ComboBox ItemsSource="{Binding StartupModeOptions}"
                                          SelectedItem="{Binding SelectedStartupMode, Mode=TwoWay}"
                                          DisplayMemberPath="Label" Width="380" HorizontalAlignment="Left" />

                                <TextBlock Text="Who may close it in protected mode: the owner with the password or PIN, or a staff member you tick for Close the program on the Staff &amp; permissions tab. Hold Shift while starting to switch protection off again."
                                           Style="{StaticResource FieldHint}" TextWrapping="Wrap" Margin="0,6,0,0" />
                                <TextBlock Text="Honest limit: this stops casual closing, not a Windows administrator, Task Manager, shutdown or power loss. The shop's data survives all of those."
                                           Style="{StaticResource FieldHint}" TextWrapping="Wrap" Margin="0,4,0,0" />

                                <CheckBox Content="Lock the screen while signed in"
                                          IsChecked="{Binding FocusGuardEnabled, Mode=TwoWay}"
                                          Margin="0,10,0,0" />
                                <TextBlock Text="When ticked, leaving Area11 for another program first shows a small 'not allowed' box and pulls the screen back, and × asks for the password on every window. Every escape is still written to the black box with who left, at what time, and for how long - and a run ended from Task Manager is caught at the next start."
                                           Style="{StaticResource FieldHint}" TextWrapping="Wrap" Margin="0,4,0,0" />
                            </StackPanel>
                        </Border>

                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ========================== 2. PRINTING ========================== -->
            <TabItem Header="Printing">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>

                        <Border Style="{StaticResource SettingsGroup}">
                            <StackPanel>
                                <TextBlock Text="Paper" Style="{StaticResource SectionTitle}" />

                                <TextBlock Text="Printer width" Style="{StaticResource FieldLabel}" />
                                <ComboBox ItemsSource="{Binding PaperOptions}"
                                          SelectedItem="{Binding SelectedPaper, Mode=TwoWay}"
                                          Width="430" HorizontalAlignment="Left" />
                                <TextBlock Text="Both widths are supported. 58 mm fits 32 characters on a line, 80 mm fits 48."
                                           Style="{StaticResource FieldHint}" />

                                <TextBlock Text="Printer name" Style="{StaticResource FieldLabel}" />
                                <TextBox Text="{Binding PrinterName, UpdateSourceTrigger=PropertyChanged}" Width="430"
                                         HorizontalAlignment="Left" />
                                <TextBlock Text="Leave it empty to use the Windows default printer."
                                           Style="{StaticResource FieldHint}" />
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource SettingsGroup}">
                            <StackPanel>
                                <TextBlock Text="When the receipt prints (D-26)" Style="{StaticResource SectionTitle}" />
                                <TextBlock Text="The owner asked for this to be a choice, so it is: automatic or manual."
                                           Style="{StaticResource FieldHint}" />

                                <CheckBox Content="Print the receipt automatically after each sale"
                                          IsChecked="{Binding AutoPrint, Mode=TwoWay}"
                                          Margin="0,12,0,0" />
                                <TextBlock Text="Off = the cashier presses 'Print last bill again' on the counter screen. The bill is saved either way."
                                           Style="{StaticResource FieldHint}" />

                                <CheckBox Content="Cut the paper after the receipt"
                                          IsChecked="{Binding AutoCut, Mode=TwoWay}"
                                          Margin="0,12,0,0" />
                                <TextBlock Text="Only for printers with a cutter; a printer without one ignores the command."
                                           Style="{StaticResource FieldHint}" />
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource SettingsGroup}">
                            <StackPanel>
                                <TextBlock Text="Printing several at once" Style="{StaticResource SectionTitle}" />
                                <TextBlock Text="On the history, customer and supplier pages several rows can be ticked and printed as one set."
                                           Style="{StaticResource FieldHint}" />

                                <CheckBox Content="The Print button prints every ticked row"
                                          IsChecked="{Binding DefaultBulk, Mode=TwoWay}"
                                          Margin="0,12,0,0" />
                                <TextBlock Text="On = one press prints the whole ticked set. Off = it prints the one open row, and the set stays behind its own 'Print selected' button."
                                           Style="{StaticResource FieldHint}" />

                                <TextBlock Text="What a bulk print looks like" Style="{StaticResource FieldLabel}" />
                                <ComboBox ItemsSource="{Binding BulkFormatOptions}"
                                          SelectedItem="{Binding SelectedBulkFormat, Mode=TwoWay}"
                                          Width="430" HorizontalAlignment="Left" />
                                <TextBlock Text="Separate receipts = one slip per bill, each cut on its own. One A4 list = the summary page only, for the file."
                                           Style="{StaticResource FieldHint}" />
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource SettingsGroup}">
                            <StackPanel>
                                <TextBlock Text="WhatsApp + PDF" Style="{StaticResource SectionTitle}" />
                                <TextBlock Text="Bills, statements, reports and slips can go to WhatsApp with a PDF file the owner attaches by hand."
                                           Style="{StaticResource FieldHint}" />

                                <CheckBox Content="Prepare a PDF file with every WhatsApp send"
                                          IsChecked="{Binding WhatsAppPreparePdf, Mode=TwoWay}"
                                          Margin="0,12,0,0" />
                                <TextBlock Text="Off = only the message text goes; no file is prepared."
                                           Style="{StaticResource FieldHint}" />

                                <TextBlock Text="Folder for the prepared PDFs" Style="{StaticResource FieldLabel}" />
                                <TextBox Text="{Binding WhatsAppExportDirectory, UpdateSourceTrigger=PropertyChanged}" Width="430"
                                         HorizontalAlignment="Left" />
                                <TextBlock Text="Leave it empty to use the shop's exports folder."
                                           Style="{StaticResource FieldHint}" />
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource SettingsGroup}">
                            <StackPanel>
                                <TextBlock Text="Copies" Style="{StaticResource SectionTitle}" />

                                <TextBlock Text="How many copies of one receipt" Style="{StaticResource FieldLabel}" />
                                <TextBox Text="{Binding CopiesText, UpdateSourceTrigger=PropertyChanged}" Width="90"
                                         HorizontalAlignment="Left" />
                                <TextBlock Text="1, 2 or 3. The shop copy is a separate print, so a jam on the first copy does not hide the second."
                                           Style="{StaticResource FieldHint}" />
                            </StackPanel>
                        </Border>

                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- =========================== 3. SALES ============================ -->
            <TabItem Header="Sales rules">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>

                        <Border Style="{StaticResource SettingsGroup}">
                            <StackPanel>
                                <TextBlock Text="Discount limits" Style="{StaticResource SectionTitle}" />
                                <TextBlock Text="A bigger discount than the limit needs a manager, so a cashier cannot quietly empty the till."
                                           Style="{StaticResource FieldHint}" />

                                <Grid Margin="0,6,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="12" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="Cashier may give (percent)" Style="{StaticResource FieldLabel}" />
                                        <TextBox Text="{Binding CashierLimitText, UpdateSourceTrigger=PropertyChanged}" Width="110"
                                                 HorizontalAlignment="Left" />
                                    </StackPanel>

                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="Manager may give (percent)" Style="{StaticResource FieldLabel}" />
                                        <TextBox Text="{Binding ManagerLimitText, UpdateSourceTrigger=PropertyChanged}" Width="110"
                                                 HorizontalAlignment="Left" />
                                    </StackPanel>
                                </Grid>

                                <CheckBox Content="Never sell below cost, even with a discount"
                                          IsChecked="{Binding BlockBelowCost, Mode=TwoWay}"
                                          Margin="0,14,0,0" />
                                <TextBlock Text="Recommended. A sale below cost is a real loss, not a discount."
                                           Style="{StaticResource FieldHint}" />
                                <TextBlock Text="Discount % is of the full retail/selling-price total. With no discount, the Counter asks before using a VIP/Doctor rate; No keeps ordinary retail."
                                           Style="{StaticResource FieldHint}" TextWrapping="Wrap" Margin="0,6,0,0" />
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource SettingsGroup}">
                            <StackPanel>
                                <TextBlock Text="Profit visibility" Style="{StaticResource SectionTitle}" />
                                <CheckBox Content="Show profit and margins"
                                          IsChecked="{Binding ShowMargins, Mode=TwoWay}"
                                          Margin="0,10,0,0" />
                                <TextBlock Text="Off hides every margin - dashboard, reports, customer pages, doctors, history - even from the owner, until it is switched back on. No number is changed."
                                           Style="{StaticResource FieldHint}" TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource SettingsGroup}">
                            <StackPanel>
                                <TextBlock Text="Sale confirmation" Style="{StaticResource SectionTitle}" />
                                <CheckBox Content="Show the Done / invoice / cash-change card after a saved sale"
                                          IsChecked="{Binding SaleSuccessPopup, Mode=TwoWay}"
                                          Margin="0,10,0,0" />
                                <TextBlock Text="The card appears only after the bill is committed. Off = the existing status line still shows the saved invoice; printing is controlled separately above."
                                           Style="{StaticResource FieldHint}" TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource SettingsGroup}">
                            <StackPanel>
                                <TextBlock Text="Loyalty points" Style="{StaticResource SectionTitle}" />
                                <TextBlock Text="Off by default. When it is on, a customer earns points on every bill and can spend them at the counter - 1 point is always Rs 1."
                                           Style="{StaticResource FieldHint}" TextWrapping="Wrap" />

                                <CheckBox Content="Give loyalty points"
                                          IsChecked="{Binding LoyaltyEnabled, Mode=TwoWay}"
                                          Margin="0,10,0,0" />

                                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                    <StackPanel Width="190">
                                        <TextBlock Text="Rupees spent for 1 point" Style="{StaticResource FieldLabel}" />
                                        <TextBox Text="{Binding LoyaltyPerPointText, UpdateSourceTrigger=PropertyChanged}"
                                                 Width="100" HorizontalAlignment="Left" />
                                    </StackPanel>
                                    <StackPanel Width="210" Margin="8,0,0,0">
                                        <TextBlock Text="Points that make a customer VIP" Style="{StaticResource FieldLabel}" />
                                        <TextBox Text="{Binding LoyaltyVipText, UpdateSourceTrigger=PropertyChanged}"
                                                 Width="100" HorizontalAlignment="Left" />
                                    </StackPanel>
                                </StackPanel>

                                <TextBlock Text="{Binding LoyaltySummary}" Style="{StaticResource FieldHint}"
                                           TextWrapping="Wrap" Margin="0,6,0,0" />
                                <TextBlock Text="A customer only earns on the money the bill really costs him, never on the part that went on the khata. Points never expire and are never deleted."
                                           Style="{StaticResource FieldHint}" TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource SettingsGroup}">
                            <StackPanel>
                                <TextBlock Text="Tax" Style="{StaticResource SectionTitle}" />

                                <CheckBox Content="Charge sales tax on bills"
                                          IsChecked="{Binding TaxEnabled, Mode=TwoWay}"
                                          Margin="0,10,0,0" />

                                <TextBlock Text="Tax rate (percent)" Style="{StaticResource FieldLabel}" />
                                <TextBox Text="{Binding TaxPercentText, UpdateSourceTrigger=PropertyChanged}" Width="110"
                                         HorizontalAlignment="Left" />
                                <TextBlock Text="Shown as a separate line on the receipt. Leave 0 if you do not charge tax."
                                           Style="{StaticResource FieldHint}" />
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource SettingsGroup}">
                            <StackPanel>
                                <TextBlock Text="Stock" Style="{StaticResource SectionTitle}" />

                                <TextBlock Text="New work never takes stock below zero (D-93)"
                                           Style="{StaticResource FieldLabel}" Margin="0,10,0,0" />
                                <TextBlock TextWrapping="Wrap" Style="{StaticResource FieldHint}"
                                           Text="Sales, write-offs, goods drawings, supplier returns and PR cancellations stop with a clear shortage message. There is no checkbox or owner bypass. Existing minus quantities stay visible in Stock minus until a physical stock-take reconciles them." />

                                <Separator Margin="0,14,0,10" />

                                <TextBlock Text="Expiry alert levels (days)" Style="{StaticResource FieldLabel}" />
                                <TextBlock Text="Level 1 is the farthest warning, Level 3 the nearest. Level 3 also sets the &quot;expiring soon&quot; card on the dashboard."
                                           Style="{StaticResource FieldHint}" />

                                <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                    <StackPanel Width="120">
                                        <TextBlock Text="Level 1" Style="{StaticResource FieldLabel}" />
                                        <TextBox Text="{Binding Expiry1Text, UpdateSourceTrigger=PropertyChanged}"
                                                 Width="100" HorizontalAlignment="Left" />
                                    </StackPanel>
                                    <StackPanel Width="120" Margin="8,0,0,0">
                                        <TextBlock Text="Level 2" Style="{StaticResource FieldLabel}" />
                                        <TextBox Text="{Binding Expiry2Text, UpdateSourceTrigger=PropertyChanged}"
                                                 Width="100" HorizontalAlignment="Left" />
                                    </StackPanel>
                                    <StackPanel Width="120" Margin="8,0,0,0">
                                        <TextBlock Text="Level 3" Style="{StaticResource FieldLabel}" />
                                        <TextBox Text="{Binding Expiry3Text, UpdateSourceTrigger=PropertyChanged}"
                                                 Width="100" HorizontalAlignment="Left" />
                                    </StackPanel>
                                </StackPanel>

                                <TextBlock Text="{Binding ExpirySummary}" Style="{StaticResource FieldHint}" Margin="0,6,0,0" />
                                <TextBlock Text="The bands only colour the warning - a bill is never refused. A batch that is already past its date is always EXPIRED, whatever these numbers say."
                                           Style="{StaticResource FieldHint}" />

                                <Separator Margin="0,14,0,10" />

                                <TextBlock Text="Supplier returns (days before expiry)" Style="{StaticResource FieldLabel}" />
                                <TextBlock Text="A supplier takes goods back only until a cutoff. The alert board reminds you from the day you enter here until that cutoff, so the goods can still go back."
                                           Style="{StaticResource FieldHint}" />

                                <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                    <StackPanel Width="200">
                                        <TextBlock Text="Start reminding" Style="{StaticResource FieldLabel}" />
                                        <TextBox Text="{Binding SupplierAlertText, UpdateSourceTrigger=PropertyChanged}"
                                                 Width="100" HorizontalAlignment="Left" />
                                    </StackPanel>
                                    <StackPanel Width="200" Margin="8,0,0,0">
                                        <TextBlock Text="Last return day (cutoff)" Style="{StaticResource FieldLabel}" />
                                        <TextBox Text="{Binding SupplierCutoffText, UpdateSourceTrigger=PropertyChanged}"
                                                 Width="100" HorizontalAlignment="Left" />
                                    </StackPanel>
                                </StackPanel>
                                <TextBlock Text="Example: 180 and 90 means a batch 120 days from expiry is on the alert board, and the supplier must receive it before it is 90 days from expiry."
                                           Style="{StaticResource FieldHint}" />
                            </StackPanel>
                        </Border>

                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ========================= 4. CLOUD SYNC ========================= -->
            <TabItem Header="{DynamicResource AppLabel.cloud}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>

                        <Border Style="{StaticResource SettingsGroup}">
                            <StackPanel IsEnabled="{Binding CanChangeCloud}">
                                <TextBlock Text="Supabase mirror (optional)" Style="{StaticResource SectionTitle}" />
                                <TextBlock Text="A copy of the shop for looking at from home. The database on this computer is always the truth; the cloud is a mirror. Area11 works with no internet and no cloud account."
                                           Style="{StaticResource FieldHint}" TextWrapping="Wrap" />

                                <CheckBox Content="Cloud sync is switched on for this shop"
                                          IsChecked="{Binding SyncEnabled, Mode=TwoWay}" Margin="0,10,0,0" />

                                <TextBlock Text="Address (Project URL)" Style="{StaticResource FieldLabel}" />
                                <TextBox Text="{Binding SyncUrl, UpdateSourceTrigger=PropertyChanged}" />
                                <TextBlock Text="Like https://abcdxyz.supabase.co — no / at the end."
                                           Style="{StaticResource FieldHint}" />

                                <Grid Margin="0,4,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="12" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="Table" Style="{StaticResource FieldLabel}" />
                                        <TextBox Text="{Binding SyncTable, UpdateSourceTrigger=PropertyChanged}" />
                                    </StackPanel>

                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="Shop id" Style="{StaticResource FieldLabel}" />
                                        <TextBox Text="{Binding SyncShopId, UpdateSourceTrigger=PropertyChanged}" />
                                    </StackPanel>
                                </Grid>
                                <TextBlock Text="The table is area11_sync unless the SQL in docs/CLOUD-SYNC.md says otherwise. Both counters of one shop use the same shop id; a second branch uses its own (shop-2)."
                                           Style="{StaticResource FieldHint}" TextWrapping="Wrap" />

                                <TextBlock Text="API key (anon public)" Style="{StaticResource FieldLabel}" />
                                <TextBox Text="{Binding SyncKey, UpdateSourceTrigger=PropertyChanged}" />
                                <TextBlock Text="{Binding SyncKeyLabel}" Style="{StaticResource FieldHint}" TextWrapping="Wrap" />
                                <TextBlock Text="The key is a password to the whole mirror. It is never shown again after saving, and it never appears in the black box or on the Cloud sync page."
                                           Style="{StaticResource FieldHint}" TextWrapping="Wrap" />

                                <CheckBox Content="Push automatically every few minutes"
                                          IsChecked="{Binding SyncAutomatic, Mode=TwoWay}" Margin="0,10,0,0" />

                                <TextBlock Text="Automatic push every (minutes)" Style="{StaticResource FieldLabel}" />
                                <TextBox Text="{Binding SyncAutomaticMinutesText, UpdateSourceTrigger=PropertyChanged}" />
                                <TextBlock Text="Whole minutes from 5 to 1440. A failed push waits for the next round - the shop never stops for the cloud, and bringing data here always stays a deliberate two clicks."
                                           Style="{StaticResource FieldHint}" TextWrapping="Wrap" />

                                <Button Content="Remove the saved key" Style="{StaticResource GhostButton}"
                                        HorizontalAlignment="Left" Margin="0,8,0,0"
                                        Command="{Binding ClearSyncKeyCommand}" />

                                <TextBlock Text="{Binding SyncSummary}" Style="{StaticResource FieldHint}"
                                           TextWrapping="Wrap" Margin="0,12,0,0" />
                                <TextBlock Text="After saving, open SYSTEM → Cloud sync to push the data or to read the cloud copy."
                                           Style="{StaticResource FieldHint}" TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>

                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- =========================== 5. STAFF ============================ -->
            <TabItem Header="Staff &amp; permissions">
                <Grid>

                    <!-- Owner's view -->
                    <Grid Visibility="{Binding CanManageStaff, Converter={StaticResource BoolToVis}}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.05*" />
                            <ColumnDefinition Width="14" />
                            <ColumnDefinition Width="1.45*" />
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Style="{StaticResource Card}" Padding="12">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" Text="People" Style="{StaticResource SectionTitle}"
                                           Margin="0,0,0,8" />

                                <DataGrid Grid.Row="1" ItemsSource="{Binding Users}"
                                          SelectedItem="{Binding SelectedUser, Mode=TwoWay}">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="*" />
                                        <DataGridTextColumn Header="Role" Binding="{Binding RoleLabel, Mode=OneWay}" Width="90" />
                                        <DataGridTextColumn Header="Account" Binding="{Binding ActiveLabel, Mode=OneWay}" Width="75" />
                                    </DataGrid.Columns>
                                </DataGrid>

                                <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,10,0,0">
                                    <Button Content="Switch on / off" Style="{StaticResource GhostButton}"
                                            Command="{Binding ToggleActiveCommand}" />
                                    <Button Content="Refresh" Style="{StaticResource GhostButton}" Margin="8,0,0,0"
                                            Command="{Binding RefreshStaffCommand}" />
                                    <Button Content="Photos…" Style="{StaticResource GhostButton}" Margin="8,0,0,0"
                                            Command="{Binding StaffPhotosCommand}" />
                                </StackPanel>
                            </Grid>
                        </Border>

                        <Border Grid.Column="2" Style="{StaticResource Card}" Padding="14">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <StackPanel>
                                    <TextBlock Text="{Binding SelectedUserCaption}" Style="{StaticResource SectionTitle}" />
                                    <TextBlock Text="Tick what this person may open. The owner sees everything and cannot be limited."
                                               Style="{StaticResource FieldHint}" />

                                    <ItemsControl ItemsSource="{Binding Permissions}" Margin="0,10,0,0">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <UniformGrid Columns="2" />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <CheckBox Content="{Binding Label}"
                                                          IsChecked="{Binding Allowed, Mode=TwoWay}"
                                                          IsEnabled="{Binding CanEdit}"
                                                          Margin="0,3,10,3" />
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <Button Content="Back to the normal rights for this role"
                                            Style="{StaticResource GhostButton}"
                                            HorizontalAlignment="Left" Margin="0,10,0,0"
                                            Command="{Binding ResetPermissionsCommand}" />

                                    <Border Background="{StaticResource BrandSoftBrush}" CornerRadius="8"
                                            Padding="12" Margin="0,16,0,0">
                                        <StackPanel>
                                            <TextBlock Text="Add a person" Style="{StaticResource SectionTitle}" />
                                            <TextBlock Text="They sign in with their name and this PIN."
                                                       Style="{StaticResource FieldHint}" />

                                            <TextBlock Text="Name" Style="{StaticResource FieldLabel}" />
                                            <TextBox Text="{Binding NewStaffName, UpdateSourceTrigger=PropertyChanged}" />

                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="10" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>

                                                <StackPanel Grid.Column="0">
                                                    <TextBlock Text="Role" Style="{StaticResource FieldLabel}" />
                                                    <ComboBox ItemsSource="{Binding StaffRoles}"
                                                              SelectedItem="{Binding SelectedRole, Mode=TwoWay}" />
                                                </StackPanel>

                                                <StackPanel Grid.Column="2">
                                                    <TextBlock Text="PIN (4 digits)" Style="{StaticResource FieldLabel}" />
                                                    <TextBox Text="{Binding NewStaffPin, UpdateSourceTrigger=PropertyChanged}" />
                                                </StackPanel>
                                            </Grid>

                                            <Button Content="Add this person" Style="{StaticResource PrimaryButton}"
                                                    HorizontalAlignment="Left" Margin="0,10,0,0"
                                                    Command="{Binding AddStaffCommand}" />
                                        </StackPanel>
                                    </Border>

                                    <Border Background="{StaticResource BrandSoftBrush}" CornerRadius="8"
                                            Padding="12" Margin="0,12,0,0">
                                        <StackPanel>
                                            <TextBlock Text="Change a PIN or password" Style="{StaticResource SectionTitle}" />
                                            <TextBlock Text="Pick a person on the left, type the new PIN - or the new password for the owner - and press the button. The old one stops working at once."
                                                       Style="{StaticResource FieldHint}" />

                                            <TextBlock Text="New PIN or password" Style="{StaticResource FieldLabel}" />
                                            <TextBox Text="{Binding ResetStaffSecret, UpdateSourceTrigger=PropertyChanged}" />

                                            <Button Content="Change it for the selected person" Style="{StaticResource PrimaryButton}"
                                                    HorizontalAlignment="Left" Margin="0,10,0,0"
                                                    Command="{Binding ResetSecretCommand}" />
                                        </StackPanel>
                                    </Border>

                                    <Border Background="{StaticResource BrandSoftBrush}" CornerRadius="8"
                                            Padding="12" Margin="0,12,0,0">
                                        <StackPanel>
                                            <TextBlock Text="Your own recovery word" Style="{StaticResource SectionTitle}" />
                                            <TextBlock Text="If you ever forget the owner password, this word signs you straight in from the sign-in screen. Until you set one, the word is area11 - set your own so nobody else can use it. Empty means back to area11."
                                                       Style="{StaticResource FieldHint}" />

                                            <TextBlock Text="New recovery word" Style="{StaticResource FieldLabel}" />
                                            <TextBox Text="{Binding NewRecoveryWord, UpdateSourceTrigger=PropertyChanged}" />

                                            <Button Content="Save this recovery word" Style="{StaticResource PrimaryButton}"
                                                    HorizontalAlignment="Left" Margin="0,10,0,0"
                                                    Command="{Binding SaveRecoveryWordCommand}" />
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </ScrollViewer>
                        </Border>
                    </Grid>

                    <!-- Manager / other user's view -->
                    <Border Style="{StaticResource SettingsGroup}" VerticalAlignment="Top"
                            Visibility="{Binding CannotManageStaff, Converter={StaticResource BoolToVis}}">
                        <StackPanel>
                            <TextBlock Text="Staff &amp; permissions" Style="{StaticResource SectionTitle}" />
                            <TextBlock Text="Only the owner can see people's permissions and add new staff. Ask the owner to change this."
                                       Style="{StaticResource FieldHint}" />
                        </StackPanel>
                    </Border>

                </Grid>
            </TabItem>

            <!-- ========================== 6. APP WORDS ========================== -->
            <TabItem Header="App words">
                <Grid Margin="0,4,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Margin="0,0,16,10">
                            <TextBlock Text="Names used inside Area11" Style="{StaticResource SectionTitle}" />
                            <TextBlock Style="{StaticResource FieldHint}" TextWrapping="Wrap"
                                       Text="Type the words your shop uses. Save settings updates the top navigation and open page headings at once. This does not rewrite receipts, old records or other sentences." />
                        </StackPanel>
                        <Button Grid.Column="1" VerticalAlignment="Top" Style="{StaticResource GhostButton}"
                                Content="{Binding ResetLabelsText}" Command="{Binding ResetLabelsCommand}" />
                    </Grid>

                    <Border Grid.Row="1" Style="{StaticResource SettingsGroup}" Margin="0">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding LabelRows}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,5">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="190" />
                                                <ColumnDefinition Width="16" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Text="Original word" Style="{StaticResource FieldHint}" Margin="0" />
                                                <TextBlock Text="{Binding DefaultText}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                            </StackPanel>
                                            <TextBox Grid.Column="2" VerticalContentAlignment="Center" MaxLength="60"
                                                     Text="{Binding Text, UpdateSourceTrigger=PropertyChanged}"
                                                     ToolTip="Your word for this Area11 section. Use Restore original words to reset every section." />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Border>
                </Grid>
            </TabItem>

            <!-- Field controls: built-in safety preferences and the existing extra-field editor. -->
            <TabItem Header="Fields">
                <TabControl>
                    <TabItem Header="Built-in fields">
                        <views:NativeFieldsView DataContext="{Binding NativeFields}" />
                    </TabItem>
                    <TabItem Header="Extra fields">
                        <views:CustomFieldsView DataContext="{Binding ExtraFields}" />
                    </TabItem>
                </TabControl>
            </TabItem>
        </TabControl>

        <!-- Status line: green/grey = saved, red = problem -->
        <Border Grid.Row="2" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource LineBrush}"
                BorderThickness="1" CornerRadius="8" Padding="12,8" Margin="0,10,0,0">
            <TextBlock Text="{Binding StatusText}" TextWrapping="Wrap">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="FontSize" Value="12" />
                        <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsStatusError}" Value="True">
                                <Setter Property="Foreground" Value="{StaticResource DangerBrush}" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
        </Border>
    </Grid>
</UserControl>
