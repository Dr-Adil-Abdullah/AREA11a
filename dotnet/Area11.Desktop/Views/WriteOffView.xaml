<UserControl x:Class="Area11.Desktop.Views.WriteOffView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" Margin="0,0,0,10">
            <StackPanel DockPanel.Dock="Left" VerticalAlignment="Center">
                <TextBlock Text="Write-off" Style="{StaticResource PageTitle}" />
                <TextBlock Text="Expired, broken, lost or a count that did not match. The loss is valued at purchase cost."
                           Style="{StaticResource PageSubtitle}" />
            </StackPanel>

            <StackPanel DockPanel.Dock="Right" HorizontalAlignment="Right" VerticalAlignment="Center" Orientation="Horizontal">
                <TextBlock Text="{Binding TodayTotal}" FontWeight="SemiBold" Foreground="{StaticResource DangerBrush}"
                           VerticalAlignment="Center" Margin="0,0,10,0" />
                <Button Content="Refresh" Style="{StaticResource GhostButton}" Command="{Binding RefreshCommand}" />
            </StackPanel>
        </DockPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.15*" />
                <ColumnDefinition Width="14" />
                <ColumnDefinition Width="1*" />
            </Grid.ColumnDefinitions>

            <!-- =============================== the form =============================== -->
            <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto">
                <Border Style="{StaticResource Card}" Padding="14" VerticalAlignment="Top">
                    <StackPanel>
                        <TextBlock Text="1. Which medicine" Style="{StaticResource SectionTitle}" />

                        <DockPanel Margin="0,4,0,0">
                            <Button DockPanel.Dock="Right" Content="Search" Style="{StaticResource GhostButton}"
                                    Margin="6,0,0,0" Command="{Binding SearchCommand}" />
                            <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" />
                        </DockPanel>

                        <ListBox ItemsSource="{Binding Results}" Height="110" Margin="0,6,0,0"
                                 SelectedItem="{Binding SelectedProduct, Mode=TwoWay}">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding Name}" Width="210" />
                                        <TextBlock Text="{Binding StockLabel}" Width="110" Foreground="{StaticResource MutedBrush}" />
                                        <TextBlock Text="{Binding PackLabel}" Foreground="{StaticResource MutedBrush}" />
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <TextBlock Text="2. From which batch" Style="{StaticResource SectionTitle}" Margin="0,12,0,0" />
                        <TextBlock Text="The oldest expiry is picked first - that is the box to destroy first."
                                   Style="{StaticResource FieldHint}" />

                        <DataGrid ItemsSource="{Binding Batches}" Height="140" Margin="0,4,0,0"
                                  SelectedItem="{Binding SelectedBatch, Mode=TwoWay}">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Batch" Binding="{Binding BatchNo}" Width="*" />
                                <DataGridTextColumn Header="Expiry" Binding="{Binding ExpiryDate}" Width="100" />
                                <DataGridTextColumn Header="State" Binding="{Binding ExpiryLabel, Mode=OneWay}" Width="110" />
                                <DataGridTextColumn Header="Qty" Binding="{Binding QtyLabel, Mode=OneWay}" Width="80" />
                                <DataGridTextColumn Header="Value" Binding="{Binding ValueLabel, Mode=OneWay}" Width="95" />
                            </DataGrid.Columns>
                        </DataGrid>

                        <TextBlock Text="3. How much and why" Style="{StaticResource SectionTitle}" Margin="0,12,0,0" />

                        <Grid Margin="0,2,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="10" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="10" />
                                <ColumnDefinition Width="1.4*" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Quantity" Style="{StaticResource FieldLabel}" />
                                <TextBox Text="{Binding QtyText, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>

                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Unit" Style="{StaticResource FieldLabel}" />
                                <ComboBox ItemsSource="{Binding Units}" SelectedItem="{Binding Unit, Mode=TwoWay}" />
                            </StackPanel>

                            <StackPanel Grid.Column="4">
                                <TextBlock Text="Reason" Style="{StaticResource FieldLabel}" />
                                <ComboBox ItemsSource="{Binding Reasons}" SelectedItem="{Binding Reason, Mode=TwoWay}" />
                            </StackPanel>
                        </Grid>

                        <TextBlock Text="Note (optional)" Style="{StaticResource FieldLabel}" />
                        <TextBox Text="{Binding Note, UpdateSourceTrigger=PropertyChanged}" />

                        <!-- The two numbers the owner must see before pressing Save -->
                        <Border Background="{StaticResource BrandSoftBrush}" CornerRadius="8" Padding="12" Margin="0,10,0,0">
                            <StackPanel>
                                <TextBlock Text="{Binding LossPreview}" FontSize="20" FontWeight="Bold"
                                           Foreground="{StaticResource BrandDarkBrush}" />
                                <TextBlock Text="{Binding StockPreview}" Style="{StaticResource FieldHint}" />
                            </StackPanel>
                        </Border>

                        <Border Background="{StaticResource DangerSoftBrush}" CornerRadius="8" Padding="10" Margin="0,8,0,0"
                                Visibility="{Binding WillGoMinus, Converter={StaticResource BoolToVis}}">
                            <StackPanel>
                                <TextBlock Text="Not enough stock - Save will be refused" FontWeight="Bold" FontSize="12"
                                           Foreground="{StaticResource DangerBrush}" />
                                <TextBlock TextWrapping="Wrap" FontSize="11.5" Foreground="{StaticResource DangerBrush}"
                                           Text="D-93 does not allow a new write-off below zero. Reduce the quantity, or reconcile an existing minus with a physical stock-take. Your typed form will stay here if the service refuses it." />
                            </StackPanel>
                        </Border>

                        <Button Content="Write this off" Style="{StaticResource PrimaryButton}"
                                Margin="0,12,0,0" Command="{Binding SaveCommand}" />

                        <Border Background="{StaticResource WarningSoftBrush}" CornerRadius="8" Padding="10" Margin="0,10,0,0">
                            <TextBlock TextWrapping="Wrap" FontSize="11.5" Foreground="{StaticResource WarningBrush}"
                                       Text="A write-off lowers the profit report by its cost. There is no undo: a mistake is corrected by a second entry with its own reason, so both stay in the history." />
                        </Border>
                    </StackPanel>
                </Border>
            </ScrollViewer>

            <!-- =============================== the history =============================== -->
            <Border Grid.Column="2" Style="{StaticResource Card}" Padding="14">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Margin="0,0,0,8">
                        <TextBlock Text="Which goods went where" Style="{StaticResource SectionTitle}" />
                        <TextBlock Text="Newest first. Every line keeps its batch, reason, cost and the person who did it."
                                   Style="{StaticResource FieldHint}" />
                    </StackPanel>

                    <DataGrid Grid.Row="1" ItemsSource="{Binding History}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="When" Binding="{Binding DateLabel, Mode=OneWay}" Width="115" />
                            <DataGridTextColumn Header="Medicine" Binding="{Binding ProductName}" Width="2*" />
                            <DataGridTextColumn Header="Batch" Binding="{Binding BatchNo}" Width="80" />
                            <DataGridTextColumn Header="Qty" Binding="{Binding SignedQtyLabel, Mode=OneWay}" Width="75" />
                            <DataGridTextColumn Header="Loss" Binding="{Binding ValueLabel, Mode=OneWay}" Width="95" />
                            <DataGridTextColumn Header="Why" Binding="{Binding ReasonLabel, Mode=OneWay}" Width="110" />
                            <DataGridTextColumn Header="By" Binding="{Binding UserName}" Width="90" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>
        </Grid>

        <Border Grid.Row="2" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource LineBrush}"
                BorderThickness="1" CornerRadius="8" Padding="12,8" Margin="0,10,0,0">
            <TextBlock Text="{Binding StatusText}" TextWrapping="Wrap">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="FontSize" Value="12" />
                        <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsStatusError}" Value="True">
                                <Setter Property="Foreground" Value="{StaticResource DangerBrush}" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
        </Border>
    </Grid>
</UserControl>
