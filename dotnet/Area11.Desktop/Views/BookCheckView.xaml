<UserControl x:Class="Area11.Desktop.Views.BookCheckView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ================================ the heading ================================ -->
        <DockPanel Grid.Row="0" Margin="0,0,0,10">
            <StackPanel DockPanel.Dock="Left" VerticalAlignment="Center">
                <TextBlock Text="{DynamicResource AppLabel.books}" Style="{StaticResource PageTitle}" />
                <TextBlock Style="{StaticResource PageSubtitle}" TextWrapping="Wrap"
                           Text="Every total is compared with the rows it was built from. The check only reads: nothing is repaired, and nothing is changed (F-54)." />
            </StackPanel>

            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                <!-- The list goes to whoever keeps the books, so it can leave the screen (F-54). -->
                <Button Content="Save this list" Style="{StaticResource GhostButton}" Margin="0,0,8,0"
                        Command="{Binding SaveCommand}" />
                <Button Content="Check again" Style="{StaticResource GhostButton}"
                        Command="{Binding RefreshCommand}" />
            </StackPanel>
        </DockPanel>

        <!-- ================================ the answer ================================ -->
        <Border Grid.Row="1" Margin="0,0,0,12" BorderThickness="1" CornerRadius="8" Padding="14">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Background" Value="{StaticResource BrandSoftBrush}" />
                    <Setter Property="BorderBrush" Value="{StaticResource BrandBrush}" />
                    <Style.Triggers>
                        <!-- One colour for the answer: red says money is inconsistent, green says it is not. -->
                        <DataTrigger Binding="{Binding HasProblems}" Value="True">
                            <Setter Property="Background" Value="{StaticResource DangerSoftBrush}" />
                            <Setter Property="BorderBrush" Value="{StaticResource DangerBrush}" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>

            <StackPanel>
                <DockPanel>
                    <TextBlock DockPanel.Dock="Right" VerticalAlignment="Center" FontSize="11"
                               Foreground="{StaticResource MutedBrush}" Text="{Binding WhenText}" />
                    <TextBlock Text="{Binding Headline}" FontSize="17" FontWeight="SemiBold"
                               TextWrapping="Wrap" />
                </DockPanel>

                <TextBlock Text="{Binding Advice}" Style="{StaticResource FieldHint}"
                           TextWrapping="Wrap" Margin="0,6,0,0" />

                <TextBlock Text="{Binding MoneyText}" FontWeight="SemiBold" Margin="0,6,0,0"
                           TextWrapping="Wrap" />

                <TextBlock Text="{Binding DatabaseText}" FontFamily="Consolas" FontSize="10"
                           Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,6,0,0" />

                <!-- What the Save button did, or why it could not. Hidden until it has something to say. -->
                <TextBlock Text="{Binding StatusText}" TextWrapping="Wrap" Margin="0,6,0,0" FontSize="11">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="{StaticResource SuccessBrush}" />
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasStatus}" Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsStatusError}" Value="True">
                                    <Setter Property="Foreground" Value="{StaticResource DangerBrush}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </StackPanel>
        </Border>

        <!-- ================================ the rules and the rows that failed ================================ -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="0.9*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="1.1*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource Card}" Padding="12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Margin="0,0,0,8">
                        <TextBlock Text="THE ELEVEN RULES" Style="{StaticResource SectionTitle}" />
                        <TextBlock Style="{StaticResource FieldHint}" TextWrapping="Wrap"
                                   Text="Each rule is an identity this program guarantees by itself, so a fault here means a row came from somewhere else - an old import, or a file edited by hand." />
                    </StackPanel>

                    <DataGrid Grid.Row="1" ItemsSource="{Binding Rules}" IsReadOnly="True"
                              AutoGenerateColumns="False" HeadersVisibility="Column"
                              GridLinesVisibility="Horizontal">
                        <DataGrid.RowStyle>
                            <Style TargetType="DataGridRow">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsClean}" Value="False">
                                        <Setter Property="Background" Value="{StaticResource DangerSoftBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </DataGrid.RowStyle>
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="#" Binding="{Binding Number, Mode=OneWay}" Width="30" />
                            <DataGridTextColumn Header="" Binding="{Binding Badge, Mode=OneWay}" Width="58" />
                            <DataGridTextColumn Header="Rule" Binding="{Binding Title, Mode=OneWay}" Width="2*" />
                            <DataGridTextColumn Header="What was checked" Binding="{Binding Summary, Mode=OneWay}" Width="1.6*" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>

            <Border Grid.Column="2" Style="{StaticResource Card}" Padding="12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Margin="0,0,0,8">
                        <TextBlock Text="WHAT DOES NOT MATCH" Style="{StaticResource SectionTitle}" />
                        <TextBlock Style="{StaticResource FieldHint}" TextWrapping="Wrap"
                                   Text="One line per document. 'Says' is what the document claims, 'rows say' is what its own rows add up to, and the gap is the difference - the rupee the shop should look for." />
                    </StackPanel>

                    <DataGrid Grid.Row="1" ItemsSource="{Binding Findings}" IsReadOnly="True"
                              AutoGenerateColumns="False" HeadersVisibility="Column"
                              GridLinesVisibility="Horizontal">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Document" Binding="{Binding Code, Mode=OneWay}" Width="1.1*" />
                            <DataGridTextColumn Header="Rule" Binding="{Binding Rule, Mode=OneWay}" Width="1.6*" />
                            <DataGridTextColumn Header="Says" Binding="{Binding ExpectedText, Mode=OneWay}" Width="1*" />
                            <DataGridTextColumn Header="Rows say" Binding="{Binding FoundText, Mode=OneWay}" Width="1*" />
                            <DataGridTextColumn Header="Gap" Binding="{Binding GapText, Mode=OneWay}" Width="1.2*" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>
        </Grid>

        <!-- ================================ the sentence that keeps the page honest ================================ -->
        <TextBlock Grid.Row="3" Style="{StaticResource FieldHint}" TextWrapping="Wrap" Margin="0,10,0,0"
                   Text="This page is read-only on purpose. A program that silently corrects money hides the fault that caused it; the owner decides what a difference means, and the black box keeps every attempt." />
    </Grid>
</UserControl>
