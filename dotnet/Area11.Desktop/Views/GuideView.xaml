<UserControl x:Class="Area11.Desktop.Views.GuideView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FlowDirection="RightToLeft" Background="{DynamicResource CanvasBrush}">
    <Grid Margin="18">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <DockPanel Margin="0,0,0,14">
            <Button DockPanel.Dock="Left" Content="×" FontSize="24" Padding="12,0" Click="OnClose"
                    ToolTip="Close guide" AutomationProperties.Name="Close guide"/>
            <StackPanel><TextBlock Text="AREA11 — اردو رہنمائی" FontSize="25" FontWeight="Bold"/>
                <TextBlock x:Name="MetadataText" FontSize="13" TextWrapping="Wrap"/>
            </StackPanel>
        </DockPanel>
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions><ColumnDefinition Width="240"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <Border Background="{DynamicResource SurfaceBrush}" Padding="12" Margin="0,0,0,0">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top">
                        <Button Content="چھ حصوں کی فہرست" Click="OnHome" Margin="0,0,0,12"/>
                        <TextBlock Text="تمام چھ حصوں میں تلاش"/>
                        <TextBox x:Name="SearchBox" TextChanged="OnSearch" Margin="0,6,0,8"
                                 AutomationProperties.Name="Search guide"/>
                        <TextBlock x:Name="StatusText" TextWrapping="Wrap" FontSize="12" Margin="0,0,0,8"/>
                    </StackPanel>
                    <ListBox x:Name="TopicList" DisplayMemberPath="Path" SelectionChanged="OnSelection"
                             BorderThickness="0" HorizontalContentAlignment="Stretch"/>
                </DockPanel>
            </Border>
            <Grid Grid.Column="1" Margin="0,0,16,0">
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                <TextBlock x:Name="PathText" TextWrapping="Wrap" Margin="0,0,0,10"/>
                <ScrollViewer x:Name="Landing" Grid.Row="1" VerticalScrollBarVisibility="Auto" MaxHeight="520">
                    <UniformGrid x:Name="RootGrid" Columns="2"/>
                </ScrollViewer>
                <DockPanel x:Name="ArticlePanel" Grid.Row="2" Visibility="Collapsed">
                    <ScrollViewer DockPanel.Dock="Bottom" MaxHeight="125" VerticalScrollBarVisibility="Auto">
                        <WrapPanel x:Name="ChildPanel" Margin="0,10,0,0"/>
                    </ScrollViewer>
                    <FlowDocumentScrollViewer x:Name="Reader" IsToolBarVisible="True" MinZoom="80" MaxZoom="180"
                                              VerticalScrollBarVisibility="Auto"/>
                </DockPanel>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
