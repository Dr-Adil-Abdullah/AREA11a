<Window Icon="{DynamicResource Area11WindowIcon}" x:Class="Area11.Desktop.Views.PermissionDetailsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{Binding Title}" Width="850" Height="720" MinWidth="600" MinHeight="480"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="2*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="3*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock Text="{Binding Title}" Style="{StaticResource SectionTitle}" />
                <TextBlock Text="What this controls" Style="{StaticResource FieldLabel}" Margin="0,10,0,0" />
                <TextBlock Text="{Binding Scope}" TextWrapping="Wrap" />
                <TextBlock Text="{Binding Prerequisites}" TextWrapping="Wrap" Margin="0,10,0,0" />
                <TextBlock Text="{Binding MainSwitchLabel}" TextWrapping="Wrap" FontWeight="SemiBold" Margin="0,10,0,0" />
                <Border Background="{StaticResource BrandSoftBrush}" CornerRadius="8" Padding="10" Margin="0,10,0,6">
                    <TextBlock Text="{Binding RolloutNote}" TextWrapping="Wrap" />
                </Border>
            </StackPanel>
        </ScrollViewer>
        <StackPanel Grid.Row="1" Margin="0,12,0,8">
            <TextBlock Text="Current staff assignments" Style="{StaticResource SectionTitle}" />
            <TextBlock Text="{Binding Counts}" TextWrapping="Wrap" Style="{StaticResource FieldHint}" />
        </StackPanel>
        <DataGrid Grid.Row="2" ItemsSource="{Binding People}" IsReadOnly="True" AutoGenerateColumns="False"
                  CanUserAddRows="False" CanUserDeleteRows="False">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Person" Binding="{Binding Name, Mode=OneWay}" Width="*" />
                <DataGridTextColumn Header="Role" Binding="{Binding RoleLabel, Mode=OneWay}" Width="85" />
                <DataGridTextColumn Header="Account" Binding="{Binding AccountLabel, Mode=OneWay}" Width="70" />
                <DataGridTextColumn Header="Grant" Binding="{Binding AssignedLabel, Mode=OneWay}" Width="75" />
                <DataGridTextColumn Header="Source" Binding="{Binding Source, Mode=OneWay}" Width="110" />
                <DataGridTextColumn Header="Access / other gates" Binding="{Binding Access, Mode=OneWay}" Width="2*" />
            </DataGrid.Columns>
        </DataGrid>
        <DockPanel Grid.Row="3" Margin="0,12,0,0" LastChildFill="True">
            <Button DockPanel.Dock="Right" Content="Close" IsCancel="True" Style="{StaticResource GhostButton}" />
            <Button DockPanel.Dock="Right" Content="Refresh now" Command="{Binding RefreshCommand}" Margin="0,0,8,0"
                    Style="{StaticResource GhostButton}" />
            <TextBlock Text="{Binding Status}" TextWrapping="Wrap" VerticalAlignment="Center" Style="{StaticResource FieldHint}" />
        </DockPanel>
    </Grid>
</Window>
