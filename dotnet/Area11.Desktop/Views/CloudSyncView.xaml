<UserControl x:Class="Area11.Desktop.Views.CloudSyncView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ================================ the heading ================================ -->
        <DockPanel Grid.Row="0" Margin="0,0,0,10">
            <StackPanel DockPanel.Dock="Left" VerticalAlignment="Center">
                <TextBlock Text="{DynamicResource AppLabel.cloud}" Style="{StaticResource PageTitle}" />
                <TextBlock Text="Copy the shop's data to Supabase so you can look at it from home. The copy here is always the truth; the cloud is a mirror (F-48)."
                           Style="{StaticResource PageSubtitle}" TextWrapping="Wrap" />
            </StackPanel>

            <Button DockPanel.Dock="Right" HorizontalAlignment="Right" VerticalAlignment="Center"
                    Content="Refresh" Style="{StaticResource GhostButton}" Command="{Binding RefreshCommand}" />
        </DockPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- ================================ this computer ================================ -->
            <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <Border Style="{StaticResource Card}" Padding="14">
                        <StackPanel>
                            <TextBlock Text="THIS COMPUTER" Style="{StaticResource SectionTitle}" />
                            <TextBlock Text="{Binding ConfigText}" FontWeight="SemiBold" Margin="0,6,0,0" />
                            <TextBlock Text="{Binding LastSyncText}" Style="{StaticResource FieldHint}"
                                       TextWrapping="Wrap" Margin="0,2,0,0" />

                            <UniformGrid Columns="2" Margin="0,10,0,0">
                                <StackPanel Margin="0,0,6,6">
                                    <TextBlock Text="ADDRESS" Style="{StaticResource MetricLabel}" />
                                    <TextBlock Text="{Binding UrlText}" TextWrapping="Wrap" />
                                </StackPanel>
                                <StackPanel Margin="6,0,0,6">
                                    <TextBlock Text="TABLE" Style="{StaticResource MetricLabel}" />
                                    <TextBlock Text="{Binding TableText}" TextWrapping="Wrap" />
                                </StackPanel>
                                <StackPanel Margin="0,0,6,0">
                                    <TextBlock Text="SHOP ID" Style="{StaticResource MetricLabel}" />
                                    <TextBlock Text="{Binding ShopIdText}" TextWrapping="Wrap" />
                                </StackPanel>
                                <StackPanel Margin="6,0,0,0">
                                    <TextBlock Text="KEY" Style="{StaticResource MetricLabel}" />
                                    <TextBlock Text="{Binding KeyText}" TextWrapping="Wrap" />
                                </StackPanel>
                            </UniformGrid>

                            <TextBlock Style="{StaticResource FieldHint}" TextWrapping="Wrap" Margin="0,10,0,0"
                                       Text="The address, the key and the shop id are typed in Settings → Cloud sync. A shop that never uses the cloud leaves them empty and nothing else changes." />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}" Padding="14" Margin="0,10,0,0">
                        <StackPanel>
                            <TextBlock Text="WHAT THIS COMPUTER HOLDS" Style="{StaticResource SectionTitle}" />

                            <ItemsControl ItemsSource="{Binding Rows}" Margin="0,8,0,0">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1" Padding="0,5">
                                            <DockPanel>
                                                <TextBlock DockPanel.Dock="Right" Text="{Binding HereLabel}"
                                                           FontWeight="SemiBold" />
                                                <TextBlock Text="{Binding Label}" />
                                            </DockPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <TextBlock Style="{StaticResource FieldHint}" TextWrapping="Wrap" Margin="0,8,0,0"
                                       Text="Medicines, customers, suppliers, categories, companies and batches travel whole. Bills, purchases, payments and expenses travel for the last 90 days (Spec 25.5). Photos never travel - they go in the zip backup." />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- ================================ the cloud ================================ -->
            <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <Border Style="{StaticResource Card}" Padding="14">
                        <StackPanel>
                            <TextBlock Text="THE CLOUD" Style="{StaticResource SectionTitle}" />
                            <TextBlock Style="{StaticResource FieldHint}" TextWrapping="Wrap" Margin="0,4,0,0"
                                       Text="Push only reads this computer. The other two buttons read the cloud - and only the last one writes, after a backup." />

                            <Button Content="Push the shop's data to the cloud" Style="{StaticResource PrimaryButton}"
                                    Command="{Binding PushCommand}" Margin="0,10,0,0" />
                            <Button Content="See what the cloud has (writes nothing)" Style="{StaticResource GhostButton}"
                                    Command="{Binding PreviewCommand}" Margin="0,8,0,0" />

                            <TextBlock Text="{Binding SentText}" Style="{StaticResource FieldHint}" Margin="0,10,0,0"
                                       Visibility="{Binding HasPreview, Converter={StaticResource BoolToVis}}" />
                            <TextBlock Text="{Binding PreviewText}" TextWrapping="Wrap" Margin="0,4,0,0" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}" Padding="14" Margin="0,10,0,0"
                            Visibility="{Binding HasPreview, Converter={StaticResource BoolToVis}}">
                        <StackPanel>
                            <TextBlock Text="CLOUD ROWS AGAINST THIS COMPUTER" Style="{StaticResource SectionTitle}" />

                            <ItemsControl ItemsSource="{Binding CloudRows}" Margin="0,8,0,0">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1" Padding="0,5">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="52" />
                                                    <ColumnDefinition Width="52" />
                                                    <ColumnDefinition Width="56" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="{Binding Label}" />
                                                <TextBlock Grid.Column="1" Text="{Binding CloudLabel}" HorizontalAlignment="Right" />
                                                <TextBlock Grid.Column="2" Text="{Binding HereLabel}" HorizontalAlignment="Right" />
                                                <TextBlock Grid.Column="3" Text="{Binding DifferenceLabel}" HorizontalAlignment="Right"
                                                           FontWeight="SemiBold" />
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <TextBlock Style="{StaticResource FieldHint}" TextWrapping="Wrap" Margin="0,6,0,0"
                                       Text="Cloud / here / difference. A minus means the cloud copy has fewer rows than this computer - read that before you agree." />

                            <Border Background="{StaticResource WarningSoftBrush}" CornerRadius="8" Padding="10" Margin="0,10,0,0">
                                <TextBlock TextWrapping="Wrap" Foreground="{StaticResource WarningBrush}"
                                           Text="Bringing the cloud copy writes its rows over the rows on this computer. A backup is taken first, and nothing is ever deleted - but today's bill is newer than the cloud, so this is not an update." />
                            </Border>

                            <CheckBox Content="I understand: the cloud rows replace the rows on this computer."
                                      IsChecked="{Binding ConfirmApply, Mode=TwoWay}" Margin="0,10,0,0" />

                            <Button Content="Bring the cloud data here" Style="{StaticResource PrimaryButton}"
                                    Command="{Binding ApplyCommand}" IsEnabled="{Binding CanApply}" Margin="0,8,0,0" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <!-- ================================ the footer ================================ -->
        <TextBlock Grid.Row="2" Text="{Binding StatusText}" TextWrapping="Wrap" FontSize="11.5" Margin="0,10,0,0">
            <TextBlock.Style>
                <Style TargetType="TextBlock">
                    <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsStatusError}" Value="True">
                            <Setter Property="Foreground" Value="{StaticResource DangerBrush}" />
                            <Setter Property="FontWeight" Value="Bold" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </TextBlock.Style>
        </TextBlock>
    </Grid>
</UserControl>
