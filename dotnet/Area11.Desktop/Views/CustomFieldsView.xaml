<UserControl x:Class="Area11.Desktop.Views.CustomFieldsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ================================ the heading ================================ -->
        <DockPanel Grid.Row="0" Margin="0,0,0,10">
            <StackPanel DockPanel.Dock="Left" VerticalAlignment="Center">
                <TextBlock Text="{DynamicResource AppLabel.customFields}" Style="{StaticResource PageTitle}" />
                <TextBlock Text="Add a question to the medicine, customer or supplier form. It appears there the moment you save it."
                           Style="{StaticResource PageSubtitle}" />
            </StackPanel>

            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right"
                        VerticalAlignment="Center">
                <TextBlock Text="Form:" Style="{StaticResource FieldLabel}" VerticalAlignment="Center"
                           Margin="0,0,8,0" />
                <ComboBox Width="170" ItemsSource="{Binding Tabs}" DisplayMemberPath="Label"
                          SelectedItem="{Binding SelectedTab, Mode=TwoWay}" />
            </StackPanel>
        </DockPanel>

        <!-- ================================ the page ================================ -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="14" />
                <ColumnDefinition Width="400" />
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Style="{StaticResource Card}" Padding="14" Margin="0,0,0,10"
                        Visibility="{Binding IsNotAllowed, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="Only the owner or a manager can add or change these fields. Ask the owner to switch on the Settings permission for this login."
                               TextWrapping="Wrap" Foreground="{StaticResource WarningBrush}" />
                </Border>

                <Border Grid.Row="1" Style="{StaticResource Card}" Padding="12">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <DockPanel Grid.Row="0" Margin="0,0,0,8">
                            <TextBlock DockPanel.Dock="Left" Text="{Binding CountText}" FontWeight="SemiBold"
                                       VerticalAlignment="Center" />
                            <TextBlock DockPanel.Dock="Right" HorizontalAlignment="Right"
                                       Text="The order below is the order the form asks."
                                       Style="{StaticResource FieldHint}" VerticalAlignment="Center" />
                        </DockPanel>

                        <ListBox Grid.Row="1" ItemsSource="{Binding Fields}"
                                 SelectedItem="{Binding SelectedField, Mode=TwoWay}"
                                 BorderBrush="{StaticResource LineBrush}"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border Padding="8" Margin="0,0,0,4" CornerRadius="6"
                                            Background="{StaticResource CanvasBrush}">
                                        <StackPanel>
                                            <TextBlock Text="{Binding Label}" FontSize="12.5" FontWeight="SemiBold" />
                                            <TextBlock Text="{Binding Summary}" Style="{StaticResource FieldHint}" />
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <TextBlock Grid.Row="1" Text="No fields on this form yet. Add the first one on the right."
                                   FontSize="12" Foreground="{StaticResource MutedBrush}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" TextWrapping="Wrap" />

                        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,8,0,0">
                            <Button Content="New field" Style="{StaticResource PrimaryButton}" Margin="0,0,6,0"
                                    Command="{Binding NewCommand}" />
                            <Button Content="Move up" Style="{StaticResource GhostButton}" Margin="0,0,6,0"
                                    Command="{Binding MoveUpCommand}" />
                            <Button Content="Move down" Style="{StaticResource GhostButton}" Margin="0,0,6,0"
                                    Command="{Binding MoveDownCommand}" />
                            <Button Content="{Binding ToggleLabel}" Style="{StaticResource GhostButton}"
                                    Command="{Binding ToggleCommand}" />
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>

            <!-- ================================ the form ================================ -->
            <Border Grid.Column="2" Style="{StaticResource Card}" Padding="14">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="{Binding FormTitle}" Style="{StaticResource SectionTitle}" />

                        <TextBlock Text="Name on the form" Style="{StaticResource FieldLabel}" Margin="0,10,0,0" />
                        <TextBox Text="{Binding LabelText, UpdateSourceTrigger=PropertyChanged}" />

                        <TextBlock Text="Stable key (kept when the name changes)" Style="{StaticResource FieldLabel}" Margin="0,10,0,0" />
                        <TextBlock Text="{Binding SelectedFieldKey}" Style="{StaticResource FieldHint}"
                                   TextWrapping="Wrap" />

                        <TextBlock Text="Kind of answer" Style="{StaticResource FieldLabel}" Margin="0,10,0,0" />
                        <ComboBox ItemsSource="{Binding Types}" DisplayMemberPath="Label"
                                  SelectedItem="{Binding SelectedType, Mode=TwoWay}" />

                        <TextBlock Text="{Binding TypeHint}" Style="{StaticResource FieldHint}" TextWrapping="Wrap"
                                   Margin="0,4,0,0" />

                        <TextBlock Text="Help on the record form (optional)" Style="{StaticResource FieldLabel}" Margin="0,10,0,0" />
                        <TextBox Text="{Binding HelpText, UpdateSourceTrigger=PropertyChanged}"
                                 ToolTip="One line, up to 160 characters. It guides the person; it is not a validation script." />

                        <StackPanel Visibility="{Binding NeedsOptions, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="Choices (separated by commas)" Style="{StaticResource FieldLabel}" />
                            <TextBox Text="{Binding OptionsText, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>

                        <CheckBox Content="Required - the form will not save without it"
                                  IsChecked="{Binding Required, Mode=TwoWay}" Margin="0,12,0,0" />

                        <Button Content="{Binding SaveLabel}" Style="{StaticResource PrimaryButton}" Height="38"
                                Margin="0,14,0,0" Command="{Binding SaveCommand}" />

                        <Button Content="Cancel / start a new field" Style="{StaticResource GhostButton}"
                                Margin="0,6,0,0" Command="{Binding CancelCommand}" />

                        <Border Background="{StaticResource BrandSoftBrush}" CornerRadius="8" Padding="10"
                                Margin="0,14,0,0">
                            <StackPanel>
                                <TextBlock Text="Quick add" Style="{StaticResource FieldLabel}" />
                                <TextBlock Text="One click fills the name and the kind - change anything after that."
                                           Style="{StaticResource FieldHint}" TextWrapping="Wrap" Margin="0,0,0,6" />

                                <ItemsControl ItemsSource="{Binding Suggestions}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Button Content="{Binding Hint}" Style="{StaticResource GhostButton}"
                                                    Margin="0,0,6,6" Padding="8,4"
                                                    Command="{Binding DataContext.UseSuggestionCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                    CommandParameter="{Binding}" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <!-- ================================ the footer ================================ -->
        <TextBlock Grid.Row="2" Text="{Binding StatusText}" TextWrapping="Wrap" FontSize="11.5"
                   Margin="0,10,0,0">
            <TextBlock.Style>
                <Style TargetType="TextBlock">
                    <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsStatusError}" Value="True">
                            <Setter Property="Foreground" Value="{StaticResource DangerBrush}" />
                            <Setter Property="FontWeight" Value="Bold" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </TextBlock.Style>
        </TextBlock>
    </Grid>
</UserControl>
