<Window x:Class="Area11.WPF.Views.LoginView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Area11 POS - Sign in"
        Height="560"
        Width="940"
        MinHeight="520"
        MinWidth="820"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource AppBgBrush}">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="420" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Background="{StaticResource BrandDarkBrush}">
            <StackPanel Margin="44,56,44,40" VerticalAlignment="Center">
                <TextBlock Text="AREA11"
                           FontSize="34"
                           FontWeight="Bold"
                           Foreground="White" />
                <TextBlock Text="{Binding AppName}"
                           FontSize="15"
                           Foreground="#FFA7F3D0"
                           Margin="0,6,0,0" />
                <TextBlock Text="{Binding StoreName}"
                           FontSize="13"
                           Foreground="#FFD1FAE5"
                           Margin="0,28,0,0"
                           TextWrapping="Wrap" />

                <Border Height="1" Background="#33FFFFFF" Margin="0,28,0,20" />

                <TextBlock Text="Pharmacy &amp; retail point of sale"
                           Foreground="White"
                           FontSize="13"
                           Margin="0,0,0,8" />
                <TextBlock Text="Works fully offline on this computer"
                           Foreground="#FFA7F3D0"
                           FontSize="12"
                           Margin="0,0,0,6" />
                <TextBlock Text="Every sale, stock move and setting is audited"
                           Foreground="#FFA7F3D0"
                           FontSize="12" />
            </StackPanel>
        </Border>

        <Grid Grid.Column="1" Margin="64,0">
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="Sign in" Style="{StaticResource PageTitle}" />
                <TextBlock Text="Owner: leave the name empty and type the password. Staff: type name and 4-digit PIN."
                           Style="{StaticResource PageSubtitle}"
                           TextWrapping="Wrap"
                           Margin="0,6,0,18" />

                <TextBlock Text="User name" Style="{StaticResource FieldLabel}" />
                <TextBox x:Name="UserInput"
                         Text="{Binding UserName, UpdateSourceTrigger=PropertyChanged}"
                         Height="36" />

                <TextBlock Text="Password or PIN" Style="{StaticResource FieldLabel}" />
                <PasswordBox x:Name="PasswordInput" Height="36" />

                <TextBlock Text="{Binding ErrorMessage}"
                           Foreground="{StaticResource DangerBrush}"
                           FontSize="12"
                           Margin="0,12,0,0"
                           TextWrapping="Wrap" />

                <Button Content="Sign in"
                        Style="{StaticResource PrimaryButton}"
                        Click="OnSignInClick"
                        IsDefault="True"
                        Height="40"
                        Margin="0,18,0,0" />

                <TextBlock Text="Area11 POS  -  local SQLite database"
                           Style="{StaticResource PageSubtitle}"
                           HorizontalAlignment="Center"
                           Margin="0,22,0,0" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
