<UserControl x:Class="Area11.WPF.Views.PurchasesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" Margin="0,0,0,14">
            <StackPanel DockPanel.Dock="Left">
                <TextBlock Text="Purchases (stock-in)" Style="{StaticResource PageTitle}" />
                <TextBlock Text="PINV bills · batch and expiry · supplier ledger · sample lines at zero cost"
                           Style="{StaticResource PageSubtitle}" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <Button Content="Refresh" Style="{StaticResource GhostButton}" Command="{Binding RefreshCommand}" />
            </StackPanel>
        </DockPanel>

        <Border Grid.Row="1" Style="{StaticResource Card}" Padding="14" Margin="0,0,0,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*" />
                    <ColumnDefinition Width="10" />
                    <ColumnDefinition Width="1.4*" />
                    <ColumnDefinition Width="10" />
                    <ColumnDefinition Width="1.4*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="Supplier" Style="{StaticResource FieldLabel}" Margin="0,0,0,4" />
                    <ComboBox ItemsSource="{Binding Suppliers}"
                              SelectedItem="{Binding SelectedSupplier, Mode=TwoWay}"
                              DisplayMemberPath="Name" />
                </StackPanel>

                <StackPanel Grid.Column="2">
                    <TextBlock Text="New supplier" Style="{StaticResource FieldLabel}" Margin="0,0,0,4" />
                    <TextBox Text="{Binding NewSupplierName, UpdateSourceTrigger=PropertyChanged}" ToolTip="Name" />
                </StackPanel>

                <StackPanel Grid.Column="4">
                    <TextBlock Text="Phone" Style="{StaticResource FieldLabel}" Margin="0,0,0,4" />
                    <TextBox Text="{Binding NewSupplierPhone, UpdateSourceTrigger=PropertyChanged}" />
                </StackPanel>

                <Button Grid.Column="5"
                        Content="Add supplier"
                        Style="{StaticResource GhostButton}"
                        Command="{Binding AddSupplierCommand}"
                        VerticalAlignment="Bottom"
                        Margin="10,0,0,0" />
            </Grid>
        </Border>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.25*" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="1*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource Card}" Padding="14">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="Add a delivery line" Style="{StaticResource SectionTitle}" />

                        <TextBlock Text="Search product" Style="{StaticResource FieldLabel}" />
                        <TextBox Text="{Binding ProductSearch, UpdateSourceTrigger=PropertyChanged}" />
                        <ComboBox Margin="0,6,0,0"
                                  ItemsSource="{Binding FilteredProducts}"
                                  SelectedItem="{Binding SelectedProduct, Mode=TwoWay}"
                                  DisplayMemberPath="Name" />

                        <Grid Margin="0,6,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="8" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Unit" Style="{StaticResource FieldLabel}" />
                                <ComboBox ItemsSource="{Binding Units}" SelectedItem="{Binding Unit, Mode=TwoWay}" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Quantity" Style="{StaticResource FieldLabel}" />
                                <TextBox Text="{Binding Quantity, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                        </Grid>

                        <Grid Margin="0,6,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="8" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Batch number" Style="{StaticResource FieldLabel}" />
                                <TextBox Text="{Binding BatchNo, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Expiry (2027-06)" Style="{StaticResource FieldLabel}" />
                                <TextBox Text="{Binding Expiry, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                        </Grid>

                        <Grid Margin="0,6,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="8" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Cost (Rs)" Style="{StaticResource FieldLabel}" />
                                <TextBox Text="{Binding Cost, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Retail (Rs)" Style="{StaticResource FieldLabel}" />
                                <TextBox Text="{Binding Retail, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                        </Grid>

                        <CheckBox Content="Sample / bonus line (enters stock, zero cost)"
                                  IsChecked="{Binding IsSample}"
                                  Margin="0,12,0,0" />

                        <Button Content="Add line"
                                Style="{StaticResource PrimaryButton}"
                                Command="{Binding AddLineCommand}"
                                Margin="0,12,0,0" />
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <Border Grid.Column="2" Style="{StaticResource Card}" Padding="14">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <DockPanel Grid.Row="0" Margin="0,0,0,8">
                        <TextBlock Text="Delivery lines" Style="{StaticResource SectionTitle}" VerticalAlignment="Center" />
                        <Button Content="Remove last" Style="{StaticResource GhostButton}"
                                Command="{Binding RemoveLineCommand}" HorizontalAlignment="Right" />
                    </DockPanel>

                    <DataGrid Grid.Row="1" ItemsSource="{Binding Lines}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Item" Binding="{Binding ProductName}" Width="2*" />
                            <DataGridTextColumn Header="Qty" Binding="{Binding QuantityText}" Width="Auto" />
                            <DataGridTextColumn Header="Batch" Binding="{Binding BatchNo}" Width="*" />
                            <DataGridTextColumn Header="Expiry" Binding="{Binding Expiry}" Width="Auto" />
                            <DataGridTextColumn Header="Cost" Binding="{Binding CostText}" Width="Auto" />
                            <DataGridTextColumn Header="" Binding="{Binding SampleText}" Width="Auto" />
                        </DataGrid.Columns>
                    </DataGrid>

                    <StackPanel Grid.Row="2" Margin="0,12,0,0">
                        <TextBlock Text="TOTAL" Style="{StaticResource MetricLabel}" />
                        <TextBlock Text="{Binding TotalText}" FontSize="26" FontWeight="Bold" Foreground="{StaticResource BrandBrush}" />

                        <TextBlock Text="Paid now (Rs)" Style="{StaticResource FieldLabel}" />
                        <TextBox Text="{Binding PaidAmount, UpdateSourceTrigger=PropertyChanged}" />

                        <TextBlock Text="Note" Style="{StaticResource FieldLabel}" />
                        <TextBox Text="{Binding Note, UpdateSourceTrigger=PropertyChanged}" />

                        <Button Content="Save purchase (PINV)"
                                Style="{StaticResource PrimaryButton}"
                                Command="{Binding SaveCommand}"
                                Height="42"
                                Margin="0,14,0,0" />

                        <TextBlock Text="{Binding StatusMessage}"
                                   FontSize="12"
                                   TextWrapping="Wrap"
                                   Margin="0,10,0,0">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsStatusError}" Value="True">
                                            <Setter Property="Foreground" Value="{StaticResource DangerBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
