# Build output
bin/
obj/
*.user
.vs/

# Local database and logs (never commit business data)
/data/
/prototypes/Area11.WPF/data/
/dotnet/**/bin/
/dotnet/**/obj/
/publish/
# The installer build output (tools\MAKE-INSTALLER.cmd) - self-contained program, never committed
